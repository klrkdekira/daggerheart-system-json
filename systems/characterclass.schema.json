{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/daggerheart-system-json/systems/characterclass.schema.json",
  "type": "object",
  "properties": {
    "@context": {
      "const": "https://cheeleong.dev/daggerheart-system-json/systems/context.jsonld"
    },
    "@id": {
      "type": "string",
      "pattern": "^https://cheeleong\\.dev/daggerheart-system-json/objects/[a-z-]+/[a-z0-9-]+$"
    },
    "@type": {
      "const": "CharacterClass"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/nodeRef"
    },
    "sourceLocator": {
      "$ref": "common.schema.json#/$defs/sourceLocator"
    },
    "htmlPage": {
      "$ref": "common.schema.json#/$defs/pageRef"
    },
    "fromSection": {
      "$ref": "common.schema.json#/$defs/nodeRef"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nodeRef"
      },
      "minItems": 1
    },
    "subclasses": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/nodeRef"
      },
      "minItems": 1
    },
    "startingEvasion": {
      "type": "integer"
    },
    "startingHitPoints": {
      "type": "integer"
    },
    "hopeFeature": {
      "$ref": "common.schema.json#/$defs/feature"
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/feature"
      }
    },
    "classItems": {
      "type": "string",
      "minLength": 1
    },
    "backgroundQuestions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/feature"
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "name",
    "slug",
    "source",
    "sourceLocator",
    "htmlPage",
    "domains",
    "subclasses",
    "startingEvasion",
    "startingHitPoints",
    "hopeFeature",
    "features"
  ],
  "additionalProperties": false
}
