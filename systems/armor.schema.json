{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/daggerheart-system-json/systems/armor.schema.json",
  "type": "object",
  "properties": {
    "@context": {
      "const": "https://cheeleong.dev/daggerheart-system-json/systems/context.jsonld"
    },
    "@id": {
      "type": "string",
      "pattern": "^https://cheeleong\\.dev/daggerheart-system-json/objects/[a-z-]+/[a-z0-9-]+$"
    },
    "@type": {
      "const": "Armor"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/nodeRef"
    },
    "sourceLocator": {
      "$ref": "common.schema.json#/$defs/sourceLocator"
    },
    "htmlPage": {
      "$ref": "common.schema.json#/$defs/pageRef"
    },
    "fromSection": {
      "$ref": "common.schema.json#/$defs/nodeRef"
    },
    "tier": {
      "type": "integer"
    },
    "variant": {
      "enum": [
        "core",
        "everyday-hero",
        "monster-hunting"
      ]
    },
    "baseThresholds": {
      "type": "string",
      "minLength": 1
    },
    "baseScore": {
      "type": "string",
      "minLength": 1
    },
    "feature": {
      "$ref": "common.schema.json#/$defs/feature"
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "name",
    "slug",
    "source",
    "sourceLocator",
    "htmlPage",
    "variant",
    "baseThresholds",
    "baseScore"
  ],
  "additionalProperties": false
}
