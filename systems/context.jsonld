{
  "@context": {
    "@version": 1.1,
    "@base": "https://cheeleong.dev/daggerheart-system-json/",
    "@vocab": "https://cheeleong.dev/daggerheart-system-json/vocab/#",
    "dh": "https://cheeleong.dev/daggerheart-system-json/vocab/#",
    "schema": "https://schema.org/",
    "dcterms": "http://purl.org/dc/terms/",
    "name": "schema:name",
    "description": "schema:description",
    "slug": "dh:slug",
    "rulesText": "dh:rulesText",
    "source": { "@id": "dcterms:source", "@type": "@id" },
    "htmlPage": { "@id": "schema:url", "@type": "@id" },
    "sourceLocator": "dh:sourceLocator",
    "license": "dh:licenseCode",
    "licenseUrl": { "@id": "dh:licenseUrl", "@type": "@id" },
    "attributionStatement": "dh:attributionStatement",
    "domains": { "@id": "dh:domain", "@type": "@id", "@container": "@set" },
    "domain": { "@id": "dh:domain", "@type": "@id" },
    "classes": { "@id": "dh:class", "@type": "@id", "@container": "@set" },
    "parentClass": { "@id": "dh:parentClass", "@type": "@id" },
    "subclasses": { "@id": "dh:subclass", "@type": "@id", "@container": "@set" },
    "fromClass": { "@id": "dh:fromClass", "@type": "@id" },
    "fromSection": { "@id": "dh:fromSection", "@type": "@id" },
    "potentialAdversaries": { "@id": "dh:potentialAdversary", "@type": "@id", "@container": "@set" },
    "cardsInDomain": { "@reverse": "dh:domain", "@type": "@id", "@container": "@set" },
    "subclassOf": { "@reverse": "dh:subclass", "@type": "@id", "@container": "@set" },
    "beastformsOfClass": { "@reverse": "dh:fromClass", "@type": "@id", "@container": "@set" },
    "appearsInEnvironment": { "@reverse": "dh:potentialAdversary", "@type": "@id", "@container": "@set" },
    "sectionEntities": { "@reverse": "dh:fromSection", "@type": "@id", "@container": "@set" },
    "tier": "dh:tier",
    "level": "dh:level",
    "cardType": "dh:cardType",
    "recallCost": "dh:recallCost",
    "role": "dh:role",
    "category": "dh:category",
    "variant": "dh:variant",
    "trait": "dh:trait",
    "range": "dh:range",
    "damage": "dh:damage",
    "tieredDamage": "dh:tieredDamage",
    "damageTypes": { "@id": "dh:damageType", "@container": "@set" },
    "burden": "dh:burden",
    "feature": "dh:feature",
    "features": { "@id": "dh:feature", "@container": "@list" },
    "sections": { "@id": "dh:section", "@container": "@list" },
    "kind": "dh:kind",
    "stage": "dh:stage",
    "baseThresholds": "dh:baseThresholds",
    "baseScore": "dh:baseScore",
    "roll": "dh:roll",
    "itemSet": "dh:itemSet",
    "startingEvasion": "dh:startingEvasion",
    "startingHitPoints": "dh:startingHitPoints",
    "classItems": "dh:classItems",
    "hopeFeature": "dh:hopeFeature",
    "backgroundQuestions": { "@id": "dh:backgroundQuestion", "@container": "@list" },
    "connections": { "@id": "dh:connection", "@container": "@list" },
    "spellcastTrait": "dh:spellcastTrait",
    "questions": { "@id": "dh:question", "@container": "@list" },
    "exampleCreatures": "dh:exampleCreatures",
    "traitBonus": "dh:traitBonus",
    "evasionBonus": "dh:evasionBonus",
    "attack": "dh:attack",
    "advantageOn": { "@id": "dh:advantageOn", "@container": "@list" },
    "motivesAndTactics": { "@id": "dh:motiveOrTactic", "@container": "@list" },
    "impulses": { "@id": "dh:impulse", "@container": "@list" },
    "difficulty": "dh:difficulty",
    "thresholds": "dh:thresholds",
    "hitPoints": "dh:hitPoints",
    "stress": "dh:stress",
    "attackModifier": "dh:attackModifier",
    "standardAttack": "dh:standardAttack",
    "experience": "dh:experience",
    "potentialAdversariesText": "dh:potentialAdversariesText",
    "collections": { "@id": "dh:collection", "@container": "@set" },
    "members": { "@id": "dh:member", "@type": "@id", "@container": "@set" },
    "schemaReference": { "@id": "dh:schemaReference", "@type": "@id" },
    "entityType": "dh:entityType",
    "count": "dh:count",
    "contentDigest": "dh:contentDigest",
    "sourceFile": "dh:sourceFile",
    "pdfFile": "dh:pdfFile",
    "pdfDigest": "dh:pdfDigest",
    "recordCount": "dh:recordCount",
    "srdVersion": "dh:srdVersion",
    "corpusVersion": "dh:corpusVersion"
  }
}
