{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cheeleong.dev/daggerheart-system-json/systems/subclass.schema.json",
  "type": "object",
  "properties": {
    "@context": {
      "const": "https://cheeleong.dev/daggerheart-system-json/systems/context.jsonld"
    },
    "@id": {
      "type": "string",
      "pattern": "^https://cheeleong\\.dev/daggerheart-system-json/objects/[a-z-]+/[a-z0-9-]+$"
    },
    "@type": {
      "const": "Subclass"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/nodeRef"
    },
    "sourceLocator": {
      "$ref": "common.schema.json#/$defs/sourceLocator"
    },
    "htmlPage": {
      "$ref": "common.schema.json#/$defs/pageRef"
    },
    "fromSection": {
      "$ref": "common.schema.json#/$defs/nodeRef"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "parentClass": {
      "$ref": "common.schema.json#/$defs/nodeRef"
    },
    "spellcastTrait": {
      "type": "string",
      "minLength": 1
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/feature"
      }
    }
  },
  "required": [
    "@context",
    "@id",
    "@type",
    "name",
    "slug",
    "source",
    "sourceLocator",
    "htmlPage",
    "parentClass",
    "features"
  ],
  "additionalProperties": false
}
