      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/armorer",
      "@type": "DomainCard",
      "name": "Armorer",
      "slug": "armorer",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "ARMORER",
        "lineStart": 16324,
        "lineEnd": 16332,
        "pdfPageStart": 223,
        "pdfPageEnd": 223
      },
      "level": 5,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/valor"
      },
      "cardType": "Ability",
      "recallCost": 1,
      "rulesText": "While you’re wearing armor, gain a +1 bonus to your Armor Score.\n\nDuring a rest, when you choose to repair your armor as a downtime move, your allies also clear an Armor Slot.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/armorer/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/astral-projection",
      "@type": "DomainCard",
      "name": "Astral Projection",
      "slug": "astral-projection",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "ASTRAL PROJECTION",
        "lineStart": 15546,
        "lineEnd": 15554,
        "pdfPageStart": 216,
        "pdfPageEnd": 216
      },
      "level": 8,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/grace"
      },
      "cardType": "Spell",
      "recallCost": 0,
      "rulesText": "Once per long rest, mark a Stress to create a projected copy of yourself that can appear anywhere you’ve been before.\n\nYou can see and hear through the projection as though it were you and affect the world as though you were there. A creature investigating the projection can tell it’s of magical origin. This effect lasts until your next rest or your projection takes any damage.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/astral-projection/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/avatar-of-terror",
      "@type": "DomainCard",
      "name": "Avatar of Terror",
      "slug": "avatar-of-terror",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "AVATAR OF TERROR",
        "lineStart": 15383,
        "lineEnd": 15391,
        "pdfPageStart": 214,
        "pdfPageEnd": 214
      },
      "level": 10,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/dread"
      },
      "cardType": "Spell",
      "recallCost": 2,
      "rulesText": "Mark a Stress to transform into a creature fueled by fear. While in this form, you gain a 1d6 bonus to your damage rolls for each Fear in the GM’s pool. Additionally, you gain a Hope when the GM spends a Fear to spotlight an adversary within Very Close range.\n\nBefore you make an action roll, you must spend a Hope. If you can’t, you revert to your normal form.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/avatar-of-terror/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/banish",
      "@type": "DomainCard",
      "name": "Banish",
      "slug": "banish",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "BANISH",
        "lineStart": 15109,
        "lineEnd": 15117,
        "pdfPageStart": 212,
        "pdfPageEnd": 212
      },
      "level": 6,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/codex"
      },
      "cardType": "Spell",
      "recallCost": 0,
      "rulesText": "Make a Spellcast Roll against a target within Close range. On a success, roll a number of d20s equal to your Spellcast trait. The target must make a reaction roll with a Difficulty equal to your highest result. On a success, the target must mark a Stress but isn’t banished. Once per rest on a failure, they are banished from this realm.\n\nWhen the PCs roll with Fear, the Difficulty gains a −1 penalty and the target makes another reaction roll. On a success, they return from banishment.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/banish/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/bare-bones",
      "@type": "DomainCard",
      "name": "Bare Bones",
      "slug": "bare-bones",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "BARE BONES",
        "lineStart": 16195,
        "lineEnd": 16206,
        "pdfPageStart": 222,
        "pdfPageEnd": 222
      },
      "level": 1,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/valor"
      },
      "cardType": "Ability",
      "recallCost": 0,
      "rulesText": "When you choose not to equip armor, you have a base Armor Score of 3 + your Strength and use the following as your base damage thresholds:\n\n  - Tier 1: 9/19\n  - Tier 2: 11/24\n  - Tier 3: 13/31\n  - Tier 4: 15/38",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/bare-bones/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/battle-cry",
      "@type": "DomainCard",
      "name": "Battle Cry",
      "slug": "battle-cry",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "BATTLE CRY",
        "lineStart": 14726,
        "lineEnd": 14732,
        "pdfPageStart": 208,
        "pdfPageEnd": 208
      },
      "level": 8,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/blade"
      },
      "cardType": "Ability",
      "recallCost": 2,
      "rulesText": "Once per long rest, while you’re charging into danger, you can muster a rousing call that inspires your allies. All allies who can hear you each clear a Stress and gain a Hope. Additionally, your allies gain advantage on attack rolls until you or an ally rolls a failure with Fear.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/battle-cry/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/battle-hardened",
      "@type": "DomainCard",
      "name": "Battle‑hardened",
      "slug": "battle-hardened",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "BATTLE‑HARDENED",
        "lineStart": 14689,
        "lineEnd": 14695,
        "pdfPageStart": 208,
        "pdfPageEnd": 208
      },
      "level": 6,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/blade"
      },
      "cardType": "Ability",
      "recallCost": 2,
      "rulesText": "Once per long rest when you would make a Death Move, you can spend a Hope to clear a Hit Point instead.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/battle-hardened/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/battle-monster",
      "@type": "DomainCard",
      "name": "Battle Monster",
      "slug": "battle-monster",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "BATTLE MONSTER",
        "lineStart": 14800,
        "lineEnd": 14806,
        "pdfPageStart": 209,
        "pdfPageEnd": 209
      },
      "level": 10,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/blade"
      },
      "cardType": "Ability",
      "recallCost": 0,
      "rulesText": "When you make a successful attack against an adversary, you can mark 4 Stress to force the target to mark a number of Hit Points equal to the number of Hit Points you currently have marked instead of rolling for damage.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/battle-monster/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/blade-touched",
      "@type": "DomainCard",
      "name": "Blade‑touched",
      "slug": "blade-touched",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "BLADE‑TOUCHED",
        "lineStart": 14707,
        "lineEnd": 14716,
        "pdfPageStart": 208,
        "pdfPageEnd": 208
      },
      "level": 7,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/blade"
      },
      "cardType": "Ability",
      "recallCost": 1,
      "rulesText": "When 4 or more of the domain cards in your loadout are from the Blade domain, gain the following benefits:\n\n  - +2 bonus to your attack rolls\n  - +4 bonus to your Severe damage threshold",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/blade-touched/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/blighting-strike",
      "@type": "DomainCard",
      "name": "Blighting Strike",
      "slug": "blighting-strike",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "BLIGHTING STRIKE",
        "lineStart": 15193,
        "lineEnd": 15204,
        "pdfPageStart": 213,
        "pdfPageEnd": 213
      },
      "level": 1,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/dread"
      },
      "cardType": "Spell",
      "recallCost": 1,
      "rulesText": "Make a Spellcast Roll against a target within Far range. On a success:\n\n  - On a roll with Hope, deal d6+1 magic damage using your Proficiency. On a roll with Fear, deal d10+1 magic damage using your Proficiency.\n  - The target’s next successful attack deals half damage.\n\nOn a failure, you must spend a Hope or mark a Stress.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/blighting-strike/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/blink-out",
      "@type": "DomainCard",
      "name": "Blink Out",
      "slug": "blink-out",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "BLINK OUT",
        "lineStart": 14462,
        "lineEnd": 14468,
        "pdfPageStart": 206,
        "pdfPageEnd": 206
      },
      "level": 4,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/arcana"
      },
      "cardType": "Spell",
      "recallCost": 1,
      "rulesText": "Make a Spellcast Roll (12). On a success, spend a Hope to teleport to another point you can see within Far range. If any willing creatures are within Very Close range, spend an additional Hope for each creature to bring them with you.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/blink-out/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
