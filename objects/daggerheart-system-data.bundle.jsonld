      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/adjust-reality",
      "@type": "DomainCard",
      "name": "Adjust Reality",
      "slug": "adjust-reality",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "ADJUST REALITY",
        "lineStart": 14567,
        "lineEnd": 14573,
        "pdfPageStart": 207,
        "pdfPageEnd": 207
      },
      "level": 10,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/arcana"
      },
      "cardType": "Spell",
      "recallCost": 1,
      "rulesText": "After you or a willing ally make any roll, you can spend 5 Hope to change the numerical result of that roll to a result of your choice instead. The result must be plausible within the range of the dice.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/adjust-reality/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/arcana-touched",
      "@type": "DomainCard",
      "name": "Arcana‑touched",
      "slug": "arcana-touched",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "ARCANA‑TOUCHED",
        "lineStart": 14514,
        "lineEnd": 14523,
        "pdfPageStart": 207,
        "pdfPageEnd": 207
      },
      "level": 7,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/arcana"
      },
      "cardType": "Ability",
      "recallCost": 2,
      "rulesText": "When 4 or more of the domain cards in your loadout are from the Arcana domain, gain the following benefits:\n\n  - +1 bonus to your Spellcast Rolls\n  - Once per rest, you can switch the results of your Hope and Fear Dice.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/arcana-touched/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/arcane-reflection",
      "@type": "DomainCard",
      "name": "Arcane Reflection",
      "slug": "arcane-reflection",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "ARCANE REFLECTION",
        "lineStart": 14533,
        "lineEnd": 14539,
        "pdfPageStart": 207,
        "pdfPageEnd": 207
      },
      "level": 8,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/arcana"
      },
      "cardType": "Spell",
      "recallCost": 1,
      "rulesText": "When you would take magic damage, you can spend any number of Hope to roll that many d6s. If any roll a 6, the attack is reflected back to the caster, dealing the damage to them instead.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/arcane-reflection/"
      },
      "source": {
