    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/brawny-zombie",
      "@type": "Adversary",
      "name": "Brawny Zombie",
      "slug": "brawny-zombie",
      "sourceLocator": {
