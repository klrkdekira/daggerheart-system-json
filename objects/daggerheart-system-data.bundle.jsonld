    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/ravenous-mockery",
      "@type": "Adversary",
      "name": "Ravenous Mockery",
      "slug": "ravenous-mockery",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "RAVENOUS MOCKERY",
        "lineStart": 8540,
        "lineEnd": 8560,
        "pdfPageStart": 126,
        "pdfPageEnd": 126
      },
      "tier": 2,
      "motivesAndTactics": [
        "Ambush",
        "lie in wait",
        "swallow without chewing",
        "take on an unassuming shape"
      ],
      "difficulty": 14,
      "thresholds": "8/19",
      "hitPoints": 4,
      "stress": 4,
      "attackModifier": "+1",
      "standardAttack": {
        "name": "Gnashing Teeth",
        "range": "Melee",
        "damage": "2d6+4 phy"
      },
      "experience": "Mimicry +5, Hungry +3",
      "description": "A shapeshifting predator that assumes the appearance of inanimate objects to lure unwary prey into its threat range.",
      "features": [
        {
          "name": "Tongue Attack",
          "kind": "Action",
          "rulesText": "Mark a Stress to attack a creature within Close range. On a success, the target is pulled into Melee range with the Mockery and Restrained until they escape with a successful Strength Roll, and you can spend a Fear to activate the Mockery’s Devour feature against the target."
        },
        {
          "name": "Devour",
          "kind": "Action",
          "rulesText": "Attack a target within Melee range. On a success, the Mockery Swallows the target. While Swallowed, the target is Restrained and marks a HP when the Mockery is spotlighted. The Mockery disgorges all Swallowed creatures when it takes Major or Severe damage."
        },
        {
          "name": "Never Just One",
          "kind": "Action",
          "rulesText": "Spend a Fear to reveal that another object on the battlefield has been a Ravenous Mockery the whole time, then immediately spotlight it."
        }
      ],
      "role": "Standard",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/ravenous-mockery/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/red-ooze",
      "@type": "Adversary",
      "name": "Red Ooze",
      "slug": "red-ooze",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "RED OOZE",
        "lineStart": 6354,
        "lineEnd": 6374,
        "pdfPageStart": 106,
        "pdfPageEnd": 106
      },
      "tier": 1,
      "motivesAndTactics": [
        "Camouflage",
        "consume and multiply",
        "ignite",
        "start fires"
      ],
      "difficulty": 10,
      "thresholds": "6/11",
      "hitPoints": 5,
      "stress": 3,
      "attackModifier": "+1",
      "standardAttack": {
        "name": "Ooze Appendage",
        "range": "Melee",
        "damage": "1d8+3 mag"
      },
      "experience": "Camouflage +3",
      "description": "A moving mound of translucent flaming red slime.",
      "features": [
        {
          "name": "Creeping Fire",
          "kind": "Passive",
          "rulesText": "The Ooze can only move within Very Close range as their normal movement. They light any flammable object they touch on fire."
        },
        {
          "name": "Ignite",
          "kind": "Action",
          "rulesText": "Make an attack against a target within Very Close range. On a success, the target takes 1d8 magic damage and is Ignited until they’re extinguished with a successful Finesse Roll (14). While Ignited, the target takes 1d4 magic damage when they make an action roll."
        },
        {
          "name": "Split",
          "kind": "Reaction",
          "rulesText": "When the Ooze has 3 or more HP marked, you can spend a Fear to split them into two Tiny Red Oozes (with no marked HP or Stress). Immediately spotlight both of them."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/red-ooze/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
