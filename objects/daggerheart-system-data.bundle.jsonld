      "attackModifier": "+8",
      "standardAttack": {
        "name": "Bite & Slash",
        "range": "Close",
        "damage": "4d10+10 phy"
      },
      "experience": "Ancient +5",
      "description": "A gargantuan seven-headed dragon with dazzling diamond scales that shine with every color of the rainbow.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "Mitera can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight her."
        },
        {
          "name": "Diamond Hide",
          "kind": "Passive",
          "rulesText": "Countdown (7). When Mitera first appears, activate the countdown. Mitera gains a bonus to her Difficulty equal to the countdown die’s current value. It ticks down from Mitera’s “Seven-Headed” feature. When the countdown triggers, Mitera becomes Vulnerable and gains a +2 bonus to attack rolls."
        },
        {
          "name": "Elemental Breath",
          "kind": "Action",
          "rulesText": "Mark a Stress to have Mitera unleash elemental energy from one head of your choice: 1. Fire. Deal 4d12 magic damage to 1d4+1 targets within Close range. Targets who take damage must mark an Armor Slot or 2 additional HP.\n\n2. Lightning. Deal 4d12 magic damage to 1d6 targets within Far range, so long as each target beyond the first is within Close range of the previous target.\n3. Acid. Each PC in front of Mitera within Close range must make an Agility Reaction Roll. Targets who fail must mark 2 Armor Slots and 2 HP. Targets who succeed must mark an Armor Slot and a HP.\n4. Poison. A miasma of toxic swamp gas Sickens all targets within Close range of Mitera. While Sickened, a target has disadvantage on action rolls until they mark 1d4 Stress to clear the condition.\n5. Ice. Each target in front of Mitera within Close range takes 4d8+8 magic damage and is Restrained by ice until they break free with a successful Strength Roll. Additionally, this area freezes over and a PC must succeed on an Agility Reaction Roll to move through it.\n6. Darkness. A cloud of magical shadow fills an area within Close range. Creatures inside the cloud except for Mitera are Vulnerable and have disadvantage on action rolls that rely on sight. The cloud dissipates when this Elemental Breath option is removed by Mitera’s “Seven-Headed” feature.\n7. Light. A beam of pure light energy deals 28 direct magic damage to each creature in a line within Very Far range."
        },
        {
          "name": "Tail Swipe",
          "kind": "Action",
          "rulesText": "Spend a Fear to attack all targets within Close range. Targets this attack succeeds against take 2d20+10 physical damage and are knocked back to Far range. Targets who mark HP from this attack become Vulnerable until they clear a HP. Targets this attack failed against must mark a Stress."
        },
        {
          "name": "Fearsome",
          "kind": "Reaction",
          "rulesText": "When Mitera makes a successful attack roll against a PC or a PC fails a roll within Far range, you gain a Fear."
        },
        {
          "name": "Seven-Headed",
          "kind": "Reaction",
          "rulesText": "When Mitera takes damage, roll a d8. Permanently remove the “Elemental Breath” option that corresponds to the result. On a result of 8, or if the corresponding option has already been removed, tick down the Diamond Hide countdown (see “Diamond Hide”)."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/dragon-mother-mitera/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/drake",
