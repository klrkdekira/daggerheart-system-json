    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/dark-army",
      "@type": "DomainCard",
      "name": "Dark Army",
      "slug": "dark-army",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "DARK ARMY",
        "lineStart": 15347,
        "lineEnd": 15355,
        "pdfPageStart": 214,
        "pdfPageEnd": 214
      },
      "level": 8,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/dread"
      },
      "cardType": "Spell",
      "recallCost": 2,
      "rulesText": "Make a Spellcast Roll (14). Once per long rest on a success, you can summon fiends that surround and move with you. Place 8 tokens on this card. When you deal damage to a target within Very Close range, you can spend any number of tokens to add 1d8 for each token spent to your damage roll. Additionally, when you take damage, you can spend any number of tokens to reduce the damage by 1d8 for each token spent. Each time you spend a token, a fiend acts on your behalf, then disappears.\n\nWhen you take a rest, clear all unspent tokens.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/dark-army/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/dark-whispers",
      "@type": "DomainCard",
      "name": "Dark Whispers",
      "slug": "dark-whispers",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "DARK WHISPERS",
        "lineStart": 15700,
        "lineEnd": 15711,
        "pdfPageStart": 217,
        "pdfPageEnd": 217
      },
      "level": 6,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/midnight"
      },
      "cardType": "Spell",
      "recallCost": 0,
      "rulesText": "You can speak into the mind of any person with whom you’ve made physical contact. Once you’ve opened a channel with them, they can speak back into your mind. Additionally, you can mark a Stress to make a Spellcast Roll against them. On a success, you can ask the GM one of the following questions and receive an answer:\n\n  - Where are they?\n  - What are they doing?\n  - What are they afraid of?\n  - What do they cherish most in the world?",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/dark-whispers/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/darkfire",
      "@type": "DomainCard",
      "name": "Darkfire",
      "slug": "darkfire",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "DARKFIRE",
        "lineStart": 15312,
        "lineEnd": 15318,
        "pdfPageStart": 214,
        "pdfPageEnd": 214
      },
      "level": 6,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/dread"
      },
      "cardType": "Spell",
      "recallCost": 2,
      "rulesText": "Once per scene, spend any number of Hope to target an equal number of adversaries within Close range. Each target makes a Reaction Roll (15). Targets who fail take d8+6 magic damage using your Spellcast trait as they are engulfed in dark fire. Targets who succeed take half damage.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/darkfire/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/deadly-focus",
      "@type": "DomainCard",
      "name": "Deadly Focus",
      "slug": "deadly-focus",
      "sourceLocator": {
