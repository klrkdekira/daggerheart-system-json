      "standardAttack": {
        "name": "Slam",
        "range": "Very Close",
        "damage": "1d12+3 phy"
      },
      "experience": "Collateral Damage +2, Throw +4",
      "description": "A large corpse, decay-bloated and angry.",
      "features": [
        {
          "name": "Slow",
          "kind": "Passive",
          "rulesText": "When you spotlight the Zombie and they don’t have a token on their stat block, they can’t act yet. Place a token on their stat block and describe what they’re preparing to do. When you spotlight the Zombie and they have a token on their stat block, clear the token and they can act."
        },
        {
          "name": "Rend Asunder",
          "kind": "Action",
          "rulesText": "Make a standard attack with advantage against a target the Zombie has Restrained. On a success, the attack deals direct damage."
        },
        {
          "name": "Rip and Tear",
          "kind": "Reaction",
          "rulesText": "When the Zombies makes a successful standard attack, you can mark a Stress to temporarily Restrain the target and force them to mark 2 Stress."
        }
      ],
      "role": "Bruiser",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/brawny-zombie/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/bugboar",
      "@type": "Adversary",
      "name": "Bugboar",
      "slug": "bugboar",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "BUGBOAR",
        "lineStart": 5446,
        "lineEnd": 5466,
        "pdfPageStart": 98,
        "pdfPageEnd": 98
      },
      "tier": 1,
      "motivesAndTactics": [
        "Ambush",
        "bully",
        "seek carnage and shiny things"
      ],
      "difficulty": 13,
      "thresholds": "8/15",
      "hitPoints": 5,
      "stress": 3,
      "attackModifier": "+1",
      "standardAttack": {
        "name": "Spiked Mace",
        "range": "Very Close",
        "damage": "1d8+6 phy"
      },
      "experience": "Traps +3",
      "description": "A large bipedal creature that has a tusked snout and coarse fur.",
      "features": [
        {
          "name": "Surprise!",
          "kind": "Passive",
          "rulesText": "If the Bugboar makes its first attack in a scene before it’s marked HP or Stress, it has advantage on the attack and deals an extra 1d8 damage."
        },
        {
          "name": "Brutal",
          "kind": "Reaction",
          "rulesText": "When the Bugboar makes a successful standard attack, you can mark a Stress to deal an extra 1d6 damage."
        },
        {
          "name": "Warheart",
          "kind": "Reaction",
          "rulesText": "When a condition would be imposed on the Bugboar, you can spend a Fear to negate it."
        }
      ],
      "role": "Bruiser",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/bugboar/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/catrin",
      "@type": "Adversary",
      "name": "Catrin",
      "slug": "catrin",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CATRIN",
        "lineStart": 9028,
        "lineEnd": 9048,
        "pdfPageStart": 131,
        "pdfPageEnd": 131
      },
      "tier": 3,
      "motivesAndTactics": [
        "Dominate the conversation",
        "seek attention",
        "steal everything"
      ],
      "difficulty": 17,
      "thresholds": "20/32",
      "hitPoints": 5,
      "stress": 6,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Spirit Flame",
        "range": "Far",
        "damage": "3d8+5 mag"
      },
      "experience": "Opulence +2, Storyteller +2",
      "description": "A lavishly adorned skeleton that has an endless appetite for gold.",
      "features": [
        {
          "name": "Attracted to Wealth",
          "kind": "Passive",
          "rulesText": "PCs carrying at least a bag of gold gain advantage on Presence Rolls made to influence the Catrin."
        },
        {
          "name": "The Weight of Opulence",
          "kind": "Action",
          "rulesText": "Spend a Fear to turn the Catrin’s gaze toward the PC carrying the most gold. The target must succeed on an Instinct Reaction Roll or lose a Hope for each bag of gold they’re carrying. If the PC loses their last Hope or has no Hope to lose, they mark Stress instead."
        },
        {
          "name": "Expensive Failure",
          "kind": "Reaction",
          "rulesText": "When a PC within Melee range fails an action roll, you can mark a Stress to have the Catrin brazenly steal a handful of gold from them."
        }
      ],
      "role": "Social",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/catrin/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/cave-ogre",
      "@type": "Adversary",
      "name": "Cave Ogre",
      "slug": "cave-ogre",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CAVE OGRE",
        "lineStart": 5468,
        "lineEnd": 5490,
        "pdfPageStart": 98,
        "pdfPageEnd": 98
      },
      "tier": 1,
      "motivesAndTactics": [
        "Bite off heads",
        "feast",
        "rip limbs",
        "stomp",
        "throw enemies"
      ],
      "difficulty": 13,
      "thresholds": "8/15",
      "hitPoints": 8,
      "stress": 3,
      "attackModifier": "+1",
      "standardAttack": {
        "name": "Club",
        "range": "Very Close",
        "damage": "1d10+2 phy"
      },
      "experience": "Throw +2",
      "description": "A massive humanoid who sees all sapient life as food.",
      "features": [
        {
          "name": "Ramp Up",
          "kind": "Passive",
          "rulesText": "You must spend a Fear to spotlight the Ogre. While spotlighted, they can make their standard attack against all targets within range."
        },
        {
          "name": "Bone Breaker",
          "kind": "Passive",
          "rulesText": "The Ogre’s attacks deal direct damage."
        },
        {
          "name": "Hail of Boulders",
          "kind": "Action",
          "rulesText": "Mark a Stress to pick up heavy objects and throw them at all targets in front of the Ogre within Far range. Make an attack against these targets. Targets the Ogre succeeds against take 1d10+2 physical damage. If they succeed against more than one target, you gain a Fear."
        },
        {
          "name": "Rampaging Fury",
          "kind": "Reaction",
          "rulesText": "When the Ogre marks 2 or more HP, they can rampage. Move the Ogre to a point within Close range and deal 2d6+3 direct physical damage to all targets in their path."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/cave-ogre/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/centaur-warden",
      "@type": "Adversary",
      "name": "Centaur Warden",
      "slug": "centaur-warden",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CENTAUR WARDEN",
        "lineStart": 7411,
        "lineEnd": 7433,
        "pdfPageStart": 115,
        "pdfPageEnd": 115
      },
      "tier": 2,
      "motivesAndTactics": [
        "Live in harmony with nature",
        "protect the wilderness",
        "use mobility and distance to drive off intruders"
      ],
      "difficulty": 14,
      "thresholds": "10/19",
      "hitPoints": 5,
      "stress": 3,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Recurved Bow",
        "range": "Far",
        "damage": "2d8+4 phy"
      },
      "experience": "Nature +2, Philosophy +2",
      "description": "A half-human, half-horse guardian who patrols the borders of idyllic lands uncorrupted by the touch of civilization.",
      "features": [
        {
          "name": "Flanking Maneuver",
          "kind": "Passive",
          "rulesText": "When the Warden makes a standard attack against a target within Melee range of one or more of the Warden’s allies, the Warden gains a +2 bonus to the attack roll."
        },
        {
          "name": "Eye of the Sage",
          "kind": "Action",
          "rulesText": "Mark a Stress to make a standard attack. The Warden has advantage on the attack roll and critically succeeds on a roll of 19–20."
        },
        {
          "name": "Trample",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Warden gallop up to Far range in a straight line. Each target in their path must make an Agility Reaction Roll. Targets who succeed take 1d6+2 physical damage. Targets who fail take double damage and must mark a Stress."
        },
        {
          "name": "Quick Volley",
          "kind": "Reaction",
          "rulesText": "When the Warden makes a standard attack, you can mark any number of Stress to target an equal number of additional creatures within range."
        }
      ],
      "role": "Ranged",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/centaur-warden/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/cephilith-abomination",
      "@type": "Adversary",
      "name": "Cephilith Abomination",
      "slug": "cephilith-abomination",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CEPHILITH ABOMINATION",
        "lineStart": 10334,
        "lineEnd": 10358,
        "pdfPageStart": 145,
        "pdfPageEnd": 145
      },
      "tier": 4,
      "motivesAndTactics": [
        "Do the heavy lifting",
        "leap menacingly",
        "move surprisingly fast",
        "smash and grab"
      ],
      "difficulty": 19,
      "thresholds": "35/70",
      "hitPoints": 7,
      "stress": 5,
      "attackModifier": "+4",
      "standardAttack": {
        "name": "Meaty Fists",
        "range": "Melee",
        "damage": "4d10+10 phy"
      },
      "experience": "Brute +3",
      "description": "A lumbering, bog-grown frog beast that has tadpolelike leeches visibly wriggling underneath their translucent skin.",
      "features": [
        {
          "name": "Toxic Skin",
          "kind": "Passive",
          "rulesText": "A PC who comes into physical contact with the Abomination must roll a d6. On a result of 3 or lower, the PC must mark an Armor Slot or 2 HP."
        },
        {
          "name": "Bear Hug",
          "kind": "Action",
          "rulesText": "Mark a Stress to make a standard attack against a target within Melee range. On a success, the target takes standard damage and is Grappled until they escape with a successful Strength Roll. While Grappled, the target is Vulnerable and Restrained."
        },
        {
          "name": "Crunch!",
          "kind": "Action",
          "rulesText": "Spend a Fear to deal 4d12 direct physical damage to a creature Grappled by the Abomination."
        },
        {
          "name": "Tongue Attack",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Abomination pull a target within Far range into Melee range, then immediately spotlight the Abomination again."
        },
        {
          "name": "Burrowing Leechpoles",
          "kind": "Reaction",
          "rulesText": "When the Abomination takes Major or greater damage, their skin erupts in an explosion of subcutaneous wrigglers. Each PC within Close range must make an Agility Reaction Roll. Targets who fail are covered in 2d4 leechpoles, which burrow under their skin. Until the leechpoles are dug out with a successful Finesse Roll (21), any damage the target takes gains a +1 bonus for each leechpole under their skin."
        }
      ],
      "role": "Bruiser",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/cephilith-abomination/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/cephilith-hatchling",
      "@type": "Adversary",
      "name": "Cephilith Hatchling",
      "slug": "cephilith-hatchling",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CEPHILITH HATCHLING",
        "lineStart": 10360,
        "lineEnd": 10380,
        "pdfPageStart": 145,
        "pdfPageEnd": 145
      },
      "tier": 4,
      "motivesAndTactics": [
        "Climb",
        "feed",
        "hatch",
        "numb",
        "scuttle"
      ],
      "difficulty": 18,
      "thresholds": "None",
      "hitPoints": 1,
      "stress": 1,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Barbed Suckers",
        "range": "Melee",
        "damage": "9 phy"
      },
      "experience": "Psychic +2",
      "description": "A squidlike parasite that latches onto their prey’s skull, bathing the victim’s brain in extradimensional neurotoxins.",
      "features": [
        {
          "name": "Minion (12)",
          "kind": "Passive",
          "rulesText": "The Hatchling is defeated when they take any damage. For every 12 damage a PC deals to the Hatchling, the PC defeats an additional Minion within range the attack would succeed against."
        },
        {
          "name": "Comatize",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Hatchling latch onto the head of a PC within Melee range. The PC must mark a Stress as the Hatchling injects the PC’s brain with psycho-chemicals, and they must mark an additional Stress each time any PC fails a roll with Fear. The PC can remove the Hatchling by spending a number of Hope equal to the number of Stress they have marked. If a PC marks their last Stress while the Hatchling is latched on, the PC must make a death move. If the PC dies, you can spend a Fear to resurrect them as a Cephilith Novitiate."
        },
        {
          "name": "Group Attack",
          "kind": "Action",
          "rulesText": "Spend a Fear to choose a target and spotlight all Cephilith Hatchlings within Close range of them. Those Minions move into Melee range of the target and make one shared attack roll. On a success, they deal 9 physical damage each. Combine this damage."
        }
      ],
      "role": "Minion",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/cephilith-hatchling/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/cephilith-novitiate",
      "@type": "Adversary",
      "name": "Cephilith Novitiate",
      "slug": "cephilith-novitiate",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CEPHILITH NOVITIATE",
        "lineStart": 10384,
        "lineEnd": 10404,
        "pdfPageStart": 146,
        "pdfPageEnd": 146
      },
      "tier": 4,
      "motivesAndTactics": [
        "Help others see the Truth",
        "make way for It",
        "seek forbidden knowledge"
      ],
      "difficulty": 16,
      "thresholds": "None",
      "hitPoints": 1,
      "stress": 1,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Eldritch Might",
        "range": "Melee",
        "damage": "12 phy"
      },
      "experience": "Visions +2",
      "description": "A luminary of the Mortal Realm who has given their mind to extradimensional entities in exchange for eldritch abilities.",
      "features": [
        {
          "name": "Minion (12)",
          "kind": "Passive",
          "rulesText": "The Novitiate is defeated when they take any damage. For every 12 damage a PC deals to the Novitiate, the PC defeats an additional Minion within range the attack would succeed against."
        },
        {
          "name": "Group Attack",
          "kind": "Action",
          "rulesText": "Spend a Fear to choose a target and spotlight all Cephilith Novitiates within Close range of them. Those Minions move into Melee range of the target and make one shared attack roll. On a success, they deal 12 physical damage each. Combine this damage."
        },
        {
          "name": "Sacrifice Self",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Novitiate charge at a target within Far range and melt into them. Deal 12 direct magic damage to the target and defeat the Novitiate."
        }
      ],
      "role": "Minion",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/cephilith-novitiate/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/cephilith-priest",
      "@type": "Adversary",
      "name": "Cephilith Priest",
      "slug": "cephilith-priest",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CEPHILITH PRIEST",
        "lineStart": 10406,
        "lineEnd": 10426,
        "pdfPageStart": 146,
        "pdfPageEnd": 146
      },
      "tier": 4,
      "motivesAndTactics": [
        "Break the unbelievers’ minds",
        "prepare this world for the Cephilith Titan’s arrival",
        "sing its praises"
      ],
      "difficulty": 20,
      "thresholds": "37/70",
      "hitPoints": 7,
      "stress": 5,
      "attackModifier": "+8",
      "standardAttack": {
        "name": "Psychic Strike",
        "range": "Far",
        "damage": "4d10+10 mag"
      },
      "experience": "Outer Realms +4",
      "description": "A perpetually moist, faceless humanoid from the Outer Realms who has elongated fingers and translucent skin, under which one can see wriggling worms.",
      "features": [
        {
          "name": "Psychic Blast",
          "kind": "Action",
          "rulesText": "Spend a Fear to choose up to three PCs within Close range and force them to make a Knowledge Reaction Roll. Targets who succeed take 2d10+5 direct magic damage. Targets who fail take 4d10+10 direct magic damage and are Vulnerable until spotlighted."
        },
        {
          "name": "Cerebral Incursion",
          "kind": "Action",
          "rulesText": "Spend a Fear to choose a Vulnerable target within Melee range. The Priest grabs the target and inserts their elongated fingers into the target’s ears, nose, and mouth. The target must succeed on a Strength Reaction Roll or mark 1d6 Stress, and the Priest clears an equal number of Stress."
        },
        {
          "name": "Telekinetic Grasp",
          "kind": "Reaction",
          "rulesText": "When the Priest makes a successful standard attack against a PC, you can mark a Stress to Restrain the target until they spend a Hope."
        }
      ],
      "role": "Leader",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/cephilith-priest/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/cephilith-titan",
      "@type": "Adversary",
      "name": "Cephilith Titan",
      "slug": "cephilith-titan",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CEPHILITH TITAN",
        "lineStart": 10428,
        "lineEnd": 10454,
        "pdfPageStart": 146,
        "pdfPageEnd": 146
      },
      "tier": 4,
      "motivesAndTactics": [
        "Call and consume followers",
        "corrupt reality",
        "invade the Mortal Realm",
        "spew forth chaos"
      ],
      "difficulty": 20,
      "thresholds": "38/68",
      "hitPoints": 10,
      "stress": 10,
      "attackModifier": "+8",
      "standardAttack": {
        "name": "Pseudoclaw",
        "range": "Close",
        "damage": "4d8+10 mag"
      },
      "experience": "Chaos +5, Psychic +5",
      "description": "A transdimensional entity in the form of an impossibly large, winged humanoid with an octopus-shaped head and rows of glowing eyes.",
      "features": [
        {
          "name": "Relentless (X)",
          "kind": "Passive",
          "rulesText": "The Titan can be spotlighted up to X times per GM turn, where X equals the number of PCs in the scene. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Terrifying",
          "kind": "Passive",
          "rulesText": "When the Titan makes a successful attack, all PCs within Close range lose a Hope, and you gain a Fear."
        },
        {
          "name": "Merely a Projection",
          "kind": "Passive",
          "rulesText": "The Titan appears in the Mortal Realm as a psychic projection approximating their true form. They have immunity to physical damage and resistance to magic damage."
        },
        {
          "name": "Psychic Scream",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Titan unleash a mind-shattering onslaught of nightmarish visions from the Outer Realms. Each PC within Far range must make an Instinct Reaction Roll (22). Targets who fail take 4d12 direct magic damage. Targets who succeed must mark a Stress."
        },
        {
          "name": "Summon Worshippers",
          "kind": "Action",
          "rulesText": "Spend a Fear to summon 1d4 Cephilith Abominations, which appear within Far range, then choose one to immediately spotlight."
        },
        {
          "name": "“It’s Here…”",
          "kind": "Evolution",
          "rulesText": "When the Titan has marked half their HP, they manifest in their full form, clearing all HP and losing the “Merely a Projection” feature. While the Titan is in this form, a creature who marks HP from the Titan’s standard attack must mark an additional HP."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/cephilith-titan/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/chaos-skull",
      "@type": "Adversary",
      "name": "Chaos Skull",
      "slug": "chaos-skull",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
