      },
      "level": 9,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/midnight"
      },
      "cardType": "Ability",
      "recallCost": 1,
      "rulesText": "Choose a target within Far range. When you succeed on an action roll against them that doesn’t result in making a damage roll, place a token on this card. When you deal damage to this target, spend any number of tokens to add a d12 for each token spent to your damage roll. You can only hold Twilight Toll on one creature at a time.\n\nWhen you choose a new target or take a rest, clear all unspent tokens.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/twilight-toll/"
      },
