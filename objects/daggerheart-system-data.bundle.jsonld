    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/vampire-lord",
      "@type": "Adversary",
      "name": "Vampire Lord",
      "slug": "vampire-lord",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "VAMPIRE LORD",
        "lineStart": 10080,
        "lineEnd": 10112,
        "pdfPageStart": 142,
        "pdfPageEnd": 142
      },
      "tier": 3,
      "motivesAndTactics": [
        "Corrupt",
        "destroy",
        "overwhelm with evil power"
      ],
      "difficulty": 18,
      "thresholds": "24/45",
      "hitPoints": 7,
      "stress": 7,
      "attackModifier": "+5",
      "standardAttack": {
        "name": "Claws",
        "range": "Melee",
        "damage": "3d10+2 phy"
      },
      "experience": "Evil +3, Noble +3",
      "description": "A cruel vampire lord from a long-lost age, cursed with immortality.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Vampire Lord can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Midnight Heart",
          "kind": "Passive",
          "rulesText": "Long-Term Countdown (6). The Vampire Lord keeps their heart hidden in a safe place. If it’s destroyed, the Vampire Lord dies. Otherwise, when the Vampire Lord is defeated, activate the countdown. It ticks down each time the PCs finish a long rest. When it triggers, the Vampire Lord revives within Close range of the heart with all HP and Stress cleared."
        },
        {
          "name": "Terrifying",
          "kind": "Passive",
          "rulesText": "When the Vampire Lord makes a successful attack roll, all PCs within Close range lose a Hope, and you gain a Fear."
        },
        {
          "name": "Unleash Hellfire",
          "kind": "Action",
          "rulesText": "Mark a Stress to have the Vampire Lord momentarily conjure 1d4 bursts of hellfire within Far range. Each burst deals 3d6 magic damage to each target within Very Close range. If a target takes damage from multiple bursts, combine the damage."
        },
        {
          "name": "Resurgence",
          "kind": "Reaction",
          "rulesText": "When a PC within Very Close range rolls with Hope, you can spend a Fear to clear a HP or a Stress."
        },
        {
          "name": "Melt into Shadow",
          "kind": "Reaction",
          "rulesText": "When a PC would deal damage to the Vampire Lord, you can spend a Fear to roll a d6. On a result of 5 or higher, negate the damage, then teleport the Vampire Lord to a point within Far range."
        },
        {
          "name": "Hellwing",
          "kind": "Evolution",
          "rulesText": "When the Vampire Lord marks half their HP, they transform into the Hellwing: a towering, demonic bat creature. They gain the “On Crimson Wings” and “Bloodbath” features and replace their standard attack with the following standard attack: Claws: Close | 3d12+6 phy"
        },
        {
          "name": "On Crimson Wings",
          "kind": "Passive",
          "rulesText": "While flying, the Hellwing gains a +1 bonus to their Difficulty."
        },
        {
          "name": "Bloodbath",
          "kind": "Reaction",
          "rulesText": "When the Hellwing takes Major or greater damage, the ground within Very Close range is covered with blood, dealing 3d10 magic damage to all other creatures in the area. When the Hellwing takes the spotlight on subsequent GM turns, all other creatures in that area take 3d6 magic damage."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/vampire-lord/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/vault-guardian-gaoler",
      "@type": "Adversary",
      "name": "Vault Guardian Gaoler",
      "slug": "vault-guardian-gaoler",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "VAULT GUARDIAN GAOLER",
        "lineStart": 10114,
        "lineEnd": 10130,
        "pdfPageStart": 142,
        "pdfPageEnd": 142
      },
      "tier": 3,
      "motivesAndTactics": [
        "Carry away",
        "entrap",
        "protect",
        "pummel"
      ],
      "difficulty": 16,
      "thresholds": "19/33",
      "hitPoints": 5,
      "stress": 3,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Body Bash",
        "range": "Very Close",
        "damage": "3d6+2 phy"
      },
      "description": "A boxy, dust-covered construct with thick metallic swinging doors on their torso.",
      "features": [
        {
          "name": "Blocking Shield",
          "kind": "Passive",
          "rulesText": "Creatures within Melee range of the Gaoler have disadvantage on attack rolls against them. Creatures trapped inside the Gaoler are immune to this feature."
        },
        {
          "name": "Lock Up",
          "kind": "Action",
          "rulesText": "Mark a Stress to make an attack against a target within Very Close range. On a success, the target is Restrained within the Gaoler until freed with a successful Strength Roll (18). While Restrained, the target can only attack the Gaoler."
        }
      ],
      "role": "Support",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/vault-guardian-gaoler/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/vault-guardian-sentinel",
      "@type": "Adversary",
      "name": "Vault Guardian Sentinel",
      "slug": "vault-guardian-sentinel",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "VAULT GUARDIAN SENTINEL",
        "lineStart": 10134,
        "lineEnd": 10154,
        "pdfPageStart": 143,
        "pdfPageEnd": 143
      },
      "tier": 3,
      "motivesAndTactics": [
        "Destroy at any cost",
        "expunge",
        "protect"
      ],
      "difficulty": 17,
      "thresholds": "21/40",
      "hitPoints": 6,
      "stress": 3,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Charged Mace",
        "range": "Very Close",
        "damage": "2d12+1 phy"
      },
      "description": "A dust-covered golden construct with boxy limbs and a huge mace for a hand.",
      "features": [
        {
          "name": "Kinetic Slam",
          "kind": "Passive",
          "rulesText": "Targets who take damage from the Sentinel’s standard attack are knocked back to Very Close range."
        },
        {
          "name": "Box In",
          "kind": "Action",
          "rulesText": "Mark a Stress to choose a target within Very Close range to focus on. That target has disadvantage on attack rolls when they’re within Very Close range of the Sentinel. The Sentinel can only focus on one target at a time."
        },
        {
          "name": "Mana Bolt",
          "kind": "Action",
          "rulesText": "Spend a Fear to lob explosive magic at a point within Far range. All targets within Very Close range of that point must make an Agility Reaction Roll. Targets who fail take 2d8+20 magic damage and are knocked back to Close range. Targets who succeed take half damage and aren’t knocked back."
        },
        {
          "name": "Momentum",
          "kind": "Reaction",
          "rulesText": "When the Sentinel makes a successful attack against a PC, you gain a Fear."
        }
      ],
      "role": "Bruiser",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/vault-guardian-sentinel/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/vault-guardian-turret",
      "@type": "Adversary",
      "name": "Vault Guardian Turret",
      "slug": "vault-guardian-turret",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "VAULT GUARDIAN TURRET",
        "lineStart": 10156,
        "lineEnd": 10176,
        "pdfPageStart": 143,
        "pdfPageEnd": 143
      },
      "tier": 3,
      "motivesAndTactics": [
        "Concentrate fire",
        "lock down",
        "mark",
        "protect"
      ],
      "difficulty": 16,
      "thresholds": "20/32",
      "hitPoints": 5,
      "stress": 4,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Magitech Cannon",
        "range": "Far",
        "damage": "3d10+3 mag"
      },
      "description": "A massive living turret with reinforced armor and twelve piston-driven mechanical legs.",
      "features": [
        {
          "name": "Slow Firing",
          "kind": "Passive",
          "rulesText": "When you spotlight the Turret and they don’t have a token on their stat block, they can’t make a standard attack. Place a token on their stat block and describe what they’re preparing to do. When you spotlight the Turret and they have a token on their stat block, clear the token and they can attack."
        },
        {
          "name": "Mark Target",
          "kind": "Action",
          "rulesText": "Spend a Fear to Mark a target within Far range until the Turret is destroyed or the Marked target becomes Hidden. While the target is Marked, their Evasion is halved."
        },
        {
          "name": "Concentrate Fire",
          "kind": "Reaction",
          "rulesText": "When another adversary deals damage to a target within Far range of the Turret, you can mark a Stress to add the Turret’s standard attack damage to the damage roll."
        },
        {
          "name": "Detonation",
          "kind": "Reaction",
          "rulesText": "When the Turret is destroyed, they explode. All targets within Close range must make an Agility Reaction Roll. Targets who fail take 3d20 physical damage. Targets who succeed take half damage."
        }
      ],
      "role": "Ranged",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/vault-guardian-turret/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/viper",
      "@type": "Adversary",
      "name": "Viper",
      "slug": "viper",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "VIPER",
        "lineStart": 6964,
        "lineEnd": 6984,
        "pdfPageStart": 111,
        "pdfPageEnd": 111
      },
      "tier": 1,
      "motivesAndTactics": [
        "Lie in wait",
        "slither",
        "strike"
      ],
      "difficulty": 11,
      "thresholds": "None",
      "hitPoints": 1,
      "stress": 1,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Bite",
        "range": "Melee",
        "damage": "1 phy"
      },
      "experience": "Grounded +4",
      "description": "A small serpent that envenomates its prey with hinged fangs.",
      "features": [
        {
          "name": "Minion (4)",
          "kind": "Passive",
          "rulesText": "The Viper is defeated when it takes any damage. For every 4 damage a PC deals to the Viper, the PC defeats an additional Minion within range the attack would succeed against."
        },
        {
          "name": "Venomous",
          "kind": "Passive",
          "rulesText": "When the Viper makes a successful standard attack, the target becomes temporarily Envenomated. While Envenomated, the target must mark a Stress whenever they make an action roll."
        },
        {
          "name": "Group Attack",
          "kind": "Action",
          "rulesText": "Spend a Fear to choose a target and spotlight all Vipers within Close range of them. Those Minions move into Melee range of the target and make one shared attack roll. On a success, they deal 1 physical damage each. Combine this damage."
        }
      ],
      "role": "Minion",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/viper/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/viscera-sucker",
      "@type": "Adversary",
      "name": "Viscera Sucker",
      "slug": "viscera-sucker",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "VISCERA SUCKER",
        "lineStart": 10178,
        "lineEnd": 10198,
        "pdfPageStart": 143,
        "pdfPageEnd": 143
      },
      "tier": 3,
      "motivesAndTactics": [
        "Clamp onto prey",
        "suck blood",
        "tear in half"
      ],
      "difficulty": 14,
      "thresholds": "16/30",
      "hitPoints": 5,
      "stress": 3,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Long Nails",
        "range": "Melee",
        "damage": "2d6+7 phy"
      },
      "experience": "Flying +3",
      "description": "A vampiric demon whose upper body detaches at sundown to fly through nearby villages in search of victims. It has a winged upper body with hanging entrails.",
      "features": [
        {
          "name": "Join or Die",
          "kind": "Passive",
          "rulesText": "The Viscera Sucker dies if it hasn’t reconnected its upper and lower halves by dawn."
        },
        {
          "name": "Entangling Entrails",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Viscera Sucker latch onto a target within Very Close range, Restraining them until they escape with a successful Strength Roll (16)."
        },
        {
          "name": "Lifesuck",
          "kind": "Action",
          "rulesText": "Mark a Stress to have the Viscera Sucker drink blood from a Restrained target within Melee range. The target marks a HP, and the Viscera Sucker clears a HP."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/viscera-sucker/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/volcanic-dragon-ashen-tyrant",
      "@type": "Adversary",
      "name": "Volcanic Dragon: Ashen Tyrant",
      "slug": "volcanic-dragon-ashen-tyrant",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "VOLCANIC DRAGON: ASHEN TYRANT",
        "lineStart": 11281,
        "lineEnd": 11309,
        "pdfPageStart": 156,
        "pdfPageEnd": 156
      },
      "tier": 4,
      "motivesAndTactics": [
        "Choke",
        "fly",
        "intimidate",
        "kill or be killed"
      ],
      "difficulty": 18,
      "thresholds": "29/55",
      "hitPoints": 8,
      "stress": 5,
      "attackModifier": "+10",
      "standardAttack": {
        "name": "Claws and Teeth",
        "range": "Close",
        "damage": "4d12+15 phy"
      },
      "experience": "Hunt from Above +5",
      "description": "No enemy has ever had the insolence to wound the dragon so. As the lava settles, it’s ground to ash like the dragon’s past foes.",
      "features": [
        {
          "name": "Relentless (4)",
          "kind": "Passive",
          "rulesText": "The Ashen Tyrant can be spotlighted up to four times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Cornered",
          "kind": "Passive",
          "rulesText": "Mark a Stress instead of spending a Fear to spotlight the Ashen Tyrant."
        },
        {
          "name": "Injured Wings",
          "kind": "Passive",
          "rulesText": "While flying, the Ashen Tyrant gains a +1 bonus to their Difficulty."
        },
        {
          "name": "Ashes to Ashes",
          "kind": "Passive",
          "rulesText": "When a PC rolls a failure while within Close range of the Ashen Tyrant, they lose a Hope and you gain a Fear. If the PC can’t lose a Hope, they must mark a HP."
        },
        {
          "name": "Desperate Rampage",
          "kind": "Action",
          "rulesText": "Mark a Stress to make an attack against all targets within Close range. Targets the Ashen Tyrant succeeds against take 2d20+2 physical damage, are knocked back to Close range of where they were, and must mark a Stress."
        },
        {
          "name": "Ashen Cloud",
          "kind": "Action",
          "rulesText": "Spend a Fear to smash the ground and kick up ash within Far range. While within the ash cloud, a target has disadvantage on action rolls. The ash cloud clears the next time an adversary is spotlighted."
        },
        {
          "name": "Apocalyptic Thrashing",
          "kind": "Action",
          "rulesText": "Countdown (1d12). Spend a Fear to activate. It ticks down when a PC rolls with Fear. When it triggers, the Ashen Tyrant thrashes about, causing environmental damage (such as an earthquake, avalanche, or collapsing walls). All targets within Far range must make a Strength Reaction Roll. Targets who fail take 2d10+10 physical damage and are Restrained by the rubble until they break free with a successful Strength Roll. Targets who succeed take half damage. If the Ashen Tyrant is defeated while this countdown is active, trigger the countdown immediately as the destruction caused by their death throes."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/volcanic-dragon-ashen-tyrant/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/volcanic-dragon-molten-scourge",
      "@type": "Adversary",
      "name": "Volcanic Dragon: Molten Scourge",
      "slug": "volcanic-dragon-molten-scourge",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "VOLCANIC DRAGON: MOLTEN SCOURGE",
        "lineStart": 11251,
        "lineEnd": 11279,
        "pdfPageStart": 156,
        "pdfPageEnd": 156
      },
      "tier": 4,
      "motivesAndTactics": [
        "Douse with lava",
        "incinerate",
        "repel Invaders",
        "reposition"
      ],
      "difficulty": 20,
      "thresholds": "30/58",
      "hitPoints": 7,
      "stress": 5,
      "attackModifier": "+9",
      "standardAttack": {
        "name": "Lava-Coated Claws",
        "range": "Close",
        "damage": "4d12+4 phy"
      },
      "experience": "Hunt from Above +5",
      "description": "Enraged by their wounds, the dragon bursts into molten lava.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Molten Scourge can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Cracked Scales",
          "kind": "Passive",
          "rulesText": "When the Molten Scourge takes damage, roll a number of d6s equal to HP marked. For each result of 4 or higher, you gain a Fear."
        },
        {
          "name": "Shattering Might",
          "kind": "Action",
          "rulesText": "Mark a Stress to make an attack against a target within Very Close range. On a success, the target takes 4d8+1 physical damage, loses a Hope, and is knocked back to Close range. The Molten Scourge clears a Stress."
        },
        {
          "name": "Eruption",
          "kind": "Action",
          "rulesText": "Spend a Fear to erupt lava from beneath the Molten Scourge’s scales, filling the area within Very Close range with molten lava. All targets in that area must succeed on an Agility Reaction Roll or take 4d6+6 physical damage and be knocked back to Close range. This area remains lava. When a creature other than the Molten Scourge enters that area or acts while inside of it, they must mark 6 HP."
        },
        {
          "name": "Volcanic Breath",
          "kind": "Reaction",
          "rulesText": "When the Molten Scourge takes Major damage, roll a d10. On a result of 8 or higher, the Molten Scourge breathes a flow of lava in front of them within Far range. All targets in that area must make an Agility Reaction Roll. Targets who fail take 2d10+4 physical damage, mark 1d4 Stress, and are Vulnerable until they clear a Stress. Targets who succeed take half damage and must mark a Stress."
        },
        {
          "name": "Lava Splash",
          "kind": "Reaction",
          "rulesText": "When the Molten Scourge takes Severe damage from an attack within Very Close range, molten blood gushes from the wound and deals 2d10+4 direct physical damage to the attacker."
        },
        {
          "name": "Ashen Vengeance (Phase Change)",
          "kind": "Reaction",
          "rulesText": "When the Molten Scourge marks their last HP, replace them with the Ashen Tyrant and immediately spotlight them."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/volcanic-dragon-molten-scourge/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/volcanic-dragon-obsidian-predator",
      "@type": "Adversary",
      "name": "Volcanic Dragon: Obsidian Predator",
      "slug": "volcanic-dragon-obsidian-predator",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "VOLCANIC DRAGON: OBSIDIAN PREDATOR",
        "lineStart": 11221,
        "lineEnd": 11247,
        "pdfPageStart": 155,
        "pdfPageEnd": 155
      },
      "tier": 4,
      "motivesAndTactics": [
        "Defend lair",
        "dive-bomb",
        "fly",
        "hunt",
        "intimidate"
      ],
      "difficulty": 19,
      "thresholds": "33/65",
      "hitPoints": 6,
      "stress": 5,
      "attackModifier": "+8",
      "standardAttack": {
        "name": "Obsidian Claws",
        "range": "Close",
        "damage": "4d10+4 phy"
      },
      "experience": "Hunt from Above +5",
      "description": "A massive winged creature with obsidian scales and impossibly sharp claws.",
      "features": [
        {
          "name": "Relentless (2)",
          "kind": "Passive",
          "rulesText": "The Obsidian Predator can be spotlighted up to two times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Flying",
          "kind": "Passive",
          "rulesText": "While flying, the Obsidian Predator gains a +3 bonus to their Difficulty."
        },
        {
          "name": "Obsidian Scales",
          "kind": "Passive",
          "rulesText": "The Obsidian Predator is resistant to physical damage."
        },
        {
          "name": "Avalanche Tail",
          "kind": "Action",
          "rulesText": "Mark a Stress to make an attack against all targets within Close range. Targets the Obsidian Predator succeeds against take 4d6+4 physical damage and are knocked back to Far range and Vulnerable until their next roll with Hope."
        },
        {
          "name": "Dive-Bomb",
          "kind": "Action",
          "rulesText": "If the Obsidian Predator is flying, mark a Stress to choose a point within Far range. Move to that point and make an attack against all targets within Very Close range. Targets the Obsidian Predator succeeds against take 2d10+6 physical damage and must mark a Stress and lose a Hope."
        },
        {
          "name": "Erupting Rage (Phase Change)",
          "kind": "Reaction",
          "rulesText": "When the Obsidian Predator marks their last HP, replace them with the Molten Scourge and immediately spotlight them."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/volcanic-dragon-obsidian-predator/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/war-wizard",
      "@type": "Adversary",
      "name": "War Wizard",
      "slug": "war-wizard",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "WAR WIZARD",
        "lineStart": 8944,
        "lineEnd": 8968,
        "pdfPageStart": 130,
        "pdfPageEnd": 130
      },
      "tier": 2,
      "motivesAndTactics": [
        "Develop new spells",
        "seek power",
        "shatter formations"
      ],
      "difficulty": 16,
      "thresholds": "11/23",
      "hitPoints": 5,
      "stress": 6,
      "attackModifier": "+4",
      "standardAttack": {
        "name": "Staff",
        "range": "Far",
        "damage": "2d10+4 mag"
      },
      "experience": "Magical Knowledge +2, Strategize +2",
      "description": "A battle-hardened mage trained in destructive magic.",
      "features": [
        {
          "name": "Battle Teleport",
          "kind": "Passive",
          "rulesText": "Before or after making a standard attack, you can mark a Stress to teleport to a location within Far range."
        },
        {
          "name": "Refresh Warding Sphere",
          "kind": "Action",
          "rulesText": "Mark a Stress to refresh the Wizard’s “Warding Sphere” reaction."
        },
        {
          "name": "Eruption",
          "kind": "Action",
          "rulesText": "Spend a Fear and choose a point within Far range. A Very Close area around that point erupts into impassable terrain. All targets within that area must make an Agility Reaction Roll (14). Targets who fail take 2d10 physical damage and are thrown out of the area. Targets who succeed take half damage and aren’t moved."
        },
        {
          "name": "Arcane Artillery",
          "kind": "Action",
          "rulesText": "Spend a Fear to unleash a precise hail of magical blasts. All targets in the scene must make an Agility Reaction Roll. Targets who fail take 2d12 magic damage. Targets who succeed take half damage."
        },
        {
          "name": "Warding Sphere",
          "kind": "Reaction",
          "rulesText": "When the Wizard takes damage from an attack within Close range, deal 2d6 magic damage to the attacker. This reaction can’t be used again until the Wizard refreshes it with their “Refresh Warding Sphere” action."
        }
      ],
      "role": "Ranged",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/war-wizard/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/water-mother",
      "@type": "Adversary",
      "name": "Water Mother",
      "slug": "water-mother",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "WATER MOTHER",
        "lineStart": 11313,
        "lineEnd": 11335,
        "pdfPageStart": 157,
        "pdfPageEnd": 157
      },
      "tier": 4,
      "motivesAndTactics": [
        "Constrict the world",
        "control the battlefield",
        "draw enemies into the water"
      ],
      "difficulty": 20,
      "thresholds": "40/70",
      "hitPoints": 12,
      "stress": 8,
      "attackModifier": "+8",
      "standardAttack": {
        "name": "Bite",
        "range": "Very Close",
        "damage": "4d10+5 phy"
      },
      "experience": "Rivers +4",
      "description": "A colossal fur-covered snake that hunts in large bodies of water.",
      "features": [
        {
          "name": "Segmented",
          "kind": "Passive",
          "rulesText": "The Water Mother’s body is divided into three segments: Head, Center, and Tail. The Water Mother always moves from the Head first, pulling the Center and then Tail behind it. A creature can target the Water Mother with an attack as long as at least one of her segments is within range, but the Water Mother can make a standard attack only against a target within range of her Head. If an attack deals damage to the Water Mother and her Head is within range, the attack deals an extra 1d10 damage."
        },
        {
          "name": "Eat the World",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Water Mother inhale sharply. Each PC within Close range of her Head must succeed on a Strength Reaction Roll or mark a Stress and be pulled within Melee range of the Head. The Water Mother then makes a standard attack against all targets within Melee range of her Head."
        },
        {
          "name": "Constrict",
          "kind": "Action",
          "rulesText": "Mark a Stress to make an attack against all targets within Melee range of the Center segment. Targets the attack succeeds against take 4d8+8 physical damage and are temporarily Restrained. At the beginning of each GM turn, you can mark a Stress to force all targets Restrained by the Water Mother to mark a HP."
        },
        {
          "name": "Venom Surge",
          "kind": "Reaction",
          "rulesText": "When the Water Mother makes a successful standard attack, you can spend a Fear to make the target Vulnerable until the end of the scene."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/water-mother/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/waxwork-creation",
      "@type": "Adversary",
      "name": "Waxwork Creation",
      "slug": "waxwork-creation",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "WAXWORK CREATION",
        "lineStart": 6986,
        "lineEnd": 7010,
        "pdfPageStart": 111,
        "pdfPageEnd": 111
      },
      "tier": 1,
      "motivesAndTactics": [
        "Lumber menacingly",
        "moan with the pain of unlife",
        "smother"
      ],
      "difficulty": 13,
      "thresholds": "8/15",
      "hitPoints": 10,
      "stress": 3,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Fists",
        "range": "Very Close",
        "damage": "1d20 phy"
      },
      "experience": "Giant-Sized +2",
      "description": "A ten-foot-tall, semisolid (and semisentient) candle wax construct.",
      "features": [
        {
          "name": "Relentless (2)",
          "kind": "Passive",
          "rulesText": "The Creation can be spotlighted up to two times per GM turn. Spend Fear as usual to spotlight it."
        },
        {
          "name": "No Vital Organs",
          "kind": "Passive",
          "rulesText": "The Creation doesn’t take extra damage from attacks that critically succeed against it."
        },
        {
          "name": "Wax Ball",
          "kind": "Action",
          "rulesText": "Mark a Stress to have the Creation throw a ball of wax at a target within Far range. Make an attack against the target. On a success, the target takes 1d12+2 physical damage and becomes Restrained until they succeed on a Strength Roll (15)."
        },
        {
          "name": "Splutch!",
          "kind": "Reaction",
          "rulesText": "When a PC within Melee range of the Creation makes a weapon attack against it, roll a d6. On a 5 or higher, the attacker’s weapon gets stuck in the Creation and can be removed only with a successful Strength Roll (15)."
        },
        {
          "name": "Smothering Grapple",
          "kind": "Reaction",
          "rulesText": "When the Creation makes a successful standard attack against a target within Melee range, you can spend a Fear to Trap the target inside the Creation’s wax body. While Trapped, the target is Restrained and must mark a Stress and move with the Creation each time it’s spotlighted. A Trapped creature is freed when the Creation takes Major or greater damage."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/waxwork-creation/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
