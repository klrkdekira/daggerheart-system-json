    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/rules/core-mechanics",
      "@type": "Rule",
      "name": "Core Mechanics",
      "slug": "core-mechanics",
      "sourceLocator": {
        "chapter": "CORE MECHANICS",
        "heading": "CORE MECHANICS",
        "lineStart": 2782,
        "lineEnd": 2782,
        "pdfPageStart": 46,
        "pdfPageEnd": 46
      },
      "rulesText": "",
      "htmlPage": {
