        "range": "Melee",
        "damage": "1d8+1 phy"
      },
      "experience": "Keen Senses +3, Slink +3",
      "description": "A large feline predator that stalks its prey from the shadows.",
      "features": [
        {
          "name": "Shadow Stalker",
          "kind": "Passive",
          "rulesText": "While Hidden, the Panther gains a +2 bonus to its attack rolls."
        },
        {
          "name": "Pouncing Strike",
          "kind": "Action",
          "rulesText": "Mark a Stress to have the Panther leap into Melee range of a target within Far range and make an attack against them. On a success, deal 1d12+2 physical damage."
        }
      ],
