    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/eclipse",
      "@type": "DomainCard",
      "name": "Eclipse",
      "slug": "eclipse",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "ECLIPSE",
        "lineStart": 15798,
        "lineEnd": 15808,
        "pdfPageStart": 218,
        "pdfPageEnd": 218
      },
      "level": 10,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/midnight"
      },
      "cardType": "Spell",
      "recallCost": 2,
      "rulesText": "Make a Spellcast Roll (16). Once per long rest on a success, plunge the entire area within Far range into complete darkness only you and your allies can see through. Attack rolls have disadvantage when targeting you or an ally within this shadow.\n\nAdditionally, when you or an ally succeeds with Hope against an adversary within this shadow, the target must mark a Stress.\n\nThis spell lasts until the GM spends a Fear on their turn to clear this effect or you take Severe damage.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/eclipse/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/eldritch-flesh",
      "@type": "DomainCard",
      "name": "Eldritch Flesh",
      "slug": "eldritch-flesh",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "ELDRITCH FLESH",
        "lineStart": 15357,
        "lineEnd": 15365,
        "pdfPageStart": 214,
        "pdfPageEnd": 214
      },
      "level": 8,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/dread"
      },
      "cardType": "Spell",
      "recallCost": 1,
      "rulesText": "Gain a +1 bonus to your damage thresholds for each Stress you have marked.\n\nAdditionally, when you roll with Fear, you can spend 2 Hope to clear an Armor Slot.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/eldritch-flesh/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/encore",
