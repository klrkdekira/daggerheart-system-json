        "lineEnd": 14766,
        "pdfPageStart": 209,
        "pdfPageEnd": 209
      },
      "level": 1,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/bone"
      },
      "cardType": "Ability",
      "recallCost": 0,
      "rulesText": "Once per rest, mark a Stress to sprint anywhere within Far range without making an Agility Roll to get there.\n\nIf you end this movement within Melee range of an adversary and immediately make an attack against them, gain a +1 bonus to the attack roll.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/deft-maneuvers/"
      },
