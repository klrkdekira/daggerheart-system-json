    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/manticore",
      "@type": "Adversary",
      "name": "Manticore",
      "slug": "manticore",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "MANTICORE",
        "lineStart": 9654,
        "lineEnd": 9680,
        "pdfPageStart": 138,
        "pdfPageEnd": 138
      },
      "tier": 3,
      "motivesAndTactics": [
        "Bite",
        "claw",
        "pounce",
        "riddle",
        "swipe",
        "swoop",
        "trick"
      ],
      "difficulty": 17,
      "thresholds": "20/35",
      "hitPoints": 12,
      "stress": 6,
      "attackModifier": "+6",
      "standardAttack": {
        "name": "Teeth & Claws",
        "range": "Very Close",
        "damage": "3d12+6 phy"
      },
      "experience": "Overgrowth +3, Riddles +3",
      "description": "A legendary beast that has a human’s face, lion’s body, scorpion’s tail, and dragon’s wings.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Manticore can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Riddle Me This",
          "kind": "Passive",
          "rulesText": "The Manticore is obsessed with puzzles and can be distracted by brain teasers, word games, or other semi-intellectual diversions."
        },
        {
          "name": "Winged",
          "kind": "Passive",
          "rulesText": "While airborne, the Manticore gains a +2 bonus to their Difficulty and attack rolls."
        },
        {
          "name": "Pouncing Attack",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Manticore pounce into Melee range of a target within Far range and make an attack against them. On a success, deal 3d20+6 physical damage, and the target becomes Shaky until they spend a Hope. While Shaky, the target makes attack rolls with disadvantage."
        },
        {
          "name": "Paralyzing Tail Spike",
          "kind": "Action",
          "rulesText": "Mark a Stress to make an attack roll against a target within Close range. On a success, the target takes 3d8 physical damage and becomes Restrained until they overcome the toxin with a successful Strength Roll."
        },
        {
          "name": "Locking Jaws",
          "kind": "Reaction",
          "rulesText": "When the Manticore succeeds on a standard attack against a target within Melee range, you can mark a Stress to lock their jaws onto the target, making the target Restrained and Vulnerable until they escape with a successful Strength Roll (19)."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/manticore/"
