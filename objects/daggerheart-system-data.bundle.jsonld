    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/dread-touched",
      "@type": "DomainCard",
      "name": "Dread-Touched",
      "slug": "dread-touched",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "DREAD-TOUCHED",
        "lineStart": 15328,
        "lineEnd": 15337,
        "pdfPageStart": 214,
        "pdfPageEnd": 214
      },
      "level": 7,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/dread"
      },
      "cardType": "Ability",
      "recallCost": 2,
      "rulesText": "When 4 or more of the domain cards in your loadout are from the Dread domain, gain the following benefits:\n\n  - When you succeed with Fear, you can mark 2 Stress to prevent the GM from gaining a Fear.\n  - Once per rest when making an action roll, you can gain a bonus to the roll equal to the number of Fear in the GM’s pool.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/dread-touched/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/earthquake",
      "@type": "DomainCard",
      "name": "Earthquake",
      "slug": "earthquake",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "EARTHQUAKE",
        "lineStart": 14549,
        "lineEnd": 14557,
        "pdfPageStart": 207,
        "pdfPageEnd": 207
      },
      "level": 9,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/arcana"
      },
      "cardType": "Spell",
      "recallCost": 2,
      "rulesText": "Make a Spellcast Roll (16). Once per rest on a success, all targets within Very Far range who aren’t flying must make a Reaction Roll (18). Targets who fail take 3d10+8 physical damage and are temporarily Vulnerable. Targets who succeed take half damage.\n\nAdditionally, when you succeed on the Spellcast Roll, all terrain within Very Far range becomes difficult to move through and structures within this range might sustain damage or crumble.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/earthquake/"
      },
