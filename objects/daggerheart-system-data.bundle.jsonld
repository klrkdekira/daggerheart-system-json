        "lineEnd": 9838,
        "pdfPageStart": 139,
        "pdfPageEnd": 139
      },
      "tier": 3,
      "motivesAndTactics": [
        "Ambush from below",
        "eat and leave",
        "tunnel and erupt",
        "use both ends"
      ],
      "difficulty": 17,
