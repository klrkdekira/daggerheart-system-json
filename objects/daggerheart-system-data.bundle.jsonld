    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/crimson-lepus",
      "@type": "Adversary",
      "name": "Crimson Lepus",
      "slug": "crimson-lepus",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CRIMSON LEPUS",
        "lineStart": 9076,
        "lineEnd": 9102,
        "pdfPageStart": 132,
        "pdfPageEnd": 132
      },
      "tier": 3,
      "motivesAndTactics": [
        "Be cute",
        "go for the throat",
        "hop around"
      ],
      "difficulty": 18,
      "thresholds": "20/35",
      "hitPoints": 10,
      "stress": 6,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Leaping Bite",
        "range": "Very Close",
        "damage": "3d20 phy"
      },
      "experience": "Vicious +4",
      "description": "A red-eyed rabbit that thinks only of murder.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Lepus can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight it."
        },
        {
          "name": "“Awww...”",
          "kind": "Passive",
          "rulesText": "When the Lepus first appears, it is Too Cute. To attack a Too Cute creature, a PC must succeed on an Instinct Reaction Roll (20). Clear the Too Cute condition if a PC deals damage to the Lepus or if the Lepus attacks a PC."
        },
        {
          "name": "Terrifying",
          "kind": "Passive",
          "rulesText": "When the Lepus makes a successful attack, all PCs within Close range lose a Hope, and you gain a Fear."
        },
        {
          "name": "Leaping Jugular Strike",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Lepus leap into Melee range of a target within Far range and make an attack against them. On a success, deal 3d20 direct physical damage. If the target marks HP from this attack, they become Vulnerable until they clear a HP."
        },
        {
          "name": "Evasive",
          "kind": "Reaction",
          "rulesText": "When the Lepus would take damage, roll a d6. On a 4 or higher, halve the damage. If the damage was already halved, the Lepus takes no damage."
        },
        {
          "name": "“Run Away!”",
          "kind": "Reaction",
          "rulesText": "When a PC with no Hope takes the spotlight within Very Far range of the Lepus, the PC must succeed on a Presence Reaction Roll or use their action to flee the battlefield until they spend a Hope to return."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/crimson-lepus/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/cryptimoth",
      "@type": "Adversary",
      "name": "Cryptimoth",
      "slug": "cryptimoth",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CRYPTIMOTH",
        "lineStart": 9104,
        "lineEnd": 9126,
        "pdfPageStart": 132,
        "pdfPageEnd": 132
      },
      "tier": 3,
      "motivesAndTactics": [
        "Echolocate",
        "fly silently",
        "melt into the shadows"
      ],
      "difficulty": 14,
      "thresholds": "16/30",
      "hitPoints": 5,
      "stress": 3,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Claws",
        "range": "Melee",
        "damage": "3d8+5 phy"
      },
      "experience": "Dark Omens +3",
      "description": "A large red-eyed moth creature that walks upright and portends mysterious or evil events.",
      "features": [
        {
          "name": "Terrifying",
          "kind": "Passive",
          "rulesText": "When the Cryptimoth makes a successful attack, all PCs within Close range lose a Hope, and you gain a Fear."
        },
        {
          "name": "Psychic Screech",
          "kind": "Action",
          "rulesText": "Spend 2 Fear to have the Cryptimoth unleash a burst of psychic energy that causes each PC within Far range to suffer visions of their horrifying fate. Each target must make an Instinct Reaction Roll (16). Targets who fail take 3d8 direct magic damage and become Vulnerable until their next rest. Targets who succeed must mark a Stress or take half damage."
        },
        {
          "name": "Shadow Swarm",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Cryptimoth conjure a swarm of mothlike shadow creatures within Far range. The swarm fills a Close range area and blocks line of sight. Creatures that aren’t Cryptimoths are Vulnerable while inside that area and must mark a Stress to move through it. A PC can dispel the swarm with a successful Spellcast Roll (12)."
        },
        {
          "name": "Paranoia Glare",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Cryptimoth gaze into the eyes of a PC within Close range and make them Paranoid. While Paranoid, the PC is suspicious of other PCs and can’t Help an Ally or take part in Tag Team Rolls. To clear this condition, the PC must succeed on an Instinct Roll (16) or participate in the Prepare downtime move with one or more members of their party during a rest."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/cryptimoth/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/cult-adept",
      "@type": "Adversary",
      "name": "Cult Adept",
      "slug": "cult-adept",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CULT ADEPT",
        "lineStart": 7517,
        "lineEnd": 7539,
        "pdfPageStart": 116,
        "pdfPageEnd": 116
      },
      "tier": 2,
      "motivesAndTactics": [
        "Curry favor",
        "hinder foes",
        "uncover knowledge"
      ],
      "difficulty": 14,
      "thresholds": "9/18",
      "hitPoints": 4,
      "stress": 6,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Rune-Covered Rod",
        "range": "Far",
        "damage": "2d4+3 mag"
      },
      "experience": "Fallen Lore +2, Rituals +2",
      "description": "An experienced mage wielding shadow and fear.",
      "features": [
        {
          "name": "Enervating Blast",
          "kind": "Action",
          "rulesText": "Spend a Fear to make a standard attack against a target within range. On a success, the target must mark a Stress."
        },
        {
          "name": "Shroud of the Fallen",
          "kind": "Action",
          "rulesText": "Mark a Stress to wrap an ally within Close range in a shroud of Protection until the Adept marks their last HP. While Protected, the target has resistance to all damage."
        },
        {
          "name": "Shadow Shackles",
          "kind": "Action",
          "rulesText": "Spend a Fear and choose a point within Far range. All targets within Close range of that point are Restrained in smoky chains until they break free with a successful Strength or Instinct Roll. A target Restrained by this feature must spend a Hope to make an action roll."
        },
        {
          "name": "Fear Is Fuel",
          "kind": "Reaction",
          "rulesText": "Twice per scene, when a PC rolls a failure with Fear, clear a Stress."
        }
      ],
      "role": "Support",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/cult-adept/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/cult-fang",
      "@type": "Adversary",
      "name": "Cult Fang",
