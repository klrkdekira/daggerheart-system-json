      },
      "experience": "History +3, Nobility +3",
      "description": "The sovereign ruler of a nation, wreathed in the privilege of tradition and wielding unmatched power in their domain.",
      "features": [
        {
          "name": "Execute Them!",
          "kind": "Action",
          "rulesText": "Spend a Fear per PC in the party to have the group condemned for crimes real or imagined. A PC who succeeds on a Presence Roll can demand trial by combat or another special form of trial."
        },
        {
          "name": "Crownsguard",
          "kind": "Action",
          "rulesText": "Once per scene, mark a Stress to summon six Tier 3 Minions, who appear at Close range to enforce the Monarch’s will."
        },
        {
          "name": "Casus Belli",
          "kind": "Reaction",
          "rulesText": "Long-Term Countdown (8). Spend a Fear to activate after the Monarch’s desire for war is first revealed. When it triggers, the Monarch has a reason to rally the nation to war and the support to act on that reason. You gain 1d4 Fear."
        }
      ],
      "role": "Social",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/monarch/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/mortal-hunter",
      "@type": "Adversary",
      "name": "Mortal Hunter",
      "slug": "mortal-hunter",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "MORTAL HUNTER",
        "lineStart": 8516,
        "lineEnd": 8538,
        "pdfPageStart": 126,
        "pdfPageEnd": 126
      },
      "tier": 2,
      "motivesAndTactics": [
        "Devour",
        "hunt",
        "track"
      ],
      "difficulty": 16,
      "thresholds": "15/27",
      "hitPoints": 6,
      "stress": 4,
      "attackModifier": "+5",
      "standardAttack": {
        "name": "Tear at Flesh",
        "range": "Very Close",
        "damage": "2d12+1 phy"
      },
      "experience": "Bloodhound +3",
      "description": "An undead figure wearing a heavy leather coat, with searching eyes and a casually cruel demeanor.",
      "features": [
        {
          "name": "Terrifying",
          "kind": "Passive",
          "rulesText": "When the Hunter makes a successful attack, all PCs within Far range lose a Hope and you gain a Fear."
        },
        {
          "name": "Deathlock",
          "kind": "Action",
          "rulesText": "Spend a Fear to curse a target within Very Close range with a necrotic Deathlock until the end of the scene. Attacks made by the Hunter against a Deathlocked target deal direct damage. The Hunter can only maintain one Deathlock at a time."
        },
        {
          "name": "Inevitable Death",
          "kind": "Action",
          "rulesText": "Mark a Stress to spotlight 1d4 allies. Attacks they make while spotlighted in this way deal half damage."
        },
        {
          "name": "Rampage",
          "kind": "Reaction",
          "rulesText": "Countdown (Loop 1d6). When the Hunter is in the spotlight for the first time, activate the countdown. When it triggers, move the Hunter in a straight line to a point within Far range and make an attack against all targets in their path. Targets the Hunter succeeds against take 2d8+2 physical damage."
        }
      ],
      "role": "Leader",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/mortal-hunter/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/mountain-troll",
      "@type": "Adversary",
      "name": "Mountain Troll",
      "slug": "mountain-troll",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "MOUNTAIN TROLL",
        "lineStart": 6266,
        "lineEnd": 6290,
        "pdfPageStart": 105,
        "pdfPageEnd": 105
      },
      "tier": 1,
      "motivesAndTactics": [
        "Ambush",
        "bellow",
        "hurl large boulders",
        "smash",
        "stomp"
      ],
      "difficulty": 14,
      "thresholds": "8/15",
      "hitPoints": 8,
      "stress": 3,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Skull Flail",
        "range": "Very Close",
        "damage": "1d8+1 phy"
      },
      "experience": "Mountains +4",
      "description": "A hideous giant born out of a massive rock. They wear purloined armor and a belt of severed heads or skulls.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Troll can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Stolen Armor",
          "kind": "Passive",
          "rulesText": "Countdown. When combat begins, activate a countdown with a value equal to the number of PCs. When the Troll takes damage, reduce the severity by one threshold, then tick down the countdown. When it triggers, the Troll evolves (see “Enraged Mountain Troll”)."
        },
        {
          "name": "Flail Swipe",
          "kind": "Action",
          "rulesText": "Mark a Stress to make an attack against all targets in front of the Troll within Very Close range. Targets the Troll succeeds against take 2d8+2 physical damage."
        },
        {
          "name": "Enraged Mountain Troll",
          "kind": "Evolution",
          "rulesText": "The Troll loses their “Stolen Armor” and “Flail Swipe” features, then gains a +1 bonus to their Difficulty. Additionally, they gain the “Double Swipe” feature and replace “Skull Flail” with the following standard attack: Claw Swipe: Very Close | 1d10+3 phy"
        },
        {
          "name": "Double Swipe",
          "kind": "Action",
          "rulesText": "Spend a Fear to move up to Close range and make two standard attacks against a target within Melee range. If both attacks succeed, combine the damage, and the target loses a Hope."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/mountain-troll/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/night-children",
      "@type": "Adversary",
      "name": "Night Children",
      "slug": "night-children",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "NIGHT CHILDREN",
        "lineStart": 9704,
        "lineEnd": 9724,
        "pdfPageStart": 138,
        "pdfPageEnd": 138
      },
      "tier": 3,
      "motivesAndTactics": [
        "Carry victims back to master",
        "overrun settlements",
        "slither through shadow"
      ],
      "difficulty": 16,
      "thresholds": "17/32",
      "hitPoints": 7,
      "stress": 4,
      "attackModifier": "+1",
      "standardAttack": {
        "name": "Fangs & Claws",
        "range": "Melee",
        "damage": "3d6+8 phy"
      },
      "experience": "Terrorize +3",
      "description": "A teeming assortment of nocturnal fiends under the thrall of an ancient evil.",
      "features": [
        {
          "name": "Horde (2d6+2)",
          "kind": "Passive",
          "rulesText": "When the Night Children have marked half or more of their HP, their standard attack deals 2d6+2 physical damage instead."
        },
        {
          "name": "Swell Ranks",
          "kind": "Action",
          "rulesText": "Once per scene, mark any number of Stress to have the Night Children open a portal that spews forth reinforcements, refilling the Horde’s ranks. Clear a number of HP equal to the number of Stress marked."
        },
        {
          "name": "Overwhelm",
          "kind": "Reaction",
          "rulesText": "When the Night Children mark HP from an attack within Melee range, you can mark a Stress to make a standard attack against the attacker."
        }
      ],
      "role": "Horde (2/HP)",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/night-children/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/oak-treant",
      "@type": "Adversary",
      "name": "Oak Treant",
      "slug": "oak-treant",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "OAK TREANT",
        "lineStart": 9946,
        "lineEnd": 9966,
        "pdfPageStart": 141,
        "pdfPageEnd": 141
      },
      "tier": 3,
      "motivesAndTactics": [
        "Hide in plain sight",
        "preserve the forest",
        "root down",
        "swing branches"
      ],
      "difficulty": 17,
      "thresholds": "22/40",
      "hitPoints": 7,
      "stress": 4,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Branch",
        "range": "Very Close",
        "damage": "3d8+2 phy"
      },
      "experience": "Forest Knowledge +3",
      "description": "A sturdy animate old-growth tree.",
      "features": [
        {
          "name": "Just a Tree",
          "kind": "Passive",
          "rulesText": "Before they make their first attack in a fight or after they become Hidden, the Treant is indistinguishable from other trees until they next act or a PC succeeds on an Instinct Roll to identify them."
        },
        {
          "name": "Seed Barrage",
          "kind": "Action",
          "rulesText": "Mark a Stress and make an attack against up to three targets within Close range, pummeling them with giant acorns. Targets the Treant succeeds against take 2d10+5 physical damage."
        },
        {
          "name": "Take Root",
          "kind": "Action",
          "rulesText": "Mark a Stress to Root the Treant in place. The Treant is Restrained while Rooted, and can end this effect instead of moving while they are spotlighted. While Rooted, the Treant has resistance to physical damage."
        }
      ],
      "role": "Bruiser",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/oak-treant/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/octopus",
      "@type": "Adversary",
      "name": "Octopus",
      "slug": "octopus",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "OCTOPUS",
        "lineStart": 6292,
        "lineEnd": 6310,
        "pdfPageStart": 105,
        "pdfPageEnd": 105
      },
      "tier": 1,
      "motivesAndTactics": [
        "Crawl along the ocean floor",
        "eat fish",
        "squirt ink to escape"
      ],
      "difficulty": 12,
      "thresholds": "3/None",
      "hitPoints": 2,
      "stress": 3,
      "attackModifier": "−1",
      "standardAttack": {
        "name": "Beak",
        "range": "Melee",
        "damage": "1d6 phy"
      },
      "experience": "Dexterity +3, Water +3",
      "description": "An aquatic, soft-bodied mollusk that has eight sucker-bearing arms and a hard, beaklike jaw.",
      "features": [
        {
          "name": "Grapple",
          "kind": "Action",
          "rulesText": "Make an attack roll against a target within Close range. On a success, the target becomes Restrained and Vulnerable until they escape with a successful Strength Roll."
        },
        {
          "name": "Squirt Ink",
          "kind": "Action",
          "rulesText": "Mark a Stress to have the Octopus squirt ink. On land, the ink covers the ground within Very Close range. Each creature who moves through that area must succeed on an Agility Reaction Roll or slip and fall, becoming Vulnerable until they exit the area. If this feature is used while the Octopus is underwater, it instead creates a cloud of darkness that fills an area within Very Close range and blocks line of sight."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/octopus/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/oracle-of-doom",
      "@type": "Adversary",
      "name": "Oracle of Doom",
      "slug": "oracle-of-doom",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "ORACLE OF DOOM",
        "lineStart": 11003,
        "lineEnd": 11029,
        "pdfPageStart": 153,
        "pdfPageEnd": 153
      },
      "tier": 4,
      "motivesAndTactics": [
        "Change environment",
        "condemn",
        "dishearten",
        "toss aside"
      ],
      "difficulty": 20,
      "thresholds": "38/68",
      "hitPoints": 11,
      "stress": 10,
      "attackModifier": "+8",
      "standardAttack": {
        "name": "Psychic Attack",
        "range": "Far",
        "damage": "4d8+9 mag"
      },
      "experience": "Boundless Knowledge +4",
      "description": "A towering immortal and incarnation of fate, cursed to only see bad outcomes.",
      "features": [
        {
          "name": "Terrifying",
          "kind": "Passive",
          "rulesText": "When the Oracle makes a successful attack, all PCs within Far range lose a Hope and you gain a Fear."
        },
        {
          "name": "Walls Closing In",
          "kind": "Passive",
          "rulesText": "When a creature rolls a failure while within Very Far range of the Oracle, they must mark a Stress."
        },
        {
          "name": "Pronounce Fate",
          "kind": "Action",
          "rulesText": "Spend a Fear to present a target within Far range with a vision of their personal nightmare. The target must make a Knowledge Reaction Roll. On a failure, they lose all Hope and take 2d20+4 direct magic damage. On a success, they take half damage and lose a Hope."
        },
        {
          "name": "Summon Tormentors",
          "kind": "Action",
          "rulesText": "Once per day, spend 2 Fear to summon 2d4 Tier 2 or below Minions relevant to one of the PC’s personal nightmares. They appear at Close range relative to that PC."
        },
        {
          "name": "Ominous Knowledge",
          "kind": "Reaction",
          "rulesText": "When the Oracle sees a mortal creature, they instantly know one of their personal nightmares."
        },
        {
          "name": "Vengeful Fate",
          "kind": "Reaction",
          "rulesText": "When the Oracle marks HP from an attack within Very Close range, you can mark a Stress to knock the attacker back to Far range and deal 2d10+4 physical damage."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/oracle-of-doom/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/outer-realms-abomination",
      "@type": "Adversary",
      "name": "Outer Realms Abomination",
      "slug": "outer-realms-abomination",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "OUTER REALMS ABOMINATION",
        "lineStart": 11031,
        "lineEnd": 11051,
        "pdfPageStart": 153,
        "pdfPageEnd": 153
      },
      "tier": 4,
      "motivesAndTactics": [
        "Demolish",
        "devour",
        "undermine"
      ],
      "difficulty": 19,
      "thresholds": "35/71",
      "hitPoints": 7,
      "stress": 5,
      "attackModifier": "+2d4",
      "standardAttack": {
        "name": "Massive Pseudopod",
        "range": "Very Close",
        "damage": "4d6+13 mag"
      },
      "description": "A chaotic mockery of life, constantly in flux.",
      "features": [
        {
          "name": "Chaotic Form",
          "kind": "Passive",
          "rulesText": "When the Abomination attacks, roll 2d4 and use the result as their attack modifier."
        },
        {
          "name": "Disorienting Presence",
          "kind": "Passive",
          "rulesText": "When a target takes damage from the Abomination, they must make an Instinct Reaction Roll. On a failure, they gain disadvantage on their next action roll and you gain a Fear."
        },
        {
          "name": "Reality Quake",
          "kind": "Action",
          "rulesText": "Spend a Fear to rattle the edges of reality within Far range of the Abomination. All targets within that area must succeed on a Knowledge Reaction Roll or become Unstuck from reality until the end of the scene. When an Unstuck target spends Hope or marks Armor Slots, HP, or Stress, they must double the amount spent or marked."
        },
        {
          "name": "Unreal Form",
          "kind": "Reaction",
          "rulesText": "When the Abomination takes damage, reduce it by 1d20. If the Abomination marks 1 or fewer Hit Points from a successful attack against them, you gain a Fear."
        }
      ],
      "role": "Bruiser",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/outer-realms-abomination/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/outer-realms-corrupter",
      "@type": "Adversary",
      "name": "Outer Realms Corrupter",
      "slug": "outer-realms-corrupter",
      "sourceLocator": {
