        {
          "name": "Preferential Treatment",
          "kind": "Passive",
          "rulesText": "A PC who succeeds on a Presence Roll against the Merchant gains a discount on purchases. A PC who fails on a Presence Roll against the Merchant must pay more and has disadvantage on future Presence Rolls against the Merchant."
        },
        {
          "name": "The Runaround",
