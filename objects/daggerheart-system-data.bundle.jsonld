    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/rejuvenation-barrier",
      "@type": "DomainCard",
      "name": "Rejuvenation Barrier",
      "slug": "rejuvenation-barrier",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "REJUVENATION BARRIER",
        "lineStart": 15979,
        "lineEnd": 15987,
        "pdfPageStart": 220,
        "pdfPageEnd": 220
      },
      "level": 8,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/sage"
      },
      "cardType": "Spell",
      "recallCost": 1,
      "rulesText": "Make a Spellcast Roll (15). Once per rest on a success, create a temporary barrier of protective energy around you at Very Close range. You and all allies within the barrier when this spell is cast clear 1d4 Hit Points. While the barrier is up, you and all allies within have resistance to physical damage from outside the barrier.\n\nWhen you move, the barrier follows you.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/rejuvenation-barrier/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/restoration",
      "@type": "DomainCard",
      "name": "Restoration",
      "slug": "restoration",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "RESTORATION",
        "lineStart": 16142,
        "lineEnd": 16152,
        "pdfPageStart": 221,
        "pdfPageEnd": 221
      },
      "level": 6,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/splendor"
      },
      "cardType": "Spell",
      "recallCost": 2,
      "rulesText": "After a long rest, place a number of tokens equal to your Spellcast trait on this card. Touch a creature and spend any number of tokens to clear 2 Hit Points or 2 Stress for each token spent.\n\nYou can also spend a token from this card when touching a creature to clear the Vulnerable condition or heal a physical or magical ailment (the GM might require additional tokens depending on the strength of the ailment).\n\nWhen you take a long rest, clear all unspent tokens.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/restoration/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/resurrection",
      "@type": "DomainCard",
      "name": "Resurrection",
      "slug": "resurrection",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "RESURRECTION",
        "lineStart": 16244,
        "lineEnd": 16252,
        "pdfPageStart": 222,
        "pdfPageEnd": 222
      },
      "level": 10,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/splendor"
      },
      "cardType": "Spell",
      "recallCost": 2,
      "rulesText": "Make a Spellcast Roll (20). On a success, restore one creature who has been dead no longer than 100 years to full strength. Then roll a d6. On a result of 5 or lower, place this card in your vault permanently.\n\nOn a failure, you can’t cast Resurrection again for a week.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/resurrection/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/rift-walker",
      "@type": "DomainCard",
      "name": "Rift Walker",
      "slug": "rift-walker",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "RIFT WALKER",
        "lineStart": 14496,
        "lineEnd": 14504,
        "pdfPageStart": 207,
        "pdfPageEnd": 207
      },
      "level": 6,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/arcana"
      },
      "cardType": "Spell",
      "recallCost": 2,
      "rulesText": "Make a Spellcast Roll (15). On a success, you place an arcane marking on the ground where you currently stand. The next time you successfully cast Rift Walker, a rift in space opens up, providing safe passage back to the exact spot where the marking was placed. This rift stays open until you choose to close it or you cast another spell.\n\nYou can drop the spell at any time to cast Rift Walker again and place the marking somewhere new.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/rift-walker/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/rise-up",
      "@type": "DomainCard",
      "name": "Rise Up",
      "slug": "rise-up",
