      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/royal-advisor",
      "@type": "Adversary",
      "name": "Royal Advisor",
      "slug": "royal-advisor",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "ROYAL ADVISOR",
        "lineStart": 8564,
        "lineEnd": 8584,
        "pdfPageStart": 127,
        "pdfPageEnd": 127
      },
      "tier": 2,
      "motivesAndTactics": [
        "Curry favor",
        "manufacture evidence",
        "scheme"
      ],
      "difficulty": 14,
      "thresholds": "8/15",
      "hitPoints": 3,
      "stress": 3,
      "attackModifier": "−3",
      "standardAttack": {
        "name": "Wand",
        "range": "Far",
        "damage": "1d4+3 phy"
      },
      "experience": "Administration +3, Courtier +3",
      "description": "A high-ranking courtier with the ear of the local nobility.",
      "features": [
        {
          "name": "Devastating Retort",
          "kind": "Passive",
          "rulesText": "A PC who rolls less than 17 on an action roll targeting the Advisor must mark a Stress."
        },
        {
          "name": "Bend Ears",
          "kind": "Action",
          "rulesText": "Mark a Stress to influence an NPC within Melee range with whispered words. That target’s opinion on one matter shifts toward the Advisor’s preference unless it is in direct opposition to the target’s motives."
        },
        {
          "name": "Scapegoat",
          "kind": "Action",
          "rulesText": "Spend a Fear to convince a crowd or notable individual that one person or group is responsible for some problem facing the target. The target becomes hostile to the scapegoat until convinced of their innocence with a successful Presence Roll (17)."
        }
      ],
      "role": "Social",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/royal-advisor/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/ruby-dragon",
      "@type": "Adversary",
      "name": "Ruby Dragon",
      "slug": "ruby-dragon",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "RUBY DRAGON",
        "lineStart": 11117,
        "lineEnd": 11141,
        "pdfPageStart": 154,
        "pdfPageEnd": 154
      },
      "tier": 4,
      "motivesAndTactics": [
        "Crack the earth",
        "melt",
        "protect treasure"
      ],
      "difficulty": 19,
      "thresholds": "30/50",
      "hitPoints": 6,
      "stress": 4,
      "attackModifier": "+6",
      "standardAttack": {
        "name": "Tooth & Claw",
        "range": "Close",
        "damage": "4d10+8 phy"
      },
      "experience": "Mountains +4",
      "description": "A huge winged dragon that has visible flames beneath its glittering, gem-encrusted scales. Its body heat melts stone.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Dragon can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight it."
        },
        {
          "name": "Fearsome",
          "kind": "Passive",
          "rulesText": "When the Dragon succeeds on an attack against a PC or a PC within Far range fails an action roll, you gain a Fear."
        },
        {
          "name": "Melting Breath",
          "kind": "Action",
          "rulesText": "Mark a Stress to have the Dragon unleash a blast of fire on all PCs in front of it within Close range. Each target must succeed on an Agility Reaction Roll or take 4d12+10 magic damage and mark an Armor Slot without gaining its benefits (they can still use armor to reduce the damage)."
        },
        {
          "name": "Volcanic Fissure",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Dragon snap its tail against the ground, opening a lava rift that flows over the area within Close range. Each PC within that area must make an Agility Reaction Roll. Targets who succeed immediately move out of the area. Targets who fail take 4d8+5 magic damage. Until the Dragon is defeated, a creature who enters the area takes 4d8+5 magic damage."
        },
        {
          "name": "Hot-Blooded",
          "kind": "Reaction",
          "rulesText": "When a creature makes a successful attack against the Dragon within Very Close range, the Dragon’s blood erupts from the wound and burns the attacker, forcing them to mark an Armor Slot. If they can’t mark an Armor Slot, they mark 1d4 HP."
        }
      ],
      "role": "Standard",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/ruby-dragon/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/rugaru",
      "@type": "Adversary",
      "name": "Rugaru",
      "slug": "rugaru",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "RUGARU",
        "lineStart": 6670,
        "lineEnd": 6694,
        "pdfPageStart": 108,
        "pdfPageEnd": 108
      },
      "tier": 1,
      "motivesAndTactics": [
        "Blaspheme",
        "go for the throat",
        "stalk",
        "terrorize"
      ],
      "difficulty": 14,
      "thresholds": "7/14",
      "hitPoints": 8,
      "stress": 4,
      "attackModifier": "+4",
      "standardAttack": {
        "name": "Snapping Jaws",
        "range": "Melee",
        "damage": "2d8+4 phy"
      },
      "experience": "Swamps +3",
      "description": "A wolf-headed humanoid cursed by the gods to prowl the swamps in search of blood.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Rugaru can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Child of Night",
          "kind": "Passive",
          "rulesText": "While in moonlight, the Rugaru gains a +2 bonus to their Difficulty."
        },
        {
          "name": "Bloodthirsty",
          "kind": "Passive",
          "rulesText": "When a PC marks HP from the Rugaru’s standard attack, add a token to this stat block. The Rugaru gains a bonus to attack rolls equal to the number of tokens on this stat block. Clear all tokens when the Rugaru takes Severe damage."
        },
        {
          "name": "Howl at the Moon",
          "kind": "Action",
          "rulesText": "Mark a Stress to force each PC within Far range to make a Presence Reaction Roll (15). Targets who fail lose a Hope. Gain a Fear for each Hope lost. If a PC has no Hope, they must mark a Stress and become Vulnerable until they roll with Hope."
        },
        {
          "name": "Flesh Ripper",
          "kind": "Action",
          "rulesText": "Mark a Stress to make an attack against a target within Melee range. On a success, deal 1d12+2 direct physical damage."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/rugaru/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/rust-eater",
      "@type": "Adversary",
      "name": "Rust Eater",
      "slug": "rust-eater",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "RUST EATER",
        "lineStart": 8586,
        "lineEnd": 8604,
        "pdfPageStart": 127,
        "pdfPageEnd": 127
      },
      "tier": 2,
      "motivesAndTactics": [
        "Avoid detection",
        "eat rust",
        "sniff out metal"
      ],
      "difficulty": 12,
      "thresholds": "10/18",
      "hitPoints": 5,
      "stress": 2,
      "attackModifier": "+1",
      "standardAttack": {
        "name": "Bite",
        "range": "Melee",
        "damage": "2d6+4 phy"
      },
      "experience": "Snuffle +3",
      "description": "A pony-sized cockroach coated in a corrosive chitin that turns metal into rust.",
      "features": [
        {
          "name": "Stifling Pheromones",
          "kind": "Passive",
          "rulesText": "A PC who makes an action roll within Very Close range of the Rust Eater must succeed on an Instinct Reaction Roll or mark a Stress."
        },
        {
          "name": "Rust Touch",
          "kind": "Passive",
          "rulesText": "The Rust Eater’s carapace is coated in a corrosive acid that pits and rusts metal. When a PC within Melee range of the Rust Easter succeeds on an attack against it with a metal weapon, reduce the weapon’s damage die by one step (for example, d8 to d6 or d6 to d4). If a weapon’s damage die is reduced below a d4, the weapon crumbles into rust. The Rust Eater then devours the rust pile and clears a HP."
        }
      ],
      "role": "Standard",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/rust-eater/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/sandwyrm",
