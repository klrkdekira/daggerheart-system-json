      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/hive-walker",
      "@type": "Adversary",
      "name": "Hive Walker",
      "slug": "hive-walker",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "HIVE WALKER",
        "lineStart": 8318,
        "lineEnd": 8336,
        "pdfPageStart": 124,
        "pdfPageEnd": 124
      },
      "tier": 2,
      "motivesAndTactics": [
        "Encase prey in honey",
        "protect the hive"
      ],
      "difficulty": 12,
      "thresholds": "11/24",
      "hitPoints": 3,
      "stress": 3,
      "attackModifier": "+1",
      "standardAttack": {
        "name": "Rotting Fist",
        "range": "Melee",
        "damage": "2d6+3 phy"
      },
      "experience": "Meat Eater +2",
      "description": "A corpse filled with and puppeted by a colony of carrion-eating bees.",
      "features": [
        {
          "name": "Blood Honey",
          "kind": "Action",
          "rulesText": "The Walker disgorges thick crimson honey at all targets between it and a point within Close range. Each target in that line must succeed on an Agility Reaction Roll or take 2d8 magic damage and become temporarily Restrained as the honey hardens on them."
        },
        {
          "name": "Bee-Ruption",
          "kind": "Reaction",
          "rulesText": "When the Walker marks HP, vengeful bees erupt from its body to protect it. Each target within Very Close range must succeed on an Instinct Reaction Roll or take 1d8 direct physical damage for each HP the Hive Walker has marked. Restrained targets automatically fail the reaction roll."
        }
      ],
      "role": "Standard",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/hive-walker/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/huge-green-ooze",
      "@type": "Adversary",
      "name": "Huge Green Ooze",
      "slug": "huge-green-ooze",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "HUGE GREEN OOZE",
        "lineStart": 9560,
        "lineEnd": 9582,
        "pdfPageStart": 137,
        "pdfPageEnd": 137
      },
      "tier": 3,
      "motivesAndTactics": [
        "Camouflage",
        "creep up",
        "envelop",
        "multiply"
      ],
      "difficulty": 15,
      "thresholds": "15/30",
      "hitPoints": 7,
      "stress": 4,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Ooze Appendage",
        "range": "Melee",
        "damage": "3d8+1 mag"
      },
      "experience": "Blend In +3",
      "description": "A translucent green mound of acid taller than most humans.",
      "features": [
        {
          "name": "Slow",
          "kind": "Passive",
          "rulesText": "When you spotlight the Ooze and they don’t have a token on their stat block, they can’t act yet. Place a token on their stat block and describe what they’re preparing to do. When you spotlight the Ooze and they have a token on their stat block, clear the token and they can act."
        },
        {
          "name": "Acidic Form",
          "kind": "Passive",
          "rulesText": "When the Ooze makes a successful attack, the target must mark an Armor Slot without receiving its benefits (they can still use armor to reduce the damage). If they can’t mark an Armor Slot, they must mark an additional HP."
        },
        {
          "name": "Envelop",
          "kind": "Action",
          "rulesText": "Make an attack against a target within Melee range. On a success, the Ooze Envelops them and the target must mark 2 Stress. While Enveloped, the target must mark an additional Stress every time they make an action roll. When the Ooze takes Severe damage, all Enveloped targets are freed and the condition is cleared."
        },
        {
          "name": "Split",
          "kind": "Reaction",
          "rulesText": "When the Ooze has 4 or more HP marked, you can spend a Fear to split them into two Green Oozes (with no marked HP or Stress). Immediately spotlight both of them."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/huge-green-ooze/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/hydra",
      "@type": "Adversary",
      "name": "Hydra",
      "slug": "hydra",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "HYDRA",
        "lineStart": 9584,
        "lineEnd": 9606,
        "pdfPageStart": 137,
        "pdfPageEnd": 137
      },
      "tier": 3,
      "motivesAndTactics": [
        "Devour",
        "regenerate",
        "terrify"
      ],
      "difficulty": 18,
      "thresholds": "19/35",
      "hitPoints": 10,
      "stress": 5,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Bite",
        "range": "Close",
        "damage": "2d12+2 phy"
      },
      "description": "A quadrupedal scaled beast with multiple long-necked heads, each filled with menacing fangs.",
      "features": [
        {
          "name": "Many-Headed Menace",
          "kind": "Passive",
          "rulesText": "The Hydra begins with three heads and can have up to five. When the Hydra takes Major or greater damage, they lose a head."
        },
        {
          "name": "Relentless (X)",
          "kind": "Passive",
          "rulesText": "The Hydra can be spotlighted X times per GM turn, where X is the Hydra’s number of heads. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Regeneration",
          "kind": "Action",
          "rulesText": "If the Hydra has any marked HP, spend a Fear to clear a HP and grow two heads."
        },
        {
          "name": "Terrifying Chorus",
          "kind": "Action",
          "rulesText": "All PCs within Far range lose 2 Hope."
        },
        {
          "name": "Magical Weakness",
          "kind": "Reaction",
          "rulesText": "When the Hydra takes magic damage, they become Dazed until the next roll with Fear. While Dazed, they can’t use their Regeneration action but are immune to magic damage."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/hydra/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
