      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "PHOENIX",
        "lineStart": 9748,
        "lineEnd": 9768,
        "pdfPageStart": 139,
        "pdfPageEnd": 139
      },
      "tier": 3,
      "motivesAndTactics": [
        "Flee pursuers",
        "live brilliantly",
        "soar through the heavens",
        "wield light and flame"
      ],
      "difficulty": 18,
      "thresholds": "19/30",
      "hitPoints": 6,
      "stress": 6,
