    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/construct",
      "@type": "Adversary",
      "name": "Construct",
      "slug": "construct",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CONSTRUCT",
        "lineStart": 5512,
        "lineEnd": 5534,
        "pdfPageStart": 98,
        "pdfPageEnd": 98
      },
      "tier": 1,
      "motivesAndTactics": [
        "Destroy environment",
        "serve creator",
        "smash target",
        "trample groups"
      ],
      "difficulty": 13,
      "thresholds": "7/15",
      "hitPoints": 9,
      "stress": 4,
      "attackModifier": "+4",
      "standardAttack": {
        "name": "Fist Slam",
        "range": "Melee",
        "damage": "1d20 phy"
      },
      "description": "A roughly humanoid being of stone and steel, assembled and animated by magic.",
      "features": [
        {
          "name": "Relentless (2)",
          "kind": "Passive",
          "rulesText": "The Construct can be spotlighted up to two times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Weak Structure",
          "kind": "Passive",
          "rulesText": "When the Construct marks HP from physical damage, they must mark an additional HP."
        },
        {
          "name": "Trample",
          "kind": "Action",
          "rulesText": "Mark a Stress to make an attack against all targets in the Construct’s path when they move. Targets the Construct succeeds against take 1d8 physical damage."
        },
        {
          "name": "Overload",
          "kind": "Reaction",
          "rulesText": "Before rolling damage for the Construct’s attack, you can mark a Stress to gain a +10 bonus to the damage roll. The Construct can then take the spotlight again."
        },
        {
          "name": "Death Quake",
          "kind": "Reaction",
          "rulesText": "When the Construct marks their last HP, the magic powering them ruptures in an explosion of force. Make an attack with advantage against all targets within Very Close range. Targets the Construct succeeds against take 1d12+2 magic damage."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/construct/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/courtesan",
      "@type": "Adversary",
      "name": "Courtesan",
      "slug": "courtesan",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "COURTESAN",
        "lineStart": 7499,
        "lineEnd": 7515,
        "pdfPageStart": 116,
        "pdfPageEnd": 116
      },
      "tier": 2,
      "motivesAndTactics": [
        "Entice",
        "maneuver",
        "secure patrons"
      ],
      "difficulty": 13,
      "thresholds": "7/13",
      "hitPoints": 3,
      "stress": 4,
      "attackModifier": "−3",
      "standardAttack": {
        "name": "Dagger",
        "range": "Melee",
        "damage": "1d4+3 phy"
      },
      "experience": "Manipulation +3, Socialite +3",
      "description": "An accomplished manipulator and master of the social arts.",
      "features": [
        {
          "name": "Searing Glance",
          "kind": "Reaction",
          "rulesText": "When a PC within Close range makes a Presence Roll, you can mark a Stress to cast a gaze toward the aftermath. On the target’s failure, they must mark 2 Stress and are Vulnerable until the scene ends or they succeed on a social action against the Courtesan. On the target’s success, they must mark a Stress."
        }
      ],
      "role": "Social",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/courtesan/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/courtier",
      "@type": "Adversary",
      "name": "Courtier",
      "slug": "courtier",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "COURTIER",
        "lineStart": 5536,
        "lineEnd": 5554,
        "pdfPageStart": 98,
        "pdfPageEnd": 98
      },
      "tier": 1,
      "motivesAndTactics": [
        "Discredit",
        "gain favor",
        "maneuver",
        "scheme"
      ],
      "difficulty": 12,
      "thresholds": "4/8",
      "hitPoints": 3,
      "stress": 4,
      "attackModifier": "−4",
      "standardAttack": {
        "name": "Daggers",
        "range": "Melee",
        "damage": "1d4+2 phy"
      },
      "experience": "Socialite +3",
      "description": "An ambitious and ostentatiously dressed socialite.",
      "features": [
        {
          "name": "Mockery",
          "kind": "Action",
          "rulesText": "Mark a Stress to say something mocking and force a target within Close range to make a Presence Reaction Roll (14) to see if they can save face. On a failure, the target must mark 2 Stress and is Vulnerable until the scene ends."
        },
        {
          "name": "Scapegoat",
          "kind": "Action",
          "rulesText": "Spend a Fear and target a PC. The Courtier convinces a crowd or prominent individual that the target is the cause of their current conflict or misfortune."
        }
      ],
      "role": "Social",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/courtier/"
