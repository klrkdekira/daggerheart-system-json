    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/soul-shattered-mage",
      "@type": "Adversary",
      "name": "Soul-Shattered Mage",
      "slug": "soul-shattered-mage",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "SOUL-SHATTERED MAGE",
        "lineStart": 6814,
        "lineEnd": 6834,
        "pdfPageStart": 110,
        "pdfPageEnd": 110
      },
      "tier": 1,
      "motivesAndTactics": [
        "Babble in an unknown language",
        "laugh unsettlingly",
        "wield power beyond control"
      ],
      "difficulty": 12,
      "thresholds": "8/15",
      "hitPoints": 6,
      "stress": 5,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Wormwood Staff",
        "range": "Far",
        "damage": "1d12 mag"
      },
      "experience": "Forbidden Knowledge +2",
      "description": "A spellcaster with a psyche broken by knowledge best left hidden.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Mage can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Broken Magic",
          "kind": "Action",
          "rulesText": "Mark a Stress to roll a d6. The Mage uses the corresponding move: 1–2: Dimension Rift. Choose a target within Far range. The target teleports to a point you choose within Close range of their original position and takes 2d6 direct magic damage as their body and mind reassemble. 3–4: Time Dilation. Choose a group of PCs within Far range. Each target is Slowed until they roll with Hope. While Slowed, a target is Vulnerable and must mark a Stress when they move. 5–6: Discordant Visions. Make an attack against up to three targets within Close range. Targets the Mage succeeds against take 2d8 direct magic damage."
        },
        {
          "name": "Feel My Pain",
          "kind": "Reaction",
          "rulesText": "When the Mage marks HP, roll a number of d6s equal to the number of Stress the Mage has marked. The Mage deals direct magic damage equal to the total result to all PCs within Very Close range."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/soul-shattered-mage/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
