    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/patchwork-zombie-hulk",
      "@type": "Adversary",
      "name": "Patchwork Zombie Hulk",
      "slug": "patchwork-zombie-hulk",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "PATCHWORK ZOMBIE HULK",
        "lineStart": 7126,
        "lineEnd": 7148,
        "pdfPageStart": 113,
        "pdfPageEnd": 113
      },
      "tier": 1,
      "motivesAndTactics": [
        "Absorb corpses",
        "flail",
        "hunger",
        "terrify"
      ],
      "difficulty": 13,
      "thresholds": "8/15",
      "hitPoints": 10,
      "stress": 3,
      "attackModifier": "+4",
      "standardAttack": {
        "name": "Too Many Arms",
        "range": "Very Close",
        "damage": "1d20 phy"
      },
      "experience": "Intimidation +2, Tear Things Apart +2",
      "description": "A towering gestalt of corpses moving as one, with torso-sized limbs and fists as large as a grown halfling.",
      "features": [
        {
          "name": "Destructible",
          "kind": "Passive",
          "rulesText": "When the Zombie takes Major or greater damage, they mark an additional HP."
        },
        {
          "name": "Flailing Limbs",
          "kind": "Passive",
          "rulesText": "When the Zombie makes a standard attack, they can attack all targets within Very Close range."
        },
        {
          "name": "Another for the Pile",
          "kind": "Action",
          "rulesText": "When the Zombie is within Very Close range of a corpse, they can incorporate it into themselves, clearing a HP and a Stress."
        },
        {
          "name": "Tormented Screams",
          "kind": "Action",
          "rulesText": "Mark a Stress to cause all PCs within Far range to make a Presence Reaction Roll (13). Targets who fail lose a Hope and you gain a Fear for each. Targets who succeed must mark a Stress."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/patchwork-zombie-hulk/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
