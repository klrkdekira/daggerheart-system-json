    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/redcap-candlemaker",
      "@type": "Adversary",
      "name": "Redcap Candlemaker",
      "slug": "redcap-candlemaker",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "REDCAP CANDLEMAKER",
        "lineStart": 6626,
        "lineEnd": 6646,
        "pdfPageStart": 108,
        "pdfPageEnd": 108
      },
      "tier": 1,
      "motivesAndTactics": [
        "Cast long shadows",
        "keep out of the fray",
        "show them the light"
      ],
      "difficulty": 13,
      "thresholds": "7/13",
      "hitPoints": 6,
      "stress": 3,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Burning Candlestick",
        "range": "Very Close",
        "damage": "1d10+2 mag"
      },
      "experience": "Vigilance +3",
      "description": "A pale, gaunt cult leader wearing a conical red cap sealed on their head with candle wax. They wield a long rod with a candle atop it made from a hanged criminal’s hand.",
      "features": [
        {
          "name": "Hand of Glory",
          "kind": "Passive",
          "rulesText": "When the Candlemaker appears, place 5 tokens on this stat block. Remove a token whenever the Candlemaker marks a HP. While this stat block has 1 or more tokens on it, the Candlemaker is Hidden."
        },
        {
          "name": "Torchbearer",
          "kind": "Passive",
          "rulesText": "The light of the Candlemaker’s Hand of Glory inspires bloodlust in their allies. While this stat block has 1 or more tokens on it, each Redcap adversary within Close range gains a +1 bonus to their damage rolls."
        },
        {
          "name": "Dance in the Flames",
          "kind": "Action",
          "rulesText": "Spend a token from this stat block. The Candlemaker conjures a ball of fire on a group of PCs within Far range. Each target must make an Agility Reaction Roll. Targets who fail take 2d10 magic damage. Targets who succeed take half damage."
        }
      ],
      "role": "Leader",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/redcap-candlemaker/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
