        "name": "Longbow",
        "range": "Far",
        "damage": "1d8+3 phy"
      },
      "experience": "Local Knowledge +3",
      "description": "A tall guard bearing a longbow and quiver with arrows fletched in the settlement’s colors.",
      "features": [
        {
          "name": "Hobbling Shot",
          "kind": "Action",
          "rulesText": "Make an attack against a target within Far range. On a success, mark a Stress to deal 1d12+3 physical damage. If the target marks HP from this attack, they have disadvantage on Agility Rolls until they clear at least 1 HP."
        }
      ],
      "role": "Ranged",
      "htmlPage": {
