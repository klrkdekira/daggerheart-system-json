      },
      "tier": 3,
      "motivesAndTactics": [
        "Bind limbs",
        "drop from a great height",
        "lift off the ground",
        "swirl through the air",
        "wrap around heads"
      ],
      "difficulty": 16,
      "thresholds": "20/32",
      "hitPoints": 6,
