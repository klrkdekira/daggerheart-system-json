        "lineStart": 8780,
        "lineEnd": 8798,
        "pdfPageStart": 128,
        "pdfPageEnd": 128
      },
      "tier": 2,
      "motivesAndTactics": [
        "Cut and run",
        "disguise appearance",
        "eavesdrop"
      ],
      "difficulty": 15,
      "thresholds": "8/17",
      "hitPoints": 4,
      "stress": 3,
      "attackModifier": "−2",
      "standardAttack": {
        "name": "Dagger",
        "range": "Melee",
        "damage": "2d6+3 phy"
      },
      "experience": "Espionage +3",
      "description": "A skilled espionage agent with a knack for being in the right place to overhear secrets.",
      "features": [
        {
          "name": "Gathering Secrets",
          "kind": "Action",
          "rulesText": "Spend a Fear to describe how the Spy knows a secret about a PC in the scene."
        },
        {
          "name": "Fly on the Wall",
          "kind": "Reaction",
          "rulesText": "When a PC or group is discussing something sensitive, you can mark a Stress to reveal that the Spy is present in the scene, observing them. If the Spy escapes the scene to report their findings, you gain 1d4 Fear."
        }
      ],
      "role": "Social",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/spy/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/stag-knight",
      "@type": "Adversary",
      "name": "Stag Knight",
      "slug": "stag-knight",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "STAG KNIGHT",
        "lineStart": 9896,
        "lineEnd": 9916,
        "pdfPageStart": 140,
        "pdfPageEnd": 140
      },
      "tier": 3,
      "motivesAndTactics": [
        "Isolate",
        "maneuver",
        "protect the forest",
        "weed the unwelcome"
      ],
      "difficulty": 17,
      "thresholds": "19/36",
      "hitPoints": 7,
      "stress": 5,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Bramble Sword",
        "range": "Melee",
        "damage": "3d8+3 phy"
      },
      "experience": "Forest Knowledge +3",
      "description": "A knight with huge, majestic antlers wearing armor made of dangerous thorns.",
      "features": [
        {
          "name": "From Above",
          "kind": "Passive",
          "rulesText": "When the Knight succeeds on a standard attack from above a target, they deal 3d12+3 physical damage instead of their standard damage."
        },
        {
          "name": "Blade of the Forest",
          "kind": "Action",
          "rulesText": "Spend a Fear to make an attack against all targets within Very Close range. Targets the Knight succeeds against take physical damage equal to 3d4 + the target’s Major threshold."
        },
        {
          "name": "Thorny Armor",
          "kind": "Reaction",
          "rulesText": "When the Knight takes damage from an attack within Melee range, you can mark a Stress to deal 1d10+5 physical damage to the attacker."
        }
      ],
      "role": "Standard",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/stag-knight/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/stone-titan",
      "@type": "Adversary",
      "name": "Stone Titan",
      "slug": "stone-titan",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "STONE TITAN",
        "lineStart": 8802,
        "lineEnd": 8824,
        "pdfPageStart": 129,
        "pdfPageEnd": 129
      },
      "tier": 2,
      "motivesAndTactics": [
        "Blend into the rocks",
        "craft and contemplate",
        "pursue prophecy and solitude"
      ],
      "difficulty": 17,
      "thresholds": "17/32",
      "hitPoints": 5,
      "stress": 5,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Stone Hammer",
        "range": "Very Close",
        "damage": "3d6+8 phy"
      },
      "experience": "Crafting +3, Runes +3",
      "description": "A gray-skinned goliath who lives underground and specializes in crafting powerful items inlaid with magical runes.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Titan can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Skillful Strike",
          "kind": "Passive",
          "rulesText": "Before the Titan makes an attack, you can mark a Stress and roll a d6. On a result of 3 or higher, the target’s Evasion is halved against this attack."
        },
        {
          "name": "Sunlight Sickness",
          "kind": "Passive",
          "rulesText": "When the Titan first appears above ground, roll a d4. Mark a number of Stress equal to the result. The Titan gains a bonus to their attack and damage rolls equal to the number of Stress marked."
        },
        {
          "name": "Hammer Smash",
          "kind": "Action",
          "rulesText": "When a PC marks HP from the Titan’s standard attack, you can spend a Fear to force the target to mark an Armor Slot without gaining its benefits (they can still use armor to reduce the damage)."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/stone-titan/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/stonewraith",
      "@type": "Adversary",
      "name": "Stonewraith",
      "slug": "stonewraith",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "STONEWRAITH",
        "lineStart": 8826,
        "lineEnd": 8848,
        "pdfPageStart": 129,
        "pdfPageEnd": 129
      },
      "tier": 2,
      "motivesAndTactics": [
        "Defend territory",
        "isolate prey",
        "stalk"
      ],
      "difficulty": 13,
      "thresholds": "11/22",
      "hitPoints": 6,
      "stress": 3,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Bite and Claws",
        "range": "Melee",
        "damage": "2d8+6 phy"
      },
      "experience": "Stonesense +3",
      "description": "A prowling hunter, like a slinking mountain lion, with a slate-gray stone body.",
      "features": [
        {
          "name": "Stonestrider",
          "kind": "Passive",
          "rulesText": "The Stonewraith can move through stone and earth as easily as air. While within stone or earth, they are Hidden and immune to all damage."
        },
        {
          "name": "Rocky Ambush",
          "kind": "Action",
          "rulesText": "While Hidden, mark a Stress to leap into Melee range with a target within Very Close range. The target must succeed on an Agility or Instinct Reaction Roll (15) or take 2d8 physical damage and become temporarily Restrained."
        },
        {
          "name": "Avalanche Roar",
          "kind": "Action",
          "rulesText": "Spend a Fear to roar while within a cave and cause a cave-in. All targets within Close range must succeed on an Agility Reaction Roll (14) or take 2d10 physical damage. The rubble can be cleared with a Progress Countdown (8)."
        },
        {
          "name": "Momentum",
          "kind": "Reaction",
          "rulesText": "When the Stonewraith makes a successful attack against a PC, you gain a Fear."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/stonewraith/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/storm-titan",
      "@type": "Adversary",
      "name": "Storm Titan",
      "slug": "storm-titan",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "STORM TITAN",
        "lineStart": 9918,
        "lineEnd": 9942,
        "pdfPageStart": 140,
        "pdfPageEnd": 140
      },
      "tier": 3,
      "motivesAndTactics": [
        "Erupt violently",
        "wait",
        "watch"
      ],
      "difficulty": 20,
      "thresholds": "35/70",
      "hitPoints": 11,
      "stress": 8,
      "attackModifier": "+7",
      "standardAttack": {
        "name": "Lightning Bolt",
        "range": "Far",
        "damage": "3d20+10 mag"
      },
      "experience": "Power of the Storm +3",
      "description": "An ancient, wise, and temperamental goliath who has hair made of mist and electricity crackling across their skin.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Titan can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Momentum",
          "kind": "Passive",
          "rulesText": "When the Titan makes a successful attack against a PC, you gain a Fear."
        },
        {
          "name": "Ball Lightning",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Titan conjure 1d4 spheres of electrical energy within Close range. When the Titan is spotlighted, they can move each sphere up to Close range. When a sphere moves within Very Close range of a PC, the PC takes 4d6 magic damage, and the sphere disappears. Each sphere has the same Difficulty as the Titan and disappears if a creature deals magic damage to it."
        },
        {
          "name": "Storm Bringer",
          "kind": "Action",
          "rulesText": "Mark a Stress to have the Titan conjure a raging storm. Each PC within Close range of the Titan must make a Strength Reaction Roll. Targets who fail take 3d12 magic damage and are Vulnerable until they are spotlighted. Targets who succeed take half damage."
        },
        {
          "name": "Thunderclap",
          "kind": "Action",
          "rulesText": "Spend a Fear to target up to three PCs in front of the Titan within Close range. Each target marks a Stress and becomes Vulnerable until they roll with Hope."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/storm-titan/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/supreme-demiurge-adonix",
      "@type": "Adversary",
      "name": "Supreme Demiurge Adonix",
      "slug": "supreme-demiurge-adonix",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "SUPREME DEMIURGE ADONIX",
        "lineStart": 11165,
        "lineEnd": 11193,
        "pdfPageStart": 155,
        "pdfPageEnd": 155
      },
      "tier": 4,
      "motivesAndTactics": [
        "Establish dominion",
        "exile from reality",
        "float above it all",
        "speak into being"
      ],
      "difficulty": 20,
      "thresholds": "35/70",
      "hitPoints": 12,
      "stress": 10,
      "attackModifier": "+8",
      "standardAttack": {
        "name": "Wing Strike",
        "range": "Close",
        "damage": "4d12+10 phy"
      },
      "experience": "Omnipotence +10, Be Not Afraid +5",
      "description": "The four-faced angel from the Hallows Above who manifests in the Mortal Realm as a floating tetrahedron with numerous eyes and multiple sets of metallic feathered wings.",
      "features": [
        {
          "name": "Relentless (4)",
          "kind": "Passive",
          "rulesText": "Adonix can be spotlighted up to four times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Elemental Archon",
          "kind": "Action",
          "rulesText": "Mark a Stress to roll a d4. Adonix activates the corresponding effect: 1. Fire Beam. Adonix manifests a beam of elemental fire with a Very Close width from themself to the edge of the battlefield. Each target in the beam’s path must make an Agility Reaction Roll. Targets who fail take Severe damage. Targets who succeed take Minor damage.\n\n2. Thunderclap. All creatures within Far range must mark a Stress and become Vulnerable until they succeed on an attack roll or the Demiurge is defeated.\n3. Lightning Bolt. Make an attack against a target within Very Far range, dealing 4d8 magic damage on a success. If all results are even, make the same attack against a different target, repeating the cycle until you roll an odd result or run out of targets.\n4. Ice Storm. Each PC within Close range must succeed on a Strength Reaction Roll or mark 1d4 Stress and become Restrained until they spend a Hope to escape."
        },
        {
          "name": "Alpha to Omega",
          "kind": "Evolution",
          "rulesText": "When Adonix is defeated, they resurrect in Omega form with all HP and Stress cleared. Each PC within Very Far range must succeed on a Presence Reaction Roll or lose a Hope. You gain a Fear for each Hope lost in this way."
        },
        {
          "name": "Adonix gains the following features in this form: Forsaken",
          "kind": "Action",
          "rulesText": "Spend a Fear to choose a PC and activate a Forsaken Countdown (1d8) for them. It ticks down when Adonix is spotlighted. When it triggers, the PC must mark all their HP. The countdown ends if Adonix takes Severe damage. You can have only one Forsaken Countdown active at a time."
        },
        {
          "name": "Armageddon",
          "kind": "Reaction",
          "rulesText": "When Adonix is defeated again, they unleash a reality storm that shakes the realms to their foundations. Roll a d6. On a result of 5–6, each PC must make a death move."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/supreme-demiurge-adonix/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
