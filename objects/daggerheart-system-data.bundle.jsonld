    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/outer-realms-thrall",
      "@type": "Adversary",
      "name": "Outer Realms Thrall",
      "slug": "outer-realms-thrall",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "OUTER REALMS THRALL",
        "lineStart": 11071,
        "lineEnd": 11087,
        "pdfPageStart": 153,
        "pdfPageEnd": 153
      },
      "tier": 4,
      "motivesAndTactics": [
        "Destroy",
        "disgust",
        "disorient",
        "intimidate"
      ],
      "difficulty": 17,
      "thresholds": "None",
      "hitPoints": 1,
      "stress": 1,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Claws and Teeth",
        "range": "Very Close",
        "damage": "11 phy"
      },
      "description": "A vaguely humanoid form stripped of memory and identity.",
      "features": [
        {
          "name": "Minion (13)",
          "kind": "Passive",
          "rulesText": "The Thrall is defeated when they take any damage. For every 13 damage a PC deals to the Thrall, defeat an additional Minion within range the attack would succeed against."
        },
        {
          "name": "Group Attack",
          "kind": "Action",
          "rulesText": "Spend a Fear to choose a target and spotlight all Outer Realm Thralls within Close range of them. Those Minions move into Melee range of the target and make one shared attack roll. On a success, they deal 11 physical damage each. Combine this damage."
        }
      ],
      "role": "Minion",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/outer-realms-thrall/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/owl-witch",
      "@type": "Adversary",
      "name": "Owl Witch",
      "slug": "owl-witch",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "OWL WITCH",
        "lineStart": 11091,
        "lineEnd": 11115,
        "pdfPageStart": 154,
        "pdfPageEnd": 154
      },
      "tier": 4,
      "motivesAndTactics": [
        "Consume essence",
        "curse",
        "predict death"
      ],
      "difficulty": 19,
      "thresholds": "27/47",
      "hitPoints": 4,
      "stress": 3,
      "attackModifier": "+7",
      "standardAttack": {
        "name": "Razor Talons",
        "range": "Very Close",
        "damage": "4d8+5 phy"
      },
      "experience": "Magic +2, Night Stalker +2",
      "description": "A giant, vengeful barn owl that has a 15-foot wingspan and a human face.",
      "features": [
        {
          "name": "Ill Omen",
          "kind": "Passive",
          "rulesText": "When a PC within Close range makes an action roll, their Fear Die gains a bonus equal to the amount of Fear you have."
        },
        {
          "name": "Witch Barrier",
          "kind": "Passive",
          "rulesText": "The Owl Witch has resistance to magic damage."
        },
        {
          "name": "Voice Mimicry",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Owl Witch beckon with the voice of a beloved figure to a creature within earshot. The target must succeed on an Instinct Reaction Roll or move up to Far range toward the Owl Witch."
        },
        {
          "name": "Nightmare Stare",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Owl Witch Aﬄict a PC within Far range with waking nightmares unless the target succeeds on a Knowledge Reaction Roll. While Aﬄicted, the target can’t clear HP or Stress. The condition is cleared when another PC uses a downtime move to comfort the Aﬄicted creature."
        },
        {
          "name": "Visions of a Violent End",
          "kind": "Reaction",
          "rulesText": "When the Owl Witch is targeted by an attack, you can spend a Fear to force the attacker to make a Presence Reaction Roll. On a failure, they must mark 1d4 Stress as their mind is flooded with harrowing imagery."
        }
      ],
      "role": "Support",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/owl-witch/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/pain-priest",
      "@type": "Adversary",
      "name": "Pain Priest",
      "slug": "pain-priest",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "PAIN PRIEST",
        "lineStart": 9726,
        "lineEnd": 9744,
        "pdfPageStart": 138,
        "pdfPageEnd": 138
      },
      "tier": 3,
      "motivesAndTactics": [
        "Feed on emotions",
        "locate the innocent or curious",
        "tempt them with their deepest desires"
      ],
      "difficulty": 16,
      "thresholds": "16/32",
      "hitPoints": 6,
      "stress": 5,
      "attackModifier": "+0",
      "standardAttack": {
        "name": "Torture Implements",
        "range": "Melee",
        "damage": "3d6+4 phy"
      },
      "experience": "Experimentation +4",
      "description": "A member of an other-dimensional religious order devoted to exploring the boundaries of mortal suffering and ecstasy.",
      "features": [
        {
          "name": "Walk Between Worlds",
          "kind": "Action",
          "rulesText": "Mark a Stress to place the Priest anywhere within Very Far range and immediately spotlight them again."
        },
        {
          "name": "Pleasure and Pain",
          "kind": "Reaction",
          "rulesText": "When a PC within Close range of the Priest gains a Hope or marks HP, roll a d8. On a result of 8, the Priest opens a portal to their original dimension and flees there with the closest party member. You gain 1d6 Fear. The portal remains open until the Priest is defeated or spotlighted again."
        }
      ],
      "role": "Social",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/pain-priest/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/panther",
