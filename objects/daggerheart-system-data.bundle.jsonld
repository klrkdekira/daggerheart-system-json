    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/fallen-warlord-realm-breaker",
      "@type": "Adversary",
      "name": "Fallen Warlord: Realm-Breaker",
      "slug": "fallen-warlord-realm-breaker",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "FALLEN WARLORD: REALM-BREAKER",
        "lineStart": 10623,
        "lineEnd": 10649,
        "pdfPageStart": 149,
        "pdfPageEnd": 149
      },
      "tier": 4,
      "motivesAndTactics": [
        "Corrupt",
        "dominate",
        "punish",
        "break the weak"
      ],
      "difficulty": 20,
      "thresholds": "36/66",
      "hitPoints": 8,
      "stress": 5,
      "attackModifier": "+7",
      "standardAttack": {
        "name": "Barbed Whip",
        "range": "Close",
        "damage": "4d8+7 phy"
      },
      "experience": "Conquest +3, History +2, Intimidation +3",
      "description": "A Fallen God, wreathed in rage and resentment, bearing millennia of experience in breaking heroes’ spirits.",
      "features": [
        {
          "name": "Relentless (2)",
          "kind": "Passive",
          "rulesText": "The Realm-Breaker can be spotlighted up to two times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Firespite Plate Armor",
          "kind": "Passive",
          "rulesText": "When the Realm-Breaker takes damage, reduce it by 2d10."
        },
        {
          "name": "Tormenting Lash",
          "kind": "Action",
          "rulesText": "Mark a Stress to make a standard attack against all targets within Very Close range. When a target uses armor to reduce damage from this attack, they must mark 2 Armor Slots."
        },
        {
          "name": "All-Consuming Rage",
          "kind": "Reaction",
          "rulesText": "Countdown (Decreasing 8). When the Realm-Breaker is in the spotlight for the first time, activate the countdown. When it triggers, create a torrent of incarnate rage that rends flesh from bone. All targets within Far range must make a Presence Reaction Roll. Targets who fail take 2d6+10 direct magic damage. Targets who succeed take half damage. For each HP marked from this damage, summon a Fallen Shock Troop within Very Close range of the target who marked that HP. If the countdown ever decreases its maximum value to 0, the Realm-Breaker marks their remaining HP and all targets within Far range must mark all remaining HP and make a death move."
        },
        {
          "name": "Doombringer",
          "kind": "Reaction",
          "rulesText": "When a target marks HP from an attack by the Realm-Breaker, all PCs within Far range of the target must lose a Hope."
        },
        {
          "name": "I Have Never Known Defeat (Phase Change)",
          "kind": "Reaction",
          "rulesText": "When the Realm-Breaker marks their last HP, replace them with the Undefeated Champion and immediately spotlight them."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/fallen-warlord-realm-breaker/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/fallen-warlord-undefeated-champion",
      "@type": "Adversary",
      "name": "Fallen Warlord: Undefeated Champion",
      "slug": "fallen-warlord-undefeated-champion",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "FALLEN WARLORD: UNDEFEATED CHAMPION",
        "lineStart": 10651,
        "lineEnd": 10679,
        "pdfPageStart": 149,
        "pdfPageEnd": 149
      },
      "tier": 4,
      "motivesAndTactics": [
        "Dispatch merciless death",
        "punish the defiant",
        "secure victory at any cost"
      ],
      "difficulty": 18,
      "thresholds": "35/58",
      "hitPoints": 11,
      "stress": 5,
      "attackModifier": "+8",
      "standardAttack": {
        "name": "Heart-Shattering Sword",
        "range": "Very Close",
        "damage": "4d12+13 phy"
      },
      "experience": "Conquest +3, History +2, Intimidation +3",
      "description": "That which only the most feared have a chance to fear.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Undefeated Champion can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Faltering Armor",
          "kind": "Passive",
          "rulesText": "When the Undefeated Champion takes damage, reduce it by 1d10."
        },
        {
          "name": "Shattering Strike",
          "kind": "Action",
          "rulesText": "Mark a Stress to make a standard attack against all targets within Very Close range. PCs the Champion succeeds against lose a number of Hope equal to the HP they marked from this attack."
        },
        {
          "name": "Endless Legions",
          "kind": "Action",
          "rulesText": "Spend a Fear to summon a number of Fallen Shock Troops equal to twice the number of PCs. The Shock Troops appear at Far range."
        },
        {
          "name": "Circle of Defilement",
          "kind": "Reaction",
          "rulesText": "Countdown (1d8). When the Undefeated Champion is in the spotlight for the first time, activate the countdown. When it triggers, activate a magical circle covering an area within Far range of the Champion. A target within that area is Vulnerable until they leave the circle. The circle can be removed by dealing Severe damage to the Undefeated Champion."
        },
        {
          "name": "Momentum",
          "kind": "Reaction",
          "rulesText": "When the Undefeated Champion makes a successful attack against a PC, you gain a Fear."
        },
        {
          "name": "Doombringer",
          "kind": "Reaction",
          "rulesText": "When a target marks HP from an attack by the Undefeated Champion, all PCs within Far range of the target lose a Hope."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/fallen-warlord-undefeated-champion/"
