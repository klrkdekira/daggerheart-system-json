      "attackModifier": "+5",
      "standardAttack": {
        "name": "Rapier",
        "range": "Melee",
        "damage": "2d20+4 phy"
      },
      "experience": "Aristocrat +3",
      "description": "A captivating undead dressed in aristocratic finery.",
      "features": [
        {
          "name": "Terrifying",
          "kind": "Passive",
          "rulesText": "When the Vampire makes a successful attack, all PCs within Far range lose a Hope and you gain a Fear."
        },
        {
          "name": "Look into My Eyes",
          "kind": "Passive",
          "rulesText": "A creature who moves into Melee range of the Vampire must make an Instinct Reaction Roll. On a failure, you gain 1d4 Fear."
        },
        {
          "name": "Feed on Followers",
          "kind": "Action",
          "rulesText": "When the Vampire is within Melee range of an ally, they can cause the ally to mark a HP. The Vampire then clears a HP."
        },
        {
          "name": "The Hunt Is On",
          "kind": "Action",
          "rulesText": "Spend 2 Fear to summon 1d4 Vampires, who appear at Far range and immediately take the spotlight."
        },
        {
          "name": "Lifesuck",
          "kind": "Reaction",
          "rulesText": "When the Vampire is spotlighted, roll a d8. On a result of 6 or higher, all targets within Very Close range must mark a HP."
        }
      ],
      "role": "Leader",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/head-vampire/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/high-seraph",
      "@type": "Adversary",
      "name": "High Seraph",
      "slug": "high-seraph",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "HIGH SERAPH",
        "lineStart": 10949,
        "lineEnd": 10973,
        "pdfPageStart": 152,
        "pdfPageEnd": 152
      },
      "tier": 4,
      "motivesAndTactics": [
        "Enforce dogma",
        "fly",
        "pronounce judgment",
        "smite"
      ],
      "difficulty": 20,
      "thresholds": "37/70",
      "hitPoints": 7,
      "stress": 5,
      "attackModifier": "+8",
      "standardAttack": {
        "name": "Holy Sword",
        "range": "Very Close",
        "damage": "4d10+10 phy"
      },
      "experience": "Divine Knowledge +3",
      "description": "A divine champion, head of a hallowed host of warriors who enforce their god’s will.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Seraph can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Divine Flight",
          "kind": "Passive",
          "rulesText": "While the Seraph is flying, spend a Fear to move up to Far range instead of Close range before taking an action."
        },
        {
          "name": "Judgment",
          "kind": "Action",
          "rulesText": "Spend a Fear to make a target Guilty in the eyes of the Seraph’s god until the Seraph is defeated. While Guilty, the target doesn’t gain Hope on a result with Hope. When the Seraph succeeds on a standard attack against a Guilty target, they deal Severe damage instead of their standard damage. The Seraph can only mark one target at a time."
        },
        {
          "name": "God Rays",
          "kind": "Action",
          "rulesText": "Mark a Stress to reflect a sliver of divinity as a searing beam of light that hits up to twenty targets within Very Far range. Targets must make a Presence Reaction Roll, with disadvantage if they are marked Guilty. Targets who fail take 4d6+12 magic damage. Targets who succeed take half damage."
        },
        {
          "name": "We Are One",
          "kind": "Action",
          "rulesText": "Once per scene, spend a Fear to spotlight all other adversaries within Far range. Attacks they make while spotlighted in this way deal half damage."
        }
      ],
      "role": "Leader",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/high-seraph/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/hill-titan",
      "@type": "Adversary",
      "name": "Hill Titan",
      "slug": "hill-titan",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "HILL TITAN",
        "lineStart": 8292,
        "lineEnd": 8316,
        "pdfPageStart": 124,
        "pdfPageEnd": 124
      },
      "tier": 2,
      "motivesAndTactics": [
        "Eat",
        "make a mess",
        "patrol stomping grounds"
      ],
      "difficulty": 14,
      "thresholds": "13/26",
      "hitPoints": 10,
      "stress": 5,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Tree Stump",
        "range": "Very Close",
        "damage": "2d10+4 phy"
      },
      "experience": "Survival +3, Vengeful +3",
      "description": "A goliath clad in animal skins and surrounded by a swarm of insects.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Titan can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Momentum",
          "kind": "Passive",
          "rulesText": "When the Titan makes a successful attack against a PC, you gain a Fear."
        },
        {
          "name": "Gullible",
          "kind": "Passive",
          "rulesText": "PCs have advantage on action rolls to trick or emotionally manipulate the Titan."
        },
        {
          "name": "Bug Swarm",
          "kind": "Passive",
          "rulesText": "PCs are Vulnerable while within Very Close range."
        },
        {
          "name": "Mighty Swing",
          "kind": "Action",
          "rulesText": "Spend a Fear to make a standard attack against all targets within Very Close range."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/hill-titan/"
      },
      "source": {
