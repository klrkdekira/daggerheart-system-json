    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/giant-octopus",
      "@type": "Adversary",
      "name": "Giant Octopus",
      "slug": "giant-octopus",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
