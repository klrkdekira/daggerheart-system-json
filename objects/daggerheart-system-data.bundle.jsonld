    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/archer-squadron",
      "@type": "Adversary",
      "name": "Archer Squadron",
      "slug": "archer-squadron",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "ARCHER SQUADRON",
        "lineStart": 7208,
        "lineEnd": 7226,
        "pdfPageStart": 114,
        "pdfPageEnd": 114
      },
      "tier": 2,
      "motivesAndTactics": [
        "Stick together",
        "survive",
        "volley fire"
      ],
      "difficulty": 13,
      "thresholds": "8/16",
      "hitPoints": 4,
      "stress": 3,
      "attackModifier": "+0",
      "standardAttack": {
        "name": "Longbow",
        "range": "Far",
        "damage": "2d6+3 phy"
      },
      "description": "A group of trained archers bearing massive bows.",
      "features": [
        {
          "name": "Horde (1d6+3)",
          "kind": "Passive",
          "rulesText": "When the Squadron has marked half or more of their HP, their standard attack deals 1d6+3 physical damage instead."
        },
        {
          "name": "Focused Volley",
          "kind": "Action",
          "rulesText": "Spend a Fear to target a point within Far range. Make an attack with advantage against all targets within Close range of that point. Targets the Squadron succeeds against take 1d10+4 physical damage."
        },
        {
          "name": "Suppressing Fire",
          "kind": "Action",
          "rulesText": "Mark a Stress to target a point within Far range. Until the next roll with Fear, a creature who moves within Close range of that point must make an Agility Reaction Roll. On a failure, they take 2d6+3 physical damage. On a success, they take half damage."
        }
      ],
      "role": "Horde (2/HP)",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/archer-squadron/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/archmage",
      "@type": "Adversary",
      "name": "Archmage",
      "slug": "archmage",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "ARCHMAGE",
        "lineStart": 9002,
        "lineEnd": 9026,
        "pdfPageStart": 131,
        "pdfPageEnd": 131
      },
      "tier": 3,
      "motivesAndTactics": [
        "Corrupt",
        "destroy",
        "overwhelm with evil power"
      ],
      "difficulty": 18,
      "thresholds": "24/45",
      "hitPoints": 5,
      "stress": 8,
      "attackModifier": "+5",
      "standardAttack": {
        "name": "Archmage’s Greatstaff",
        "range": "Far",
        "damage": "3d10 mag"
      },
      "experience": "Esoterica +4",
      "description": "A seeker of secret knowledge hidden away in a tome-filled tower.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Archmage can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Orbiting Aegis",
          "kind": "Passive",
          "rulesText": "When the Archmage appears, they conjure six discs of magical energy that orbit around them. Place a d6 Aegis Die on this stat block with the 6 value facing up. When a PC makes a successful attack against the Archmage, roll a d6. If the result is equal to or less than the value of the Aegis Die, tick the Aegis Die down and ignore the damage. A PC can make a Knowledge Roll to tick down the Aegis Die by 1 on a success or by 2 on a success with Hope."
        },
        {
          "name": "Force Salvo",
          "kind": "Action",
          "rulesText": "Spend any number of Fear and roll that many d4s. The Archmage unleashes a number of magical homing force bolts equal to the total result. For each bolt, a creature within Far range marks a HP. The same creature can be targeted by up to three force bolts."
        },
        {
          "name": "Fireball",
          "kind": "Action",
          "rulesText": "Mark any number of Stress to target the same number of PCs within Far range. Each target must succeed on an Agility Reaction Roll or take 4d10 magic damage."
        },
        {
          "name": "Counterspell",
          "kind": "Reaction",
          "rulesText": "When a PC succeeds on a Spellcast Roll, you can spend a Fear to have the Archmage make a reaction roll with a Difficulty equal to the Spellcast Roll’s result. On a success, the PC’s Spellcast Roll fails instead, and you place a token on this stat block. Using this feature again costs additional Fear equal to the number of tokens on this stat block. You can’t Counterspell a critical success."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/archmage/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/assassin-poisoner",
      "@type": "Adversary",
      "name": "Assassin Poisoner",
      "slug": "assassin-poisoner",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "ASSASSIN POISONER",
        "lineStart": 7248,
        "lineEnd": 7268,
        "pdfPageStart": 114,
        "pdfPageEnd": 114
      },
      "tier": 2,
      "motivesAndTactics": [
        "Anticipate",
        "get paid",
        "kill",
        "taint food and water"
      ],
      "difficulty": 14,
      "thresholds": "8/16",
      "hitPoints": 4,
      "stress": 4,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Poisoned Throwing Dagger",
        "range": "Close",
        "damage": "2d8+1 phy"
      },
      "experience": "Intrusion +2",
      "description": "A cunning scoundrel skilled in both poisons and ambushing.",
      "features": [
        {
          "name": "Grindletooth Venom",
          "kind": "Passive",
          "rulesText": "Targets who mark HP from the Assassin’s attacks are Vulnerable until they clear a HP."
        },
        {
          "name": "Out of Nowhere",
          "kind": "Passive",
          "rulesText": "The Assassin has advantage on attacks if they are Hidden."
        },
        {
          "name": "Fumigation",
          "kind": "Action",
          "rulesText": "Drop a smoke bomb that fills the air within Close range with smoke, Dizzying all targets in this area. Dizzied targets have disadvantage on their next action roll, then clear the condition."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/assassin-poisoner/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/atototl",
      "@type": "Adversary",
      "name": "Atototl",
      "slug": "atototl",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "ATOTOTL",
        "lineStart": 5400,
        "lineEnd": 5420,
        "pdfPageStart": 97,
        "pdfPageEnd": 97
      },
      "tier": 1,
      "motivesAndTactics": [
        "Avoid",
        "escape",
        "misdirect"
      ],
      "difficulty": 12,
      "thresholds": "8/12",
      "hitPoints": 5,
      "stress": 3,
      "attackModifier": "+1",
      "standardAttack": {
        "name": "Talons",
        "range": "Melee",
        "damage": "1d8+1 phy"
      },
      "experience": "Flight +3, Jungles +3",
      "description": "A majestic green water bird that has a ten-foot wingspan and is hunted for the fortune-telling stone inside their stomach.",
      "features": [
        {
          "name": "Wind Lord",
          "kind": "Passive",
          "rulesText": "While the Atototl is flying, attacks against it is made with disadvantage."
        },
        {
          "name": "Stone of Omens",
          "kind": "Passive",
          "rulesText": "Inside the Atototl is a stone that foretells good or ill fortune, depending on its color. A PC who searches the Atototl’s remains finds the stone and makes a fate roll. On an even result, the PC gains Hope equal to half the result, which they can distribute among the PCs however they wish. On an odd result, you gain Fear equal to half the result."
        },
        {
          "name": "Archer’s Bane",
          "kind": "Reaction",
          "rulesText": "When a creature beyond Very Close range would deal damage to the Atototl with a weapon attack, you can spend a Fear to make an attack roll against them. On a success, whirling winds reflect the attack and deal the attacker’s damage back to them."
        }
      ],
      "role": "Standard",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/atototl/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/banshee",
      "@type": "Adversary",
      "name": "Banshee",
      "slug": "banshee",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "BANSHEE",
        "lineStart": 7294,
        "lineEnd": 7316,
        "pdfPageStart": 114,
        "pdfPageEnd": 114
      },
      "tier": 2,
      "motivesAndTactics": [
        "Ambush from inside solid objects",
        "frighten to death",
        "mourn life and beauty lost",
        "scream balefully"
      ],
      "difficulty": 14,
      "thresholds": "9/18",
      "hitPoints": 5,
      "stress": 3,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Fingernails",
        "range": "Melee",
        "damage": "2d6+1 mag"
      },
      "experience": "Vain +3, Wrathful +3",
      "description": "A corrupted fey spirit that haunts the night in the form of a willowy specter wearing a luminous gossamer gown.",
      "features": [
        {
          "name": "Specter",
          "kind": "Passive",
          "rulesText": "The Banshee has resistance to physical damage. Mark a Stress to move up to Close range through solid objects."
        },
        {
          "name": "Terrifying",
          "kind": "Passive",
          "rulesText": "When the Banshee makes a successful attack, all PCs within Close range lose a Hope, and you gain a Fear."
        },
        {
          "name": "Scare Tactic",
          "kind": "Action",
          "rulesText": "Up to three times per scene, spend a Fear to have the Banshee teleport up to Very Far range and scare a PC within Melee range. The PC marks 1d4 Stress. If this causes them to mark HP, they also lose a Hope."
        },
        {
          "name": "Wail of Despair",
          "kind": "Action",
          "rulesText": "Mark a Stress to have the Banshee unleash a mournful scream of pain and anguish. Each PC within Close range must make a Presence Reaction Roll. Targets who succeed take 1d12+1 magic damage. Targets who fail take double damage and are knocked back to Close range."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/banshee/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/basilisk",
      "@type": "Adversary",
      "name": "Basilisk",
      "slug": "basilisk",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "BASILISK",
        "lineStart": 7320,
        "lineEnd": 7336,
        "pdfPageStart": 115,
        "pdfPageEnd": 115
      },
      "tier": 2,
      "motivesAndTactics": [
        "Move slow and steady",
        "savor petrified prey",
        "turn everyone to stone",
        "watch and wait"
      ],
      "difficulty": 14,
      "thresholds": "8/19",
      "hitPoints": 4,
      "stress": 4,
      "attackModifier": "+1",
      "standardAttack": {
        "name": "Jaws & Claws",
        "range": "Melee",
        "damage": "2d6+4 phy"
      },
      "description": "A six-legged monitor lizard that has the head of a vulture, a spiked backbone, and a petrifying gaze.",
      "features": [
        {
          "name": "Petrify",
          "kind": "Action",
          "rulesText": "Spend a Fear to force a PC within Far range to make an Instinct Reaction Roll. On a success, the target marks a Stress. On a failure, the target becomes Stiff. If the target is already Stiff, they become Petrified. While Stiff, the PC must mark a Stress each time they act until they take a rest or the Basilisk is defeated. While Petrified, the PC can’t act. The Petrified condition can be cleared only by applying Basilisk saliva to the target."
        },
        {
          "name": "CRONCH!",
          "kind": "Action",
          "rulesText": "Mark a Stress to have the Basilisk chomp down on a Petrified PC within Melee range. The target must make a death move."
        }
      ],
      "role": "Standard",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/basilisk/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/battle-box",
      "@type": "Adversary",
      "name": "Battle Box",
      "slug": "battle-box",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "BATTLE BOX",
        "lineStart": 7338,
        "lineEnd": 7367,
        "pdfPageStart": 115,
        "pdfPageEnd": 115
      },
      "tier": 2,
      "motivesAndTactics": [
        "Change tactics",
        "trample foes",
        "wait in disguise"
      ],
      "difficulty": 15,
      "thresholds": "10/20",
      "hitPoints": 8,
      "stress": 6,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Slam",
        "range": "Melee",
        "damage": "2d6+3 phy"
      },
      "experience": "Camouflage +2",
      "description": "A cube-shaped construct with a different rune on each of their six sides.",
      "features": [
        {
          "name": "Relentless (2)",
          "kind": "Passive",
          "rulesText": "The Box can be spotlighted up to two times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Randomized Tactics",
          "kind": "Action",
          "rulesText": "Mark a Stress and roll a d6. The Box uses the corresponding move:\n\n1. Mana Beam. The Box fires a searing beam. Make an attack against a target within Far range. On a success, deal 2d10+2 magic damage.\n2. Fire Jets. The Box shoots into the air, spinning and releasing jets of flame. Make an attack against all targets within Close range. Targets the Box succeeds against take 2d8 physical damage.\n3. Trample. The Box rockets around erratically. Make an attack against all PCs within Close range. Targets the Box succeeds against take 1d6+5 physical damage and are Vulnerable until their next roll with Hope.\n4. Shocking Gas. The Box sprays out a silver gas sparking with lightning. All targets within Close range must succeed on a Finesse Reaction Roll or mark 3 Stress.\n5. Stunning Clap. The Box leaps and their sides clap, creating a small sonic boom. All targets within Very Close range must succeed on a Strength Reaction Roll or become Vulnerable until the cube is defeated.\n6. Psionic Whine. The Box releases a cluster of mechanical bees whose buzz rattles mortal minds. All targets within Close range must succeed on a Presence Reaction Roll or take 2d4+9 direct magic damage."
        },
        {
          "name": "Overcharge",
          "kind": "Reaction",
          "rulesText": "Before rolling damage for the Box’s attack, you can mark a Stress to add a d6 to the damage roll. Additionally, you gain a Fear."
        },
        {
          "name": "Death Quake",
          "kind": "Reaction",
          "rulesText": "When the Box marks their last HP, the magic powering them ruptures in an explosion of force. All targets within Close range must succeed on an Instinct Reaction Roll or take 2d8+1 magic damage."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/battle-box/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
