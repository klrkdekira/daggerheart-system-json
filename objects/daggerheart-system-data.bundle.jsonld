    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/juvenile-flickerfly",
      "@type": "Adversary",
      "name": "Juvenile Flickerfly",
      "slug": "juvenile-flickerfly",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "JUVENILE FLICKERFLY",
        "lineStart": 8360,
        "lineEnd": 8380,
        "pdfPageStart": 125,
        "pdfPageEnd": 125
      },
      "tier": 2,
      "motivesAndTactics": [
        "Collect shiny things",
        "hunt",
        "swoop"
      ],
      "difficulty": 14,
      "thresholds": "13/26",
      "hitPoints": 10,
      "stress": 5,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Wing Slash",
        "range": "Very Close",
        "damage": "2d10+4 phy"
      },
      "description": "A horse-sized insect with iridescent scales and crystalline wings moving faster than the eye can see.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Flickerfly can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Peerless Accuracy",
          "kind": "Passive",
          "rulesText": "Before the Flickerfly makes an attack, roll a d6. On a result of 4 or higher, the target’s Evasion is halved against this attack."
        },
        {
          "name": "Mind Dance",
          "kind": "Action",
          "rulesText": "Mark a Stress to create a magically dazzling display that grapples the minds of nearby foes. All targets within Close range must make an Instinct Reaction Roll. For each target who failed, you gain a Fear and the Flickerfly learns one of the target’s fears."
        },
        {
          "name": "Hallucinatory Breath",
          "kind": "Reaction",
          "rulesText": "Countdown (Loop 1d6). When the Flickerfly takes damage for the first time, activate the countdown. When it triggers, the Flickerfly breathes hallucinatory gas on all targets in front of them up to Far range. Targets must succeed on an Instinct Reaction Roll or be tormented by fearful hallucinations. Targets whose fears are known to the Flickerfly have disadvantage on this roll. Targets who fail must mark a Stress and lose a Hope."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/juvenile-flickerfly/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/kelpie",
      "@type": "Adversary",
      "name": "Kelpie",
      "slug": "kelpie",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "KELPIE",
        "lineStart": 6082,
        "lineEnd": 6104,
        "pdfPageStart": 103,
        "pdfPageEnd": 103
      },
      "tier": 1,
      "motivesAndTactics": [
        "Adopt an attractive or useful shape",
        "drown and devour",
        "entice unwary travelers"
      ],
      "difficulty": 12,
      "thresholds": "4/8",
      "hitPoints": 3,
      "stress": 5,
      "attackModifier": "−2",
      "standardAttack": {
        "name": "Hooves",
        "range": "Very Close",
        "damage": "1d8+2 phy"
      },
      "experience": "Entanglement +3, Mind Reader +3",
      "description": "A river-dwelling shapeshifter who prefers an enchanting equine form in and out of the water.",
      "features": [
        {
          "name": "Captivating",
          "kind": "Passive",
          "rulesText": "A PC must mark a Stress to move out of the Kelpie’s Melee range."
        },
        {
          "name": "Heart’s Desire",
          "kind": "Passive",
          "rulesText": "After the Kelpie interacts with or watches a creature for at least a hundred heartbeats, the Kelpie knows the physical form that creature would find most pleasing or alluring."
        },
        {
          "name": "Shapeshifter",
          "kind": "Action",
          "rulesText": "Mark a Stress to change the Kelpie’s physical form into any creature or object smaller than a wagon. A creature has disadvantage on rolls against the Kelpie while the Kelpie is in a form the creature finds pleasing or alluring."
        },
        {
          "name": "Enchant",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Kelpie beguile a PC within Close range. The PC must succeed on an Instinct Reaction Roll or become Enchanted until they take damage. While Enchanted, the PC perceives the Kelpie as a trusted friend or ally and will do what the Kelpie says unless it contradicts the PC’s most deeply held morals."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/kelpie/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/knight-of-the-realm",
      "@type": "Adversary",
      "name": "Knight of the Realm",
      "slug": "knight-of-the-realm",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "KNIGHT OF THE REALM",
        "lineStart": 8382,
        "lineEnd": 8404,
        "pdfPageStart": 125,
        "pdfPageEnd": 125
      },
      "tier": 2,
      "motivesAndTactics": [
        "Run down",
        "seek glory",
        "show dominance"
      ],
      "difficulty": 15,
      "thresholds": "13/26",
      "hitPoints": 6,
      "stress": 4,
      "attackModifier": "+4",
      "standardAttack": {
        "name": "Longsword",
        "range": "Melee",
        "damage": "2d10+4 phy"
      },
      "experience": "Ancient Knowledge +3, High Society +2, Tactics +2",
      "description": "A decorated soldier with heavy armor and a powerful steed.",
      "features": [
        {
          "name": "Chevalier",
          "kind": "Passive",
          "rulesText": "While the Knight is on a mount, they gain a +2 bonus to their Difficulty. When they take Severe damage, they’re knocked from their mount and lose this benefit until they’re next spotlighted."
        },
        {
          "name": "Heavily Armored",
          "kind": "Passive",
          "rulesText": "When the Knight takes physical damage, reduce it by 3."
        },
        {
          "name": "Cavalry Charge",
          "kind": "Action",
          "rulesText": "If the Knight is mounted, move up to Far range and make a standard attack against a target. On a success, deal 2d8+4 physical damage and the target must mark a Stress."
        },
        {
          "name": "For the Realm!",
          "kind": "Action",
          "rulesText": "Mark a Stress to spotlight 1d4+1 allies. Attacks they make while spotlighted in this way deal half damage."
        }
      ],
      "role": "Leader",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/knight-of-the-realm/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/kraken",
      "@type": "Adversary",
      "name": "Kraken",
      "slug": "kraken",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "KRAKEN",
        "lineStart": 10977,
        "lineEnd": 11001,
        "pdfPageStart": 153,
        "pdfPageEnd": 153
      },
      "tier": 4,
      "motivesAndTactics": [
        "Consume",
        "crush",
        "drown",
        "grapple"
      ],
      "difficulty": 20,
      "thresholds": "35/70",
      "hitPoints": 11,
      "stress": 8,
      "attackModifier": "+7",
      "standardAttack": {
        "name": "Tentacles",
        "range": "Close",
        "damage": "4d12+10 phy"
      },
      "experience": "Swimming +3",
      "description": "A legendary beast of the sea, bigger than the largest galleon, with sucker-laden tentacles and a terrifying maw.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Kraken can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Many Tentacles",
          "kind": "Passive",
          "rulesText": "While the Kraken has 7 or fewer marked HP, they can make their standard attack against two targets within range."
        },
        {
          "name": "Grapple and Drown",
          "kind": "Action",
          "rulesText": "Make an attack roll against a target within Close range. On a success, mark a Stress to grab them with a tentacle and drag them beneath the water. The target is Restrained and Vulnerable until they break free with a successful Strength Roll or the Kraken takes Major or greater damage. While Restrained and Vulnerable in this way, a target must mark a Stress when they make an action roll."
        },
        {
          "name": "Boiling Blast",
          "kind": "Action",
          "rulesText": "Spend a Fear to spew a line of boiling water at any number of targets in a line up to Far range. All targets must succeed on an Agility Reaction Roll or take 4d6+9 physical damage. If a target marks an Armor Slot to reduce the damage, they must also mark a Stress."
        },
        {
          "name": "Momentum",
          "kind": "Reaction",
          "rulesText": "When the Kraken makes a successful attack against a PC, you gain a Fear."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/kraken/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/lamia",
      "@type": "Adversary",
      "name": "Lamia",
      "slug": "lamia",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "LAMIA",
        "lineStart": 9608,
        "lineEnd": 9628,
        "pdfPageStart": 137,
        "pdfPageEnd": 137
      },
      "tier": 3,
      "motivesAndTactics": [
        "Attack the unaware",
        "avoid sunlight",
        "leech life force",
        "put to sleep",
        "slither through tall grass"
      ],
      "difficulty": 17,
      "thresholds": "18/35",
      "hitPoints": 6,
      "stress": 5,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Curved Dagger",
        "range": "Melee",
        "damage": "3d8+4 phy"
      },
      "experience": "Snaky +3",
      "description": "A snake-tailed humanoid monster who stalks the night to absorb the life energy of sleeping people.",
      "features": [
        {
          "name": "Constriction",
          "kind": "Action",
          "rulesText": "Mark a Stress to have the Lamia wrap their tail around a PC within Melee range and squeeze. The target must succeed on a Finesse Reaction Roll or become Constricted until the Lamia moves or takes Major or greater damage. While Constricted, the target is Restrained and must mark a Stress when the Lamia takes the spotlight."
        },
        {
          "name": "Life Leech",
          "kind": "Action",
          "rulesText": "Mark a Stress to force a Vulnerable or Restrained target within Melee range to mark 1d4−1 HP. The Lamia then clears an equal number of HP."
        },
        {
          "name": "Sleep Toxin",
          "kind": "Reaction",
          "rulesText": "When the Lamia makes a successful standard attack against a PC, you can spend a Fear to make them Vulnerable until they succeed on a Instinct Roll (19)."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/lamia/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/lamplight-beguiler",
      "@type": "Adversary",
      "name": "Lamplight Beguiler",
      "slug": "lamplight-beguiler",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "LAMPLIGHT BEGUILER",
        "lineStart": 9630,
        "lineEnd": 9650,
        "pdfPageStart": 137,
        "pdfPageEnd": 137
      },
      "tier": 3,
      "motivesAndTactics": [
        "Entice with secret knowledge",
        "snap the trap shut",
        "speak through a shapeshifted head stalk"
      ],
      "difficulty": 16,
      "thresholds": "16/32",
      "hitPoints": 6,
      "stress": 5,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Jaws",
        "range": "Melee",
        "damage": "3d8+2 phy"
      },
      "experience": "Charm +3, Secrets +3",
      "description": "A huge aquatic creature that lures unwary prey into eating range with its dangling, shapeshifting head stalk.",
      "features": [
        {
          "name": "Doppel-Dangler",
          "kind": "Action",
          "rulesText": "The membranous cluster at the end of the Beguiler’s head stalk can shapeshift into any humanoid form. Mark a Stress to choose a PC within Close range. Their player must tell you who their PC would find most trustworthy. The Beguiler’s head stalk transforms into that person and gains the ability to speak in their voice."
        },
        {
          "name": "Entice",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Beguiler make an alluring overture to a PC within Close range. The PC must succeed on a Presence Reaction Roll (18) or move into Melee range with the Beguiler. If the Beguiler’s head stalk is transformed into a person the PC would find trustworthy, they have disadvantage on the reaction roll."
        },
        {
          "name": "Gulp",
          "kind": "Reaction",
          "rulesText": "When a PC moves within Melee range, you can spend a Fear to make an attack roll against them. On a successful attack, the target takes 3d6 physical damage and is Swallowed. While Swallowed, the target is Restrained and takes 3d6 physical damage when the Beguiler takes the spotlight. The Beguiler disgorges all Swallowed creatures when it takes Major or Severe damage."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/lamplight-beguiler/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/landshark",
      "@type": "Adversary",
      "name": "Landshark",
      "slug": "landshark",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "LANDSHARK",
        "lineStart": 8406,
        "lineEnd": 8426,
        "pdfPageStart": 125,
        "pdfPageEnd": 125
      },
      "tier": 2,
      "motivesAndTactics": [
        "Burrow",
        "burst out of the ground",
        "circle prey"
      ],
      "difficulty": 14,
      "thresholds": "14/25",
      "hitPoints": 7,
      "stress": 3,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Toothy Maw",
        "range": "Very Close",
        "damage": "2d10+2 phy"
      },
      "experience": "Subterranean +3, Bloodthirsty +2",
      "description": "A quadrupedal shark that swims through the ground.",
      "features": [
        {
          "name": "Burrowing",
          "kind": "Passive",
          "rulesText": "The Landshark can move through the ground as easily as over it. When the Landshark moves, it can choose to burrow or surface. While underground, the Landshark has resistance to all damage but can’t attack."
        },
        {
          "name": "Thick-Skinned",
          "kind": "Passive",
          "rulesText": "When the Landshark would be forced to mark any number of HP, you can mark an equal number of Stress instead."
        },
        {
          "name": "Rending Chomp",
          "kind": "Reaction",
          "rulesText": "When the Landshark makes a successful attack against a PC within Melee range, you can spend a Fear to force the target to mark an Armor Slot without receiving its benefits (they can still use armor to reduce the damage)."
        }
      ],
      "role": "Bruiser",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/landshark/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/landshark-behemoth",
      "@type": "Adversary",
      "name": "Landshark Behemoth",
      "slug": "landshark-behemoth",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "LANDSHARK BEHEMOTH",
        "lineStart": 8428,
        "lineEnd": 8450,
        "pdfPageStart": 125,
        "pdfPageEnd": 125
      },
      "tier": 2,
      "motivesAndTactics": [
        "Bite",
        "burrow",
        "burst out of the ground"
      ],
      "difficulty": 15,
      "thresholds": "15/28",
      "hitPoints": 10,
      "stress": 4,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Toothy Maw",
        "range": "Very Close",
        "damage": "2d12+6 phy"
      },
      "experience": "Subterranean +4, Bloodthirsty +3",
      "description": "A landshark that’s lived long enough to become a large burrowing monstrosity with steely hide and razor-sharp teeth.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Behemoth can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight it."
        },
        {
          "name": "Deep Diver",
          "kind": "Passive",
          "rulesText": "The Behemoth can move through the ground as easily as over it. When the Behemoth moves, it can choose to burrow or surface. While underground, the Behemoth is immune to damage but can’t attack."
        },
        {
          "name": "Steel-Skinned",
          "kind": "Passive",
          "rulesText": "All damage dealt to the Behemoth is reduced by one threshold."
        },
        {
          "name": "Forceful Eruption",
          "kind": "Action",
          "rulesText": "The Behemoth erupts from the ground, forcing each PC within Very Close range to succeed on an Agility Reaction Roll or be knocked over, becoming Vulnerable until they make an action roll. For each PC made Vulnerable in this way, you gain a Fear."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/landshark-behemoth/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
