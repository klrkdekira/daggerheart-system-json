      "stress": 3,
      "attackModifier": "+1",
      "standardAttack": {
        "name": "Pincers",
        "range": "Melee",
        "damage": "1d12+2 phy"
      },
      "experience": "Camouflage +2",
      "description": "A human-sized arachnid with tearing claws and a stinging tail.",
      "features": [
        {
          "name": "Double Strike",
          "kind": "Action",
          "rulesText": "Mark a Stress to make a standard attack against two targets within Melee range."
        },
        {
          "name": "Venomous Stinger",
          "kind": "Action",
          "rulesText": "Make an attack against a target within Very Close range. On a success, spend a Fear to deal 1d4+4 physical damage and Poison them until their next rest or they succeed on a Knowledge Roll (16). While Poisoned, the target must roll a d6 before they make an action roll. On a result of 4 or lower, they must mark a Stress."
        },
        {
          "name": "Momentum",
          "kind": "Reaction",
          "rulesText": "When the Scorpion makes a successful attack against a PC, you gain a Fear."
        }
      ],
