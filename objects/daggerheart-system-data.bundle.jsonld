    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/harbinger-of-death",
      "@type": "Adversary",
      "name": "Harbinger of Death",
      "slug": "harbinger-of-death",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "HARBINGER OF DEATH",
        "lineStart": 10839,
        "lineEnd": 10865,
        "pdfPageStart": 151,
        "pdfPageEnd": 151
      },
      "tier": 4,
      "motivesAndTactics": [
        "Bring judgment",
        "cut them down",
        "move swiftly",
        "seek relentlessly",
        "take souls"
      ],
      "difficulty": 18,
      "thresholds": "28/52",
      "hitPoints": 6,
      "stress": 6,
      "attackModifier": "+8",
      "standardAttack": {
        "name": "Great Scythe",
        "range": "Close",
        "damage": "4d10+10 phy"
      },
      "experience": "Judgment +3",
      "description": "A desiccated corpse riding atop a skeletal horse. Their eyes are sewn shut and their body is wrapped in a burial shroud of dust and ash.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Harbinger can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Mount",
          "kind": "Passive",
          "rulesText": "While the Harbinger is on their mount, they gain a +2 bonus to their Difficulty. When the Harbinger takes Severe damage, they’re knocked from their mount. If the Harbinger is unhorsed, their mount disappears until you mark a Stress to summon it again."
        },
        {
          "name": "Fear the Reaper",
          "kind": "Passive",
          "rulesText": "When a creature is defeated within Far range of the Harbinger, you gain a Fear."
        },
        {
          "name": "Decapitate",
          "kind": "Action",
          "rulesText": "Spend 2 Fear to have the Harbinger make an attack roll against a PC within Melee range. On a success, roll a d6. On a result of 6, the target marks all HP and must make a death move."
        },
        {
          "name": "Wake the Fallen",
          "kind": "Action",
          "rulesText": "Spend a Fear and mark any number of Stress to have the Harbinger resurrect a defeated ally within Far range. The resurrected ally clears a number of HP equal to the number of Stress marked. Immediately spotlight the ally."
        },
        {
          "name": "Ashes to Ashes, Dust to Dust",
          "kind": "Reaction",
          "rulesText": "When the Harbinger would mark HP, you can mark a Stress to have an ally within Far range mark the HP instead."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/harbinger-of-death/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/harbinger-of-famine",
      "@type": "Adversary",
      "name": "Harbinger of Famine",
      "slug": "harbinger-of-famine",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "HARBINGER OF FAMINE",
        "lineStart": 10867,
        "lineEnd": 10893,
        "pdfPageStart": 151,
        "pdfPageEnd": 151
      },
      "tier": 4,
      "motivesAndTactics": [
        "Drain",
        "impoverish",
        "weaken",
        "wither"
      ],
      "difficulty": 18,
      "thresholds": "26/42",
      "hitPoints": 6,
      "stress": 5,
      "attackModifier": "+4",
      "standardAttack": {
        "name": "Barbed Lash",
        "range": "Close",
        "damage": "4d8+10 phy"
      },
      "experience": "Hunger +2, Thirst +2",
      "description": "A dried-out husk of a body riding atop a withered white horse. They are covered in mouths and surrounded by swarming flies.",
      "features": [
        {
          "name": "Relentless (2)",
          "kind": "Passive",
          "rulesText": "The Harbinger can be spotlighted up to two times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Mount",
          "kind": "Passive",
          "rulesText": "While the Harbinger is on their mount, they gain a +2 bonus to their Difficulty. When the Harbinger takes Severe damage, they’re knocked from their mount. If the Harbinger is unhorsed, their mount disappears until you mark a Stress to summon it again."
        },
        {
          "name": "Hunger Pangs",
          "kind": "Passive",
          "rulesText": "Countdown (Decreasing 6). When the Harbinger appears, activate the countdown. It ticks down when the Harbinger is spotlighted. When it triggers, all PCs within Far range mark a Stress and become Ravenous. While Ravenous, a PC can’t spend Hope until they clear the condition with a successful Instinct Roll."
        },
        {
          "name": "Drain Essence",
          "kind": "Action",
          "rulesText": "Spend a Fear to choose up to three PCs. Each target takes 4d6 magic damage."
        },
        {
          "name": "Too Many Mouths",
          "kind": "Action",
          "rulesText": "Mark a Stress to attack a PC within Melee range. On a success, the Harbinger grabs the target and bites them, dealing 4d6 physical damage and Restraining the target until they break free with a successful Strength Roll."
        },
        {
          "name": "Withering Touch",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Harbinger caress the face of a Restrained PC within Melee range. The target marks 2 Stress and either loses a Hope or marks 1d4 HP."
        }
      ],
      "role": "Support",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/harbinger-of-famine/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/harbinger-of-pestilence",
      "@type": "Adversary",
      "name": "Harbinger of Pestilence",
      "slug": "harbinger-of-pestilence",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "HARBINGER OF PESTILENCE",
        "lineStart": 10897,
        "lineEnd": 10921,
        "pdfPageStart": 152,
        "pdfPageEnd": 152
      },
      "tier": 4,
      "motivesAndTactics": [
        "Corrupt the pure",
        "infect the weak",
        "summon plague and disease"
      ],
      "difficulty": 18,
      "thresholds": "37/70",
      "hitPoints": 7,
      "stress": 8,
      "attackModifier": "+8",
      "standardAttack": {
        "name": "Touch of Corruption",
        "range": "Melee",
        "damage": "4d10+10 mag"
      },
      "experience": "Rot +3",
      "description": "A bloated and rotting agglomeration of wriggling insects and slugs formed into a single humanoid mass riding a worm-eaten horse.",
      "features": [
        {
          "name": "Halo of Contagion",
          "kind": "Passive",
          "rulesText": "The Harbinger is Contagious. When a PC within Very Close range of a Contagious creature takes an action, the PC rolls a d6. On a result of 1, the PC becomes Contagious. While Contagious, a PC has disadvantage on action rolls until they spend 3 Hope to clear the condition. Contagious adversaries are unaffected by the condition."
        },
        {
          "name": "Mount",
          "kind": "Passive",
          "rulesText": "While the Harbinger is on their mount, they gain a +2 bonus to their Difficulty. When the Harbinger takes Severe damage, they’re knocked from their mount. If the Harbinger is unhorsed, their mount disappears until you mark a Stress to summon it again."
        },
        {
          "name": "Locust Swarm",
          "kind": "Action",
          "rulesText": "Spend 2 Fear to have the Harbinger conjure a swarm of locusts at a point within Very Far range. Each PC within Close range of that point must either mark an Armor Slot or take 4d10 direct physical damage and roll a d6. On a result of 1–2, the PC becomes Contagious."
        },
        {
          "name": "Frog Spawn",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Harbinger conjure a clutch of diseased frogs inside the mouths of up to three PCs within Close range. Each PC must succeed on a Presence Reaction Roll or take 4d12 magic damage and roll a d6. On a result of 1–3, the PC becomes Contagious."
        },
        {
          "name": "Plague Bringer",
          "kind": "Action",
          "rulesText": "Mark any number of Stress up to the number of PCs in the scene. For each Stress you mark, the Harbinger summons 1d4 Contagious Zombie Legions within Far range and immediately spotlights one of them."
        }
      ],
      "role": "Leader",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/harbinger-of-pestilence/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
