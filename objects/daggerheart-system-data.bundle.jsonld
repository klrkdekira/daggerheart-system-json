        "lineEnd": 6334,
        "pdfPageStart": 105,
        "pdfPageEnd": 105
      },
      "tier": 1,
      "motivesAndTactics": [
        "Camouflage",
        "consume and multiply",
        "creep up",
        "envelop"
      ],
      "difficulty": 8,
      "thresholds": "5/10",
      "hitPoints": 5,
      "stress": 2,
      "attackModifier": "+1",
      "standardAttack": {
        "name": "Ooze Appendage",
        "range": "Melee",
        "damage": "1d6+1 mag"
      },
      "experience": "Camouflage +3",
      "description": "A moving mound of translucent green slime.",
      "features": [
        {
          "name": "Slow",
          "kind": "Passive",
          "rulesText": "When you spotlight the Ooze and they don’t have a token on their stat block, they can’t act yet. Place a token on their stat block and describe what they’re preparing to do. When you spotlight the Ooze and they have a token on their stat block, clear the token and they can act."
        },
        {
          "name": "Acidic Form",
          "kind": "Passive",
          "rulesText": "When the Ooze makes a successful attack, the target must mark an Armor Slot without receiving its benefits (they can still use armor to reduce the damage). If they can’t mark an Armor Slot, they must mark an additional HP."
        },
        {
          "name": "Envelop",
          "kind": "Action",
          "rulesText": "Make a standard attack against a target within Melee range. On a success, the Ooze envelops them and the target must mark 2 Stress. The target must mark an additional Stress when they make an action roll. If the Ooze takes Severe damage, the target is freed."
        },
        {
          "name": "Split",
          "kind": "Reaction",
          "rulesText": "When the Ooze has 3 or more HP marked, you can spend a Fear to split them into two Tiny Green Oozes (with no marked HP or Stress). Immediately spotlight both of them."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/green-ooze/"
      },
      "source": {
