    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/acid-burrower",
      "@type": "Adversary",
      "name": "Acid Burrower",
      "slug": "acid-burrower",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "ACID BURROWER",
        "lineStart": 5354,
        "lineEnd": 5376,
        "pdfPageStart": 97,
        "pdfPageEnd": 97
      },
      "tier": 1,
      "motivesAndTactics": [
        "Burrow",
        "drag away",
        "feed",
        "reposition"
      ],
      "difficulty": 14,
      "thresholds": "8/15",
      "hitPoints": 8,
      "stress": 3,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Claws",
        "range": "Very Close",
        "damage": "1d12+2 phy"
      },
      "experience": "Tremor Sense +2",
      "description": "A horse-sized insect with digging claws and acidic blood.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Burrower can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Earth Eruption",
          "kind": "Action",
          "rulesText": "Mark a Stress to have the Burrower burst out of the ground. All creatures within Very Close range must succeed on an Agility Reaction Roll or be knocked over, making them Vulnerable until they next act."
        },
        {
          "name": "Spit Acid",
          "kind": "Action",
          "rulesText": "Make an attack against all targets in front of the Burrower within Close range. Targets the Burrower succeeds against take 2d6 physical damage and must mark an Armor Slot without receiving its benefits (they can still use armor to reduce the damage). If they can’t mark an Armor Slot, they must mark an additional HP and you gain a Fear."
        },
        {
          "name": "Acid Bath",
          "kind": "Reaction",
          "rulesText": "When the Burrower takes Severe damage, all creatures within Close range are bathed in their acidic blood, taking 1d10 physical damage. This splash covers the ground within Very Close range with blood, and all creatures other than the Burrower who move through it take 1d6 physical damage."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/acid-burrower/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/adult-flickerfly",
      "@type": "Adversary",
      "name": "Adult Flickerfly",
      "slug": "adult-flickerfly",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "ADULT FLICKERFLY",
        "lineStart": 8974,
        "lineEnd": 9000,
        "pdfPageStart": 131,
        "pdfPageEnd": 131
      },
      "tier": 3,
      "motivesAndTactics": [
        "Collect shiny things",
        "hunt",
        "nest",
        "swoop"
      ],
      "difficulty": 17,
      "thresholds": "20/35",
      "hitPoints": 12,
      "stress": 6,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Wing Slash",
        "range": "Very Close",
        "damage": "3d20 phy"
      },
      "description": "A winged insect the size of a large house with iridescent scales and wings that move too fast to track.",
      "features": [
        {
          "name": "Relentless (4)",
          "kind": "Passive",
          "rulesText": "The Flickerfly can be spotlighted up to four times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Never Misses",
          "kind": "Passive",
          "rulesText": "When the Flickerfly makes an attack, the target’s Evasion is halved against the attack."
        },
        {
          "name": "Deadly Flight",
          "kind": "Passive",
          "rulesText": "While flying, the Flickerfly can move up to Far range instead of Close range before taking an action."
        },
        {
          "name": "Whirlwind",
          "kind": "Action",
          "rulesText": "Spend a Fear to whirl, making an attack against all targets within Very Close range. Targets the Flickerfly succeeds against take 3d8 direct physical damage."
        },
        {
          "name": "Mind Dance",
          "kind": "Action",
          "rulesText": "Mark a Stress to create a magically dazzling display that grapples the minds of nearby foes. All targets within Close range must make an Instinct Reaction Roll. For each target who failed, you gain a Fear and the Flickerfly learns one of the target’s fears."
        },
        {
          "name": "Hallucinatory Breath",
          "kind": "Reaction",
          "rulesText": "Countdown (Loop 1d6). When the Flickerfly takes damage for the first time, activate the countdown. When it triggers, the Flickerfly breathes hallucinatory gas on all targets in front of them up to Far range. Targets must make an Instinct Reaction Roll or be tormented by fearful hallucinations. Targets whose fears are known to the Flickerfly have disadvantage on this roll. Targets who fail lose 2 Hope and take 3d8+3 direct magic damage."
        },
        {
          "name": "Uncanny Reflexes",
          "kind": "Reaction",
          "rulesText": "When the Flickerfly takes damage from an attack within Close range, you can mark a Stress to take half damage."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/adult-flickerfly/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/ahuizotl",
      "@type": "Adversary",
      "name": "Ahuizotl",
      "slug": "ahuizotl",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "AHUIZOTL",
        "lineStart": 5378,
        "lineEnd": 5398,
        "pdfPageStart": 97,
        "pdfPageEnd": 97
      },
      "tier": 1,
      "motivesAndTactics": [
        "Ambush",
        "drown",
        "restrain"
      ],
      "difficulty": 12,
      "thresholds": "5/9",
      "hitPoints": 4,
      "stress": 3,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Bite",
        "range": "Melee",
        "damage": "1d6+2 phy"
      },
      "experience": "Stealth +2, Swimming +2",
      "description": "A doglike ambush predator that has a clawed hand on the end of a long prehensile tail and drags victims into rivers to drown them.",
      "features": [
        {
          "name": "Aquatic Attacker",
          "kind": "Passive",
          "rulesText": "When the Ahuizotl attacks from the water, it has advantage on the attack and deals an extra 1d6 damage."
        },
        {
          "name": "Tail Swat",
          "kind": "Action",
          "rulesText": "Mark a Stress to make an attack against a target within Very Close range. On a success, deal 1d8+2 physical damage."
        },
        {
          "name": "Drag and Bag",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Ahuizotl grab a target within Close range with its tail, pull the target into Melee range, and temporarily Restrain them. The Ahuizotl has advantage on attacks against targets Restrained in this way."
        }
      ],
      "role": "Skulk",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/ahuizotl/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/apprentice-assassin",
      "@type": "Adversary",
      "name": "Apprentice Assassin",
      "slug": "apprentice-assassin",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "APPRENTICE ASSASSIN",
        "lineStart": 7228,
        "lineEnd": 7246,
        "pdfPageStart": 114,
        "pdfPageEnd": 114
      },
      "tier": 2,
      "motivesAndTactics": [
        "Act reckless",
        "kill",
        "prove their worth",
        "show off"
      ],
      "difficulty": 13,
      "thresholds": "None",
      "hitPoints": 1,
      "stress": 1,
      "attackModifier": "−1",
      "standardAttack": {
        "name": "Thrown Dagger",
        "range": "Very Close",
        "damage": "4 phy"
      },
      "experience": "Intrusion +2",
      "description": "A young trainee eager to prove themselves.",
      "features": [
        {
          "name": "Minion (6)",
          "kind": "Passive",
          "rulesText": "The Assassin is defeated when they take any damage. For every 6 damage a PC deals to the Assassin, defeat an additional Minion within range the attack would succeed against."
        },
        {
          "name": "Group Attack",
          "kind": "Action",
          "rulesText": "Spend a Fear to choose a target and spotlight all Apprentice Assassins within Close range of them. Those Minions move into Melee range of the target and make one shared attack roll. On a success, they deal 4 physical damage each. Combine this damage."
        }
      ],
      "role": "Minion",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/apprentice-assassin/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/arch-necromancer",
      "@type": "Adversary",
      "name": "Arch-Necromancer",
      "slug": "arch-necromancer",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "ARCH-NECROMANCER",
        "lineStart": 10308,
        "lineEnd": 10332,
        "pdfPageStart": 145,
        "pdfPageEnd": 145
      },
      "tier": 4,
      "motivesAndTactics": [
        "Corrupt",
        "decay",
        "flee to fight another day",
        "resurrect"
      ],
      "difficulty": 21,
      "thresholds": "33/66",
      "hitPoints": 9,
      "stress": 8,
      "attackModifier": "+6",
      "standardAttack": {
        "name": "Necrotic Blast",
        "range": "Far",
        "damage": "4d12+8 mag"
      },
      "experience": "Forbidden Knowledge +3, Wisdom of Centuries +3",
      "description": "A decaying mage adorned in dark, tattered robes.",
      "features": [
        {
          "name": "Dance of Death",
          "kind": "Action",
          "rulesText": "Mark a Stress to spotlight 1d4 allies. Attacks they make while spotlighted in this way deal half damage, or full damage if you spend a Fear."
        },
        {
          "name": "Beam of Decay",
          "kind": "Action",
          "rulesText": "Mark 2 Stress to cause all targets within Far range to make a Strength Reaction Roll. Targets who fail take 2d20+12 magic damage and you gain a Fear. Targets who succeed take half damage. A target who marks 2 or more HP must also mark 2 Stress and becomes Vulnerable until they roll with Hope."
        },
        {
          "name": "Open the Gates of Death",
          "kind": "Action",
          "rulesText": "Spend a Fear to summon a Zombie Legion, which appears at Close range and immediately takes the spotlight."
        },
        {
          "name": "Not Today, My Dears",
          "kind": "Reaction",
          "rulesText": "When the Necromancer has marked 7 or more of their HP, you can spend a Fear to have them teleport away to a safe location to recover. A PC who succeeds on an Instinct Roll can trace the teleportation magic to their destination."
        },
        {
          "name": "Your Life Is Mine",
          "kind": "Reaction",
          "rulesText": "Countdown (Loop 2d6). When the Necromancer has marked 6 or more of their HP, activate the countdown. When it triggers, deal 2d10+6 direct magic damage to a target within Close range. The Necromancer then clears a number of Stress or HP equal to the number of HP marked by the target from this attack."
        }
      ],
      "role": "Leader",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/arch-necromancer/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
