    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/chimera",
      "@type": "Adversary",
      "name": "Chimera",
      "slug": "chimera",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CHIMERA",
        "lineStart": 9052,
        "lineEnd": 9074,
        "pdfPageStart": 132,
        "pdfPageEnd": 132
      },
      "tier": 3,
      "motivesAndTactics": [
        "Play with food",
        "prowl territory",
        "slay cattle"
      ],
      "difficulty": 17,
      "thresholds": "22/40",
      "hitPoints": 9,
      "stress": 5,
      "attackModifier": "+5",
      "standardAttack": {
        "name": "Claws",
        "range": "Melee",
        "damage": "3d12 phy"
      },
      "experience": "Predator +3",
      "description": "A giant fire-breathing monster that has a lion’s head, a goat’s body, and a serpent’s tail.",
      "features": [
        {
          "name": "Rending Jaws",
          "kind": "Passive",
          "rulesText": "When the Chimera makes a successful attack against a PC, the target must mark 2 Armor Slots to reduce the severity by one threshold."
        },
        {
          "name": "Double Claw",
          "kind": "Action",
          "rulesText": "Mark a Stress to make two standard attacks. If both attacks succeed against the same target, combine the damage."
        },
        {
          "name": "Breath of Fire",
          "kind": "Action",
          "rulesText": "Spend a Fear to target up to three PCs in front of the Chimera within Close range. Each target must make an Agility Reaction Roll (20). Targets who fail take 3d12 magic damage. Targets who succeed must choose to mark either an Armor Slot or a Stress."
        },
        {
          "name": "Serpent Strike",
          "kind": "Reaction",
          "rulesText": "When a PC within Close range targets the Chimera with an attack, you can mark a Stress to attack the PC first. On a success, deal 4d4+10 physical damage and Poison them until their next rest or they succeed on a Knowledge Roll (20). While Poisoned, the target must roll a d6 before they make an action roll. On a result of 3 or lower, they must mark a Stress."
        }
      ],
      "role": "Bruiser",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/chimera/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/cipactli",
      "@type": "Adversary",
      "name": "Cipactli",
      "slug": "cipactli",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CIPACTLI",
        "lineStart": 10456,
        "lineEnd": 10482,
        "pdfPageStart": 146,
        "pdfPageEnd": 146
      },
      "tier": 4,
      "motivesAndTactics": [
        "Consume",
        "reshape the land",
        "trample"
      ],
      "difficulty": 20,
      "thresholds": "35/60",
      "hitPoints": 8,
      "stress": 5,
      "attackModifier": "+8",
      "standardAttack": {
        "name": "Bite",
        "range": "Close",
        "damage": "4d8+12 phy"
      },
      "experience": "Hungry +3, Primordial +3",
      "description": "A gargantuan crocodile that has a body covered in a patchwork of fish scales, toad skin, and dozens of hungry mouths.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Cipactli can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight it."
        },
        {
          "name": "Many Mouths",
          "kind": "Action",
          "rulesText": "Mark a Stress to make a standard attack against all targets within Very Close range. Targets the Cipactli succeeds against must also mark a Stress."
        },
        {
          "name": "Frenzied Feeding",
          "kind": "Action",
          "rulesText": "Spend a Fear to force all PCs within Close range to succeed on an Instinct Reaction Roll or take 4d6 direct physical damage. The Cipactli clears a HP for each creature who took Severe damage from this attack."
        },
        {
          "name": "Quaking Footfalls",
          "kind": "Action",
          "rulesText": "Mark a Stress to force each PC within Far range to make an Agility Reaction Roll. Targets who fail must mark 2 Stress and are Vulnerable until they take damage. Targets who succeed must mark a Stress."
        },
        {
          "name": "Lifeblooded",
          "kind": "Reaction",
          "rulesText": "When the Cipactli takes Severe damage, its blood splashes to the ground and instantly erupts into a jungle. All creatures within Close range are temporarily Restrained."
        },
        {
          "name": "Verdant Explosion",
          "kind": "Reaction",
          "rulesText": "When the Cipactli marks its last HP, its body erupts into dense vegetation that overtakes the landscape."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/cipactli/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/cloud-titan",
      "@type": "Adversary",
      "name": "Cloud Titan",
      "slug": "cloud-titan",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "CLOUD TITAN",
        "lineStart": 10486,
        "lineEnd": 10512,
        "pdfPageStart": 147,
        "pdfPageEnd": 147
      },
      "tier": 4,
      "motivesAndTactics": [
        "Acquire rare and valuable things",
        "celebrate beauty",
        "never pass up an interesting wager"
      ],
      "difficulty": 18,
      "thresholds": "26/42",
      "hitPoints": 6,
      "stress": 5,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Bejeweled Blade",
        "range": "Very Close",
        "damage": "4d6+8 phy"
      },
      "experience": "Luxury +3, Nobility +3",
      "description": "A devastatingly attractive, blue-skinned goliath dressed in the finest silks and dripping with jewelry. They luxuriate in the finer things and dwell in a sky palace filled with treasure.",
      "features": [
        {
          "name": "Lightning Strike",
          "kind": "Action",
          "rulesText": "Mark a Stress to make an attack against a target within Far range. On a success, deal 4d10+14 magic damage and roll a d6. On a result of 4 or higher, the lightning bounces, and the Titan makes this attack against a different target within Very Close range of the previous target. Each time the lightning bounces, decrease the damage it deals by 1d10."
        },
        {
          "name": "Mist Weaver",
          "kind": "Action",
          "rulesText": "Spend a Fear and choose a point within Far range. The Titan conjures a thick fog over the area within Close range of that point. The Titan is Hidden to enemies within and on the other side of the fog and has advantage on attacks against creatures inside it. The fog lasts until the Titan marks HP."
        },
        {
          "name": "Nebulous Transformation",
          "kind": "Action",
          "rulesText": "Mark a Stress to have the Titan transform into a misty cloud that fills a Very Close area. While in this form, the Titan takes double magic damage and has immunity to physical damage. This form lasts until the Titan chooses to drop out of it or takes Severe damage."
        },
        {
          "name": "Unleash the Menagerie",
          "kind": "Action",
          "rulesText": "Once per scene, mark any number of Stress to summon an equal number of Griffins, which appear at Close range."
        },
        {
          "name": "Wind Worker",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Titan blast wind at a target within Close range. The target takes 4d6+8 physical damage and is pushed back to Far range from their current position."
        },
        {
          "name": "Double or Nothing",
          "kind": "Reaction",
          "rulesText": "When you would gain a Fear from an attack against the Titan, you can roll a d6. On an odd result, you don’t gain the Fear. On an even result, you gain 2 Fear instead of 1."
        }
      ],
      "role": "Social",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/cloud-titan/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/common-ruffian",
      "@type": "Adversary",
      "name": "Common Ruffian",
      "slug": "common-ruffian",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "COMMON RUFFIAN",
        "lineStart": 5492,
        "lineEnd": 5510,
        "pdfPageStart": 98,
        "pdfPageEnd": 98
      },
      "tier": 1,
      "motivesAndTactics": [
        "Do violence",
        "seek security and survival"
      ],
      "difficulty": 12,
      "thresholds": "6/10",
      "hitPoints": 4,
      "stress": 4,
      "attackModifier": "+0",
      "standardAttack": {
        "name": "Improvised Weapon",
        "range": "Melee",
        "damage": "1d8 phy"
      },
      "experience": "Desperate +3",
      "description": "A local laborer or artisan pushed by circumstances to assail others.",
      "features": [
        {
          "name": "Group Attack",
          "kind": "Action",
          "rulesText": "Spend a Fear to choose a target and spotlight all Ruffians within Close range of them. The Ruffians move into Melee range of the target and make one shared attack roll. On a success, they deal 1d8 physical damage each. Combine this damage."
        },
        {
          "name": "Survival Instinct",
          "kind": "Reaction",
          "rulesText": "When the Ruffian marks half their HP, roll a d6. On a result of 4 or higher, the Ruffian flees the scene. Otherwise, you gain a Fear."
        }
      ],
      "role": "Standard",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/common-ruffian/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/conscript",
      "@type": "Adversary",
      "name": "Conscript",
      "slug": "conscript",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
