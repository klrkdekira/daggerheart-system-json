        "pdfPageEnd": 219
      },
      "level": 6,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/sage"
      },
      "cardType": "Spell",
      "recallCost": 0,
      "rulesText": "Spend any number of Hope to conjure that many magical steeds (such as horses, camels, or elephants) that you and your allies can ride until your next long rest or the steeds take any damage. The steeds double your land speed while traveling and, when in danger, allow you to move within Far range without having to roll. Creatures riding a steed gain a −2 penalty to attack rolls and a +2 bonus to damage rolls.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/conjured-steeds/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/copycat",
      "@type": "DomainCard",
      "name": "Copycat",
      "slug": "copycat",
      "sourceLocator": {
