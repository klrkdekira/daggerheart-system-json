    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/gobstalker",
      "@type": "Adversary",
      "name": "Gobstalker",
      "slug": "gobstalker",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "GOBSTALKER",
        "lineStart": 8113,
        "lineEnd": 8144,
        "pdfPageStart": 122,
        "pdfPageEnd": 122
      },
      "tier": 2,
      "motivesAndTactics": [
        "Ambush rivals",
        "seek riches",
        "shoot beams"
      ],
      "difficulty": 15,
      "thresholds": "10/20",
      "hitPoints": 8,
      "stress": 6,
      "attackModifier": "+2",
      "standardAttack": {
        "name": "Mouth Tentacles",
        "range": "Very Close",
        "damage": "2d6+3 phy"
      },
      "experience": "Magic +3",
      "description": "A fleshy, floating ball of teeth that has numerous eyes and a bundle of questing mouth tentacles that shoot magic beams.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Gobstalker can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Anti-Mystica-Halitosis",
          "kind": "Passive",
          "rulesText": "The Gobstalker’s rancid breath creates an invisible, magic-negating miasma. An attack, an ability, or a spell that deals magic damage or creates a magic effect fails automatically if used within Close range of the Gobstalker."
        },
        {
          "name": "Tentacle Rays",
          "kind": "Action",
          "rulesText": "Mark a Stress to attack a target within Far range. On a success, roll a d8 for a random beam attack or spend a Fear to choose instead:\n\n1. Beguile. The Gobstalker Beguiles the target. While Beguiled, the target sees the Gobstalker as a friend and can’t attack it. Additionally, when a PC rolls with Fear, a Beguiled PC must mark a Stress or attack a target chosen by the Gobstalker. A Beguiled PC must succeed on an Instinct Roll (16) to clear the condition.\n2. Corrode. The target takes 2d8 magic damage and must mark an Armor Slot without receiving its benefits (they can still use armor to reduce the damage). If they can’t, double the damage.\n3. Doom. The target must mark all HP, but they can spend any number of Hope to reduce the number of HP marked this way by an equal amount.\n4. Hypnosis. The target falls into a Deep Trance and can’t act except to try to wake up. This condition lasts until the target takes damage or wakes up with a successful Presence Roll (16).\n5. Paralyze. The target freezes in place, becoming Vulnerable and Restrained until they mark 2 Stress.\n6. Sear. The target takes 2d8 direct magic damage.\n7. Scare. The target is Scared. While Scared, the target can’t take actions other than fleeing the battle or trying to shake off their terror. Additionally, the target must mark a Stress whenever you spend a Fear. The target can clear the condition with a successful Presence Roll (16).\n8. Slow. The target becomes Vulnerable and must mark a Stress to move until they spend 2 Hope."
        },
        {
          "name": "Leech Lick",
          "kind": "Reaction",
          "rulesText": "On a successful standard attack, you can spend a Fear to clear a number of Stress equal to the number of HP the target marked."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/gobstalker/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/gorgon",
      "@type": "Adversary",
      "name": "Gorgon",
      "slug": "gorgon",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "GORGON",
        "lineStart": 8148,
        "lineEnd": 8172,
        "pdfPageStart": 123,
        "pdfPageEnd": 123
      },
      "tier": 2,
      "motivesAndTactics": [
        "Corner",
        "hit-and-run",
        "petrify",
        "seek vengeance"
      ],
      "difficulty": 15,
      "thresholds": "13/25",
      "hitPoints": 9,
      "stress": 3,
      "attackModifier": "+4",
      "standardAttack": {
        "name": "Sunsear Shortbow",
        "range": "Far",
        "damage": "2d20+3 mag"
      },
      "experience": "Stealth +3",
      "description": "A snake-headed, scaled humanoid with a gilded bow, enraged that their peace has been disturbed.",
      "features": [
        {
          "name": "Relentless (2)",
          "kind": "Passive",
          "rulesText": "The Gorgon can be spotlighted up to two times per GM turn. Spend Fear as usual to spotlight them."
        },
        {
          "name": "Sunsear Arrows",
          "kind": "Passive",
          "rulesText": "When the Gorgon makes a successful standard attack, the target Glows until the end of the scene and can’t become Hidden. Attack rolls made against a Glowing target have advantage."
        },
        {
          "name": "Crown of Serpents",
          "kind": "Action",
          "rulesText": "Make an attack roll against a target within Melee range using the Gorgon’s protective snakes. On a success, mark a Stress to deal 2d10+4 physical damage and the target must mark a Stress."
        },
        {
          "name": "Petrifying Gaze",
          "kind": "Reaction",
          "rulesText": "When the Gorgon takes damage from an attack within Close range, you can spend a Fear to force the attacker to make an Instinct Reaction Roll. On a failure, they begin to turn to stone, marking a HP and starting a Petrification Countdown (4). This countdown ticks down when the Gorgon is attacked. When it triggers, the target must make a death move. If the Gorgon is defeated, all petrification countdowns end."
        },
        {
          "name": "Momentum",
          "kind": "Reaction",
          "rulesText": "When the Gorgon makes a successful attack against a PC, you gain a Fear."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/gorgon/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/greater-earth-elemental",
      "@type": "Adversary",
      "name": "Greater Earth Elemental",
      "slug": "greater-earth-elemental",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "GREATER EARTH ELEMENTAL",
        "lineStart": 9514,
        "lineEnd": 9536,
        "pdfPageStart": 136,
        "pdfPageEnd": 136
      },
      "tier": 3,
      "motivesAndTactics": [
        "Avalanche",
        "knock over",
        "pummel"
      ],
      "difficulty": 17,
      "thresholds": "22/40",
      "hitPoints": 10,
      "stress": 4,
      "attackModifier": "+7",
      "standardAttack": {
        "name": "Boulder Fist",
        "range": "Very Close",
        "damage": "3d10+1 phy"
      },
      "description": "A living landslide of boulders and dust, as large as a house.",
      "features": [
        {
          "name": "Slow",
          "kind": "Passive",
          "rulesText": "When you spotlight the Elemental and they don’t have a token on their stat block, they can’t act yet. Place a token on their stat block and describe what they’re preparing to do. When you spotlight the Elemental and they have a token on their stat block, clear the token and they can act."
        },
        {
          "name": "Crushing Blows",
          "kind": "Passive",
          "rulesText": "When the Elemental makes a successful attack, the target must mark an Armor Slot without receiving its benefits (they can still use armor to reduce the damage). If they can’t mark an Armor Slot, they must mark an additional HP."
        },
        {
          "name": "Immovable Object",
          "kind": "Passive",
          "rulesText": "An attack that would move the Elemental moves them two fewer ranges (for example, Far becomes Very Close). When the Elemental takes physical damage, reduce it by 7."
        },
        {
          "name": "Rockslide",
          "kind": "Action",
          "rulesText": "Mark a Stress to create a rockslide that buries the land in front of Elemental within Close range with rockfall. All targets in this area must make an Agility Reaction Roll (19). Targets who fail take 2d12+5 physical damage and become Vulnerable until their next roll with Hope. Targets who succeed take half damage."
        },
        {
          "name": "Momentum",
          "kind": "Reaction",
          "rulesText": "When the Elemental makes a successful attack against a PC, you gain a Fear."
        }
      ],
      "role": "Bruiser",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/greater-earth-elemental/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/greater-water-elemental",
      "@type": "Adversary",
      "name": "Greater Water Elemental",
      "slug": "greater-water-elemental",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
