        "damage": "1d12+2 phy"
      },
      "experience": "Bones +2",
      "description": "A large, brutish fey creature who has a conical red cap sealed on their head with candle wax.",
      "features": [
        {
          "name": "Backbreaker",
          "kind": "Action",
          "rulesText": "Mark a Stress to make an attack against a target within Melee range. On a success, deal 3d4+10 physical damage. A target who marks HP from this attack is Restrained until they clear a HP."
        },
        {
          "name": "Kneecapper",
          "kind": "Reaction",
          "rulesText": "When the Breaker makes a successful standard attack, you can spend a Fear to make the target temporarily Vulnerable."
        }
      ],
