    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/final-words",
      "@type": "DomainCard",
      "name": "Final Words",
      "slug": "final-words",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "FINAL WORDS",
        "lineStart": 16072,
        "lineEnd": 16078,
        "pdfPageStart": 221,
        "pdfPageEnd": 221
      },
      "level": 2,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/splendor"
      },
      "cardType": "Spell",
      "recallCost": 1,
      "rulesText": "You can infuse a corpse with a moment of life to speak with it. Make a Spellcast Roll (13). On a success with Hope, the corpse answers up to three questions. On a success with Fear, the corpse answers one question. The corpse answers truthfully, but it can’t impart information it didn’t know in life. On a failure, or once the corpse has finished answering your questions, the body turns to dust.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/final-words/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/flight",
      "@type": "DomainCard",
      "name": "Flight",
      "slug": "flight",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "FLIGHT",
        "lineStart": 14454,
        "lineEnd": 14460,
        "pdfPageStart": 206,
        "pdfPageEnd": 206
      },
      "level": 3,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/arcana"
      },
      "cardType": "Spell",
      "recallCost": 1,
      "rulesText": "Make a Spellcast Roll (15). On a success, place a number of tokens equal to your Agility on this card (minimum 1). When you make an action roll while flying, spend a token from this card. After the action that spends the last token is resolved, you descend to the ground directly below you.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/flight/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/floating-eye",
      "@type": "DomainCard",
      "name": "Floating Eye",
      "slug": "floating-eye",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "FLOATING EYE",
        "lineStart": 14438,
        "lineEnd": 14444,
        "pdfPageStart": 206,
        "pdfPageEnd": 206
      },
      "level": 2,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/arcana"
      },
      "cardType": "Spell",
      "recallCost": 0,
      "rulesText": "Spend a Hope to create a single, small floating orb that you can move anywhere within Very Far range. While this spell is active, you can see through the orb as though you’re looking out from its position. You can transition between using your own senses and seeing through the orb freely. If the orb takes damage or moves out of range, the spell ends.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/floating-eye/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/forager",
      "@type": "DomainCard",
      "name": "Forager",
      "slug": "forager",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "FORAGER",
        "lineStart": 15933,
        "lineEnd": 15939,
        "pdfPageStart": 219,
        "pdfPageEnd": 219
      },
      "level": 6,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/sage"
      },
      "cardType": "Ability",
      "recallCost": 1,
      "rulesText": "As an additional downtime move you can choose, roll a d6 to see what you forage. Work with the GM to describe it and add it to your inventory as a consumable. Your party can carry up to five foraged consumables at a time. 1. A unique food (Clear 2 Stress) 2. A beautiful relic (Gain 2 Hope) 3. An arcane rune (+2 to a Spellcast Roll) 4. A healing vial (Clear 2 Hit Points) 5. A luck charm (Reroll any die) 6. Choose one of the options above.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/forager/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/force-of-nature",
      "@type": "DomainCard",
      "name": "Force of Nature",
      "slug": "force-of-nature",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "FORCE OF NATURE",
        "lineStart": 16011,
        "lineEnd": 16027,
        "pdfPageStart": 220,
        "pdfPageEnd": 220
      },
      "level": 10,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/sage"
      },
      "cardType": "Spell",
      "recallCost": 2,
      "rulesText": "Mark a Stress to transform into a hulking nature spirit, gaining the following benefits:\n\n  - When you succeed on an attack or Spellcast Roll, gain a +10 bonus to the damage roll.\n\n  - When you deal enough damage to defeat a creature within\n\nClose range, you absorb them and clear an Armor Slot.\n\n  - You can’t be Restrained.\n\nBefore you make an action roll, you must spend a Hope. If you can’t, you revert to your normal form.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/force-of-nature/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/forceful-push",
      "@type": "DomainCard",
      "name": "Forceful Push",
      "slug": "forceful-push",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "FORCEFUL PUSH",
        "lineStart": 16254,
        "lineEnd": 16262,
        "pdfPageStart": 222,
        "pdfPageEnd": 222
      },
      "level": 1,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/valor"
      },
      "cardType": "Ability",
      "recallCost": 0,
      "rulesText": "Make an attack with your primary weapon against a target within Melee range. On a success, you deal damage and knock them back to Close range. On a success with Hope, add a d6 to your damage roll.\n\nAdditionally, you can spend a Hope to make them temporarily Vulnerable.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/forceful-push/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/forest-sprites",
      "@type": "DomainCard",
      "name": "--Forest Sprites",
      "slug": "forest-sprites",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "--FOREST SPRITES",
        "lineStart": 15965,
        "lineEnd": 15977,
        "pdfPageStart": 220,
        "pdfPageEnd": 220
      },
      "level": 8,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/sage"
      },
      "cardType": "Spell",
      "recallCost": 2,
      "rulesText": "Make a Spellcast Roll (13). On a success, spend any number of Hope to create an equal number of small forest sprites who appear at points you choose within Far range, providing the following benefits:\n\n  - Your allies gain a +3 bonus to attack rolls against adversaries within Melee range of a sprite.\n\n  - An ally who marks an Armor Slot while within Melee range of a sprite can mark an additional Armor Slot.\n\nA sprite vanishes after granting a benefit or taking any damage.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/forest-sprites/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/fortified-armor",
      "@type": "DomainCard",
      "name": "Fortified Armor",
      "slug": "fortified-armor",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "FORTIFIED ARMOR",
        "lineStart": 14653,
        "lineEnd": 14659,
        "pdfPageStart": 208,
        "pdfPageEnd": 208
      },
      "level": 4,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/blade"
      },
      "cardType": "Ability",
      "recallCost": 0,
      "rulesText": "While you are wearing armor, gain a +2 bonus to your damage thresholds.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/fortified-armor/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/frenzy",
      "@type": "DomainCard",
      "name": "Frenzy",
      "slug": "frenzy",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "FRENZY",
        "lineStart": 14736,
        "lineEnd": 14744,
        "pdfPageStart": 209,
        "pdfPageEnd": 209
      },
      "level": 8,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/blade"
      },
      "cardType": "Ability",
      "recallCost": 3,
      "rulesText": "Once per long rest, you can go into a Frenzy until there are no more adversaries within sight.\n\nWhile Frenzied, you can’t use Armor Slots, and you gain a +10 bonus to your damage rolls and a +8 bonus to your Severe damage threshold.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/frenzy/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/full-surge",
      "@type": "DomainCard",
      "name": "Full Surge",
      "slug": "full-surge",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "FULL SURGE",
        "lineStart": 16381,
        "lineEnd": 16387,
        "pdfPageStart": 223,
        "pdfPageEnd": 223
      },
      "level": 8,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/valor"
      },
      "cardType": "Ability",
      "recallCost": 1,
      "rulesText": "Once per long rest, mark 3 Stress to push your body to its limits. Gain a +2 bonus to all of your character traits until your next rest.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/full-surge/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/get-back-up",
      "@type": "DomainCard",
      "name": "Get Back Up",
      "slug": "get-back-up",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "GET BACK UP",
        "lineStart": 14587,
        "lineEnd": 14593,
        "pdfPageStart": 208,
        "pdfPageEnd": 208
      },
      "level": 1,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/blade"
      },
      "cardType": "Ability",
      "recallCost": 1,
      "rulesText": "When you take Severe damage, you can mark a Stress to reduce the severity by one threshold.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/get-back-up/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/gifted-tracker",
      "@type": "DomainCard",
      "name": "Gifted Tracker",
      "slug": "gifted-tracker",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "GIFTED TRACKER",
        "lineStart": 15773,
        "lineEnd": 15786,
        "pdfPageStart": 218,
        "pdfPageEnd": 218
      },
      "level": 1,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/sage"
      },
      "cardType": "Ability",
      "recallCost": 0,
      "rulesText": "When you’re tracking a specific creature or group of creatures based on signs of their passage, you can spend any number of Hope and ask the GM that many questions from the following list.\n\n  - What direction did they go?\n  - How long ago did they pass through?\n  - What were they doing in this location?\n  - How many of them were here?\n\nWhen you encounter creatures you’ve tracked in this way, gain a +1 bonus to your Evasion against them.",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/domain-cards/gifted-tracker/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domain-cards/glancing-blow",
      "@type": "DomainCard",
      "name": "Glancing Blow",
      "slug": "glancing-blow",
      "sourceLocator": {
        "chapter": "APPENDIX",
        "heading": "GLANCING BLOW",
        "lineStart": 14718,
        "lineEnd": 14724,
        "pdfPageStart": 208,
        "pdfPageEnd": 208
      },
      "level": 7,
      "domain": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/domains/blade"
      },
      "cardType": "Ability",
      "recallCost": 1,
      "rulesText": "When you fail an attack, you can mark a Stress to deal weapon damage using half your Proficiency.",
