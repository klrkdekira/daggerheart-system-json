    {
      "@id": "https://cheeleong.dev/daggerheart-system-json/objects/adversaries/roc",
      "@type": "Adversary",
      "name": "Roc",
      "slug": "roc",
      "sourceLocator": {
        "chapter": "RUNNING AN ADVENTURE",
        "heading": "ROC",
        "lineStart": 9790,
        "lineEnd": 9816,
        "pdfPageStart": 139,
        "pdfPageEnd": 139
      },
      "tier": 3,
      "motivesAndTactics": [
        "Breathe lightning and speak thunder",
        "protect eggs",
        "rake with talons",
        "spy from afar"
      ],
      "difficulty": 18,
      "thresholds": "20/35",
      "hitPoints": 12,
      "stress": 6,
      "attackModifier": "+3",
      "standardAttack": {
        "name": "Beak & Talons",
        "range": "Very Close",
        "damage": "3d12+8 phy"
      },
      "experience": "Craggy Peaks +3",
      "description": "A giant falcon that nests in the mountains and unleashes storms.",
      "features": [
        {
          "name": "Relentless (3)",
          "kind": "Passive",
          "rulesText": "The Roc can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight it."
        },
        {
          "name": "Bird of Prey",
          "kind": "Passive",
          "rulesText": "Once per GM turn, the Roc can move up to Very Far range before or after it takes an action."
        },
        {
          "name": "Here Comes the Boom",
          "kind": "Action",
          "rulesText": "Spend a Fear to have the Roc unleash a storm of lightning and thunder. Make an attack roll against 1d4+1 targets within Far range. Targets the Roc succeeds against take 3d12 magic damage. Then each target within Far range of the Roc must make an Agility Reaction Roll (20). Targets who fail take 3d8 physical damage and are pushed back to Close range. Targets who succeed must mark a Stress."
        },
        {
          "name": "Crushing Grasp",
          "kind": "Reaction",
          "rulesText": "When the Roc makes a successful standard attack, you can mark a Stress to have the Roc crush the target with its talons, forcing them to mark 1d4 Stress and Restraining them until they succeed on a Strength Roll (20)."
        },
        {
          "name": "Nest Warden",
          "kind": "Evolution",
          "rulesText": "When the Roc’s eggs are threatened, it gains the following features: Wrathful - Passive: The Roc gains a +2 bonus to its Difficulty and a bonus to damage rolls equal to the number of Stress it has marked."
        },
        {
          "name": "Electrifying Aura",
          "kind": "Passive",
          "rulesText": "The Roc has resistance to magic damage. PCs who fail a roll within Very Close range must spend a Hope or mark 1d4 Stress."
        }
      ],
      "role": "Solo",
      "htmlPage": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/roc/"
      },
      "source": {
        "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
      }
    },
    {
