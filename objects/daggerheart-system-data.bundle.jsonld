        "lineEnd": 7557,
        "pdfPageStart": 116,
        "pdfPageEnd": 116
      },
      "tier": 2,
      "motivesAndTactics": [
        "Capture sacrifices",
        "isolate prey",
        "rise in the ranks"
      ],
      "difficulty": 15,
      "thresholds": "9/17",
