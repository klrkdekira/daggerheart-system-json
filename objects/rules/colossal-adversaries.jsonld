    "chapter": "SUPPLEMENTAL CAMPAIGN MECHANICS",
    "heading": "COLOSSAL ADVERSARIES",
    "lineStart": 14034,
    "lineEnd": 14113,
    "pdfPageStart": 198,
    "pdfPageEnd": 199
