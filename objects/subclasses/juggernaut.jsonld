  "features": [
    {
      "name": "Rugged",
      "stage": "foundation",
      "rulesText": "Gain a permanent +3 bonus to your Severe damage threshold."
    },
    {
      "name": "Overwhelm",
      "stage": "foundation",
      "rulesText": "When you succeed on an attack against a target, you can spend a Hope to throw the target within Close range or to force them to mark a Stress."
    },
    {
      "name": "Surrounded",
      "stage": "specialization",
      "rulesText": "When you make an attack with a Melee weapon, you can spend any number of Hope to target an equal number of additional creatures within Melee range."
    },
    {
      "name": "Eye for an Eye",
      "stage": "specialization",
      "rulesText": "Once per rest when an adversary within Melee range forces you to mark any number of Hit Points, you can mark a Stress to force them to mark the same number of Hit Points."
    },
    {
      "name": "Pummeljoy",
      "stage": "mastery",
      "rulesText": "When you critically succeed on a Melee weapon attack, you gain an additional Hope, clear an additional Stress, and gain a +1 bonus to your Proficiency for that attack."
    },
    {
      "name": "Not Done Yet",
      "stage": "mastery",
      "rulesText": "When you take Severe damage, you can gain a Hope or clear a Stress."
    }
  ],
  "description": "Play the Juggernaut if you want to pulverize your opponents with crushing blows.",
