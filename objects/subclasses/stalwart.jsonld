      "name": "Unwavering",
      "stage": "foundation",
      "rulesText": "Gain a permanent +1 bonus to your damage thresholds."
    },
    {
      "name": "Iron Will",
      "stage": "foundation",
      "rulesText": "When you take physical damage, you can mark an additional Armor Slot to reduce the severity."
    },
    {
      "name": "Unrelenting",
      "stage": "specialization",
      "rulesText": "Gain a permanent +2 bonus to your damage thresholds."
    },
    {
      "name": "Partners-in-Arms",
      "stage": "specialization",
      "rulesText": "When an ally within Very Close range takes damage, you can mark an Armor Slot to reduce the severity by one threshold."
    },
    {
      "name": "Undaunted",
      "stage": "mastery",
      "rulesText": "Gain a permanent +3 bonus to your damage thresholds."
    },
    {
      "name": "Loyal Protector",
      "stage": "mastery",
      "rulesText": "When an ally within Close range has 2 or fewer Hit Points and would take damage, you can mark a Stress to sprint to their side and take the damage instead."
    }
