{
  "@context": "https://cheeleong.dev/daggerheart-system-json/systems/context.jsonld",
  "@id": "https://cheeleong.dev/daggerheart-system-json/objects/subclasses/poisoners-guild",
  "@type": "Subclass",
  "name": "Poisoners Guild",
  "slug": "poisoners-guild",
  "sourceLocator": {
    "chapter": "CORE MATERIALS",
    "heading": "POISONERS GUILD",
    "lineStart": 430,
    "lineEnd": 481,
    "pdfPageStart": 10,
    "pdfPageEnd": 10
  },
  "parentClass": {
    "@id": "https://cheeleong.dev/daggerheart-system-json/objects/classes/assassin"
  },
  "features": [
    {
      "name": "Toxic Concoctions",
      "stage": "foundation",
      "rulesText": "Mark a Stress to place 1d4+1 tokens on this card. When you make a successful weapon attack, you can spend a token to afflict the target with a poison. You know these poisons:\n\n  - Ghost Petal: The target becomes temporarily Vulnerable.\n  - Grave Spore: The target must also mark a Stress.\n  - Leech Weed: You deal an extra 1d6 damage on this attack.\n\nWhen you take a long rest, clear all unspent tokens."
    },
    {
      "name": "Poison Compendium",
      "stage": "specialization",
      "rulesText": "You also know these poisons:\n\n  - Midnight Vine: The target has disadvantage on attack rolls until it marks a Stress to clear this condition.\n  - Gorgon Root: The target becomes temporarily Restrained."
    },
    {
      "name": "Twin Fang",
      "stage": "specialization",
      "rulesText": "When you afflict a target Marked for Death with a poison you know, you can spend an additional token to also inflict the effect of a second poison you know."
    },
    {
      "name": "Venomancer",
      "stage": "mastery",
      "rulesText": "You also know these poisons:\n\n  - Blight Seed: The target gains a −3 penalty to their damage thresholds until the end of the scene. This effect can’t stack.\n  - Fear Leaf: You deal extra damage equal to the result of your Fear Die on this attack.\n  - Corpse Thorn: The target gains disadvantage on reaction rolls until the end of the scene."
    },
    {
      "name": "Adder’s Blessing",
      "stage": "mastery",
      "rulesText": "You are immune to poisons and other toxins."
    }
  ],
  "description": "Play the Poisoners Guild if you want to debilitate your targets with punishing afflictions.",
  "spellcastTrait": "Knowledge",
  "htmlPage": {
    "@id": "https://cheeleong.dev/daggerheart-system-json/records/subclasses/poisoners-guild/"
  },
  "source": {
