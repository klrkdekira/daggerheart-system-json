  "features": [
    {
      "name": "Spirit Weapon",
      "stage": "foundation",
      "rulesText": "When you have an equipped weapon with a range of Melee or Very Close, it can fly from your hand to attack an adversary within Close range and then return to you. You can mark a Stress to target an additional adversary within range with the same attack roll."
    },
    {
      "name": "Sparing Touch",
      "stage": "foundation",
      "rulesText": "Once per long rest, touch a creature and clear 2 Hit Points or 2 Stress from them."
    },
    {
      "name": "Devout",
      "stage": "specialization",
      "rulesText": "When you roll your Prayer Dice, you can roll an additional die and discard the lowest result. Additionally, you can use your “Sparing Touch” feature twice instead of once per long rest."
    },
    {
      "name": "Sacred Resonance",
      "stage": "mastery",
      "rulesText": "When you roll damage for your “Spirit Weapon” feature, if any of the die results match, double the value of each matching die. For example, if you roll two 5s, they count as two 10s."
    }
  ],
  "description": "Play the Divine Wielder if you want to dominate the battlefield with a legendary weapon.",
  "spellcastTrait": "Strength",
