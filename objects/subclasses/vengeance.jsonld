  "features": [
    {
      "name": "At Ease",
      "stage": "foundation",
      "rulesText": "Gain an additional Stress slot."
    },
    {
      "name": "Revenge",
      "stage": "foundation",
      "rulesText": "When an adversary within Melee range succeeds on an attack against you, you can mark 2 Stress to force the attacker to mark a Hit Point."
    },
    {
      "name": "Act of Reprisal",
      "stage": "specialization",
      "rulesText": "When an adversary damages an ally within Melee range, you gain a +1 bonus to your Proficiency for the next successful attack you make against that adversary."
    },
    {
      "name": "Nemesis",
      "stage": "mastery",
      "rulesText": "Spend 2 Hope to Prioritize an adversary until your next rest. When you make an attack against your Prioritized adversary, you can swap the results of your Hope and Fear Dice. You can only Prioritize one adversary at a time."
    }
  ],
  "description": "Play the Vengeance if you want to strike down enemies who harm you or your allies.",
