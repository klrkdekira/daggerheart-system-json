    "chapter": "CORE MATERIALS",
    "heading": "MARTIAL ARTIST",
    "lineStart": 627,
    "lineEnd": 663,
    "pdfPageStart": 12,
    "pdfPageEnd": 12
  },
  "parentClass": {
    "@id": "https://cheeleong.dev/daggerheart-system-json/objects/classes/brawler"
  },
  "features": [
    {
      "name": "Stance Fighter",
      "stage": "foundation",
      "rulesText": "You can channel your inner resolve to shift into martial stances that grant you special benefits in combat.\n\nTake the Martial Stances sheet and choose two martial stances from Tier 1. Each time you level up your character, choose an additional stance from your tier or lower."
    },
    {
      "name": "Keen Defenses",
      "stage": "specialization",
      "rulesText": "When you’re targeted by an attack, you can spend a Focus to gain a bonus to your Evasion equal to your tier against the attack."
    },
    {
      "name": "Focus Cannon",
      "stage": "specialization",
      "rulesText": "Spend a Focus to make an Instinct Roll against an adversary within Far range. On a success, deal d20+3 magic damage using your Proficiency."
    },
    {
      "name": "Limit Breaker",
      "stage": "mastery",
      "rulesText": "Once per rest, you can perform an unbelievable feat of athletic prowess, such as running across water, leaping between distant rooftops, or scaling a building without needing to roll. When you do, gain a Hope and clear a Stress."
    },
    {
      "name": "Flow State",
      "stage": "mastery",
      "rulesText": "You can mark a Stress instead of spending a Focus to shift into a different stance. Additionally, you can spend a Focus instead of marking a Stress to start a combo strike."
    }
  ],
  "description": "Play the Martial Artist if you want to use a variety of fighting styles to eliminate your foes.",
  "htmlPage": {
    "@id": "https://cheeleong.dev/daggerheart-system-json/records/subclasses/martial-artist/"
  },
  "source": {
    "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
  }
}
