      "name": "First Strike",
      "stage": "foundation",
      "rulesText": "The first time in a scene you succeed on an attack, you deal double damage."
    },
    {
      "name": "Ambush",
      "stage": "foundation",
      "rulesText": "Your “Marked for Death” feature uses d6s instead of d4s."
    },
    {
      "name": "Death Strike",
      "stage": "specialization",
      "rulesText": "When you deal Severe damage to a creature, you can mark a Stress to force them to mark an additional Hit Point."
    },
    {
      "name": "Scorpion’s Poise",
      "stage": "specialization",
      "rulesText": "You gain a +2 bonus to your Evasion against attacks made by a creature you’ve Marked for Death."
    },
    {
      "name": "True Strike",
      "stage": "mastery",
      "rulesText": "Once per long rest when you fail an attack, you can spend a Hope to make it a success instead."
    },
    {
      "name": "Backstab",
      "stage": "mastery",
      "rulesText": "Your “Marked for Death” feature uses d8s instead of d6s."
    }
