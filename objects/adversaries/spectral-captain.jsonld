  "description": "A ghostly commander leading their troops beyond death.",
  "features": [
    {
      "name": "Ghost",
      "kind": "Passive",
      "rulesText": "The Captain has resistance to physical damage. Mark a Stress to move up to Close range through solid objects."
    },
    {
      "name": "Unending Battle",
      "kind": "Action",
      "rulesText": "Spend 2 Fear to return up to 1d4+1 defeated Spectral allies to the battle at the points where they first appeared (with no marked HP or Stress)."
    },
    {
      "name": "Hold Fast",
      "kind": "Reaction",
      "rulesText": "When the Captain’s Spectral allies are forced to make a reaction roll, you can mark a Stress to give those allies a +2 bonus to the roll."
    },
    {
      "name": "Momentum",
      "kind": "Reaction",
      "rulesText": "When the Captain makes a successful attack against a PC, you gain a Fear."
    }
  ],
