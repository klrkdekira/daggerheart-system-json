  "description": "A high-ranking courtier with the ear of the local nobility.",
  "features": [
    {
      "name": "Devastating Retort",
      "kind": "Passive",
      "rulesText": "A PC who rolls less than 17 on an action roll targeting the Advisor must mark a Stress."
    },
    {
      "name": "Bend Ears",
      "kind": "Action",
      "rulesText": "Mark a Stress to influence an NPC within Melee range with whispered words. That target’s opinion on one matter shifts toward the Advisor’s preference unless it is in direct opposition to the target’s motives."
    },
    {
      "name": "Scapegoat",
      "kind": "Action",
      "rulesText": "Spend a Fear to convince a crowd or notable individual that one person or group is responsible for some problem facing the target. The target becomes hostile to the scapegoat until convinced of their innocence with a successful Presence Roll (17)."
    }
  ],
