    {
      "name": "Anger Unrelenting",
      "kind": "Passive",
      "rulesText": "The Demon’s attacks deal direct damage."
    },
    {
      "name": "Battle Lust",
      "kind": "Action",
      "rulesText": "Spend a Fear to boil the blood of all PCs within Far range. They use a d20 as their Fear Die until the end of the scene."
    },
    {
      "name": "Retaliation",
      "kind": "Reaction",
      "rulesText": "When the Demon takes damage from an attack within Close range, you can mark a Stress to make a standard attack against the attacker."
    },
    {
      "name": "Blood and Souls",
      "kind": "Reaction",
      "rulesText": "Countdown (Loop 6). Activate the first time an attack is made within sight of the Demon. It ticks down when a PC takes a violent action. When it triggers, summon 1d4 Minor Demons, who appear at Close range."
    }
