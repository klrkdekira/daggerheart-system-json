    "pdfPageStart": 156,
    "pdfPageEnd": 156
  },
  "tier": 4,
  "motivesAndTactics": [
    "Douse with lava",
    "incinerate",
    "repel Invaders",
    "reposition"
  ],
  "difficulty": 20,
  "thresholds": "30/58",
  "hitPoints": 7,
  "stress": 5,
  "attackModifier": "+9",
  "standardAttack": {
    "name": "Lava-Coated Claws",
    "range": "Close",
    "damage": "4d12+4 phy"
  },
  "experience": "Hunt from Above +5",
  "description": "Enraged by their wounds, the dragon bursts into molten lava.",
  "features": [
    {
      "name": "Relentless (3)",
      "kind": "Passive",
      "rulesText": "The Molten Scourge can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
    },
    {
      "name": "Cracked Scales",
      "kind": "Passive",
      "rulesText": "When the Molten Scourge takes damage, roll a number of d6s equal to HP marked. For each result of 4 or higher, you gain a Fear."
    },
    {
      "name": "Shattering Might",
      "kind": "Action",
      "rulesText": "Mark a Stress to make an attack against a target within Very Close range. On a success, the target takes 4d8+1 physical damage, loses a Hope, and is knocked back to Close range. The Molten Scourge clears a Stress."
    },
    {
      "name": "Eruption",
      "kind": "Action",
      "rulesText": "Spend a Fear to erupt lava from beneath the Molten Scourge’s scales, filling the area within Very Close range with molten lava. All targets in that area must succeed on an Agility Reaction Roll or take 4d6+6 physical damage and be knocked back to Close range. This area remains lava. When a creature other than the Molten Scourge enters that area or acts while inside of it, they must mark 6 HP."
    },
    {
      "name": "Volcanic Breath",
      "kind": "Reaction",
      "rulesText": "When the Molten Scourge takes Major damage, roll a d10. On a result of 8 or higher, the Molten Scourge breathes a flow of lava in front of them within Far range. All targets in that area must make an Agility Reaction Roll. Targets who fail take 2d10+4 physical damage, mark 1d4 Stress, and are Vulnerable until they clear a Stress. Targets who succeed take half damage and must mark a Stress."
    },
    {
      "name": "Lava Splash",
      "kind": "Reaction",
      "rulesText": "When the Molten Scourge takes Severe damage from an attack within Very Close range, molten blood gushes from the wound and deals 2d10+4 direct physical damage to the attacker."
    },
    {
      "name": "Ashen Vengeance (Phase Change)",
      "kind": "Reaction",
      "rulesText": "When the Molten Scourge marks their last HP, replace them with the Ashen Tyrant and immediately spotlight them."
    }
  ],
  "role": "Solo",
  "htmlPage": {
