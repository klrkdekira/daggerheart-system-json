  "experience": "Keen Senses +3, Ponds +3",
  "description": "A grizzly bear with a feathery hide and the head of a giant goose.",
  "features": [
    {
      "name": "Relentless (2)",
      "kind": "Passive",
      "rulesText": "The Fowlbear can be spotlighted up to two times per GM turn. Spend Fear as usual to spotlight it."
    },
    {
      "name": "Double Strike",
      "kind": "Action",
      "rulesText": "Mark a Stress to make two standard attacks. If both attacks succeed against the same target, combine the damage."
    },
    {
      "name": "Dread Honk",
      "kind": "Action",
      "rulesText": "Spend a Fear to have the Fowlbear unleash a terrifying, ear-splitting goose honk. Each PC within Close range must make a Presence Reaction Roll. Targets who fail must mark a Stress, move away from the Fowlbear to Far range, and become Vulnerable until the Fowlbear deals damage to them. Targets who succeed must mark a Stress or move away from the Fowlbear to Far range."
    }
  ],
  "role": "Bruiser",
