  "@type": "Adversary",
  "name": "Greater Earth Elemental",
  "slug": "greater-earth-elemental",
  "sourceLocator": {
    "chapter": "RUNNING AN ADVENTURE",
    "heading": "GREATER EARTH ELEMENTAL",
    "lineStart": 9514,
    "lineEnd": 9536,
    "pdfPageStart": 136,
    "pdfPageEnd": 136
  },
  "tier": 3,
  "motivesAndTactics": [
    "Avalanche",
    "knock over",
    "pummel"
  ],
  "difficulty": 17,
  "thresholds": "22/40",
  "hitPoints": 10,
  "stress": 4,
  "attackModifier": "+7",
  "standardAttack": {
    "name": "Boulder Fist",
    "range": "Very Close",
    "damage": "3d10+1 phy"
  },
  "description": "A living landslide of boulders and dust, as large as a house.",
  "features": [
    {
      "name": "Slow",
      "kind": "Passive",
      "rulesText": "When you spotlight the Elemental and they don’t have a token on their stat block, they can’t act yet. Place a token on their stat block and describe what they’re preparing to do. When you spotlight the Elemental and they have a token on their stat block, clear the token and they can act."
    },
    {
      "name": "Crushing Blows",
      "kind": "Passive",
      "rulesText": "When the Elemental makes a successful attack, the target must mark an Armor Slot without receiving its benefits (they can still use armor to reduce the damage). If they can’t mark an Armor Slot, they must mark an additional HP."
    },
    {
      "name": "Immovable Object",
      "kind": "Passive",
      "rulesText": "An attack that would move the Elemental moves them two fewer ranges (for example, Far becomes Very Close). When the Elemental takes physical damage, reduce it by 7."
    },
    {
      "name": "Rockslide",
      "kind": "Action",
      "rulesText": "Mark a Stress to create a rockslide that buries the land in front of Elemental within Close range with rockfall. All targets in this area must make an Agility Reaction Roll (19). Targets who fail take 2d12+5 physical damage and become Vulnerable until their next roll with Hope. Targets who succeed take half damage."
    },
    {
      "name": "Momentum",
      "kind": "Reaction",
      "rulesText": "When the Elemental makes a successful attack against a PC, you gain a Fear."
    }
  ],
  "role": "Bruiser",
  "htmlPage": {
    "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/greater-earth-elemental/"
  },
  "source": {
    "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
  }
}
