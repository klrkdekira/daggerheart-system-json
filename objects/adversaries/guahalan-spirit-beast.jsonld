  "description": "A brightly colored spirit in the shape of an animal.",
  "features": [
    {
      "name": "Minion (5)",
      "kind": "Passive",
      "rulesText": "The Spirit Beast is defeated when it takes any damage. For every 5 damage a PC deals to the Spirit Beast, the PC defeats an additional Minion within range the attack would succeed against."
    },
    {
      "name": "Ethereal Form",
      "kind": "Passive",
      "rulesText": "The Spirit Beast has resistance to physical damage."
    },
    {
      "name": "Group Attack",
      "kind": "Action",
      "rulesText": "Spend a Fear to choose a target and spotlight all Guahalan Spirit Beasts within Close range of them. Those Minions move into Melee range of the target and make one shared attack roll. On a success, they deal 5 magic damage each. Combine this damage."
    },
    {
      "name": "Beast Bomb",
      "kind": "Reaction",
      "rulesText": "When the Spirit Beast is defeated, it explodes in white flame and deals 5 magic damage to creatures within Melee range."
    }
  ],
  "role": "Minion",
