  "description": "A coruscating mass of uncontrollable magic.",
  "features": [
    {
      "name": "Arcane Form",
      "kind": "Passive",
      "rulesText": "The Elemental is resistant to magic damage."
    },
    {
      "name": "Sickening Flux",
      "kind": "Action",
      "rulesText": "Mark a HP to force all targets within Close range to mark a Stress and become Vulnerable until their next rest or they clear a HP."
    },
    {
      "name": "Remake Reality",
      "kind": "Action",
      "rulesText": "Spend a Fear to transform the area within Very Close range into a different biome. All targets within this area take 2d6+3 direct magic damage."
    },
    {
      "name": "Magical Reflection",
      "kind": "Reaction",
      "rulesText": "When the Elemental takes damage from an attack within Close range, deal an amount of damage to the attacker equal to half the damage they dealt."
    },
    {
      "name": "Momentum",
      "kind": "Reaction",
      "rulesText": "When the Elemental makes a successful attack against a PC, you gain a Fear."
    }
  ],
