  "features": [
    {
      "name": "From Above",
      "kind": "Passive",
      "rulesText": "When the Knight succeeds on a standard attack from above a target, they deal 3d12+3 physical damage instead of their standard damage."
    },
    {
      "name": "Blade of the Forest",
      "kind": "Action",
      "rulesText": "Spend a Fear to make an attack against all targets within Very Close range. Targets the Knight succeeds against take physical damage equal to 3d4 + the target’s Major threshold."
    },
    {
      "name": "Thorny Armor",
      "kind": "Reaction",
      "rulesText": "When the Knight takes damage from an attack within Melee range, you can mark a Stress to deal 1d10+5 physical damage to the attacker."
    }
