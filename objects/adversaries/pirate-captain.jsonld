  "experience": "Commander +2, Sailor +3",
  "description": "A charismatic sea dog with an impressive hat, eager to raid and plunder.",
  "features": [
    {
      "name": "Swashbuckler",
      "kind": "Passive",
      "rulesText": "When the Captain marks 2 or fewer HP from an attack within Melee range, the attacker must mark a Stress."
    },
    {
      "name": "Reinforcements",
      "kind": "Action",
      "rulesText": "Once per scene, mark a Stress to summon a Pirate Raiders Horde, which appears at Far range."
    },
    {
      "name": "No Quarter",
      "kind": "Action",
      "rulesText": "Spend a Fear to choose a target who has three or more Pirates within Melee range of them. The Captain leads the Pirates in hurling threats and promises of a watery grave. The target must make a Presence Reaction Roll. On a failure, the target marks 1d4+1 Stress. On a success, they must mark a Stress."
    },
    {
      "name": "Momentum",
      "kind": "Reaction",
      "rulesText": "When the Captain makes a successful attack against a PC, you gain a Fear."
    }
  ],
  "role": "Leader",
