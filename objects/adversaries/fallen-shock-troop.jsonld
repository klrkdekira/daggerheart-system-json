  "features": [
    {
      "name": "Minion (12)",
      "kind": "Passive",
      "rulesText": "The Shock Troop is defeated when they take any damage. For every 12 damage a PC deals to the Shock Troop, defeat an additional Minion within range the attack would succeed against."
    },
    {
      "name": "Aura of Doom",
      "kind": "Passive",
      "rulesText": "When a PC marks HP from an attack by the Shock Troop, they lose a Hope."
    },
    {
      "name": "Group Attack",
      "kind": "Action",
      "rulesText": "Spend a Fear to choose a target and spotlight all Fallen Shock Troops within Close range of them. Those Minions move into Melee range of the target and make one shared attack roll. On a success, they deal 12 physical damage each. Combine this damage."
    }
  ],
