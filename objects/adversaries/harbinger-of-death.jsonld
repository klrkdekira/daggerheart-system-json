    "chapter": "RUNNING AN ADVENTURE",
    "heading": "HARBINGER OF DEATH",
    "lineStart": 10839,
    "lineEnd": 10865,
    "pdfPageStart": 151,
    "pdfPageEnd": 151
  },
  "tier": 4,
  "motivesAndTactics": [
    "Bring judgment",
    "cut them down",
    "move swiftly",
    "seek relentlessly",
    "take souls"
  ],
  "difficulty": 18,
  "thresholds": "28/52",
  "hitPoints": 6,
  "stress": 6,
  "attackModifier": "+8",
  "standardAttack": {
    "name": "Great Scythe",
    "range": "Close",
    "damage": "4d10+10 phy"
  },
  "experience": "Judgment +3",
  "description": "A desiccated corpse riding atop a skeletal horse. Their eyes are sewn shut and their body is wrapped in a burial shroud of dust and ash.",
  "features": [
    {
      "name": "Relentless (3)",
      "kind": "Passive",
      "rulesText": "The Harbinger can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
    },
    {
      "name": "Mount",
      "kind": "Passive",
      "rulesText": "While the Harbinger is on their mount, they gain a +2 bonus to their Difficulty. When the Harbinger takes Severe damage, they’re knocked from their mount. If the Harbinger is unhorsed, their mount disappears until you mark a Stress to summon it again."
    },
    {
      "name": "Fear the Reaper",
      "kind": "Passive",
      "rulesText": "When a creature is defeated within Far range of the Harbinger, you gain a Fear."
    },
    {
      "name": "Decapitate",
      "kind": "Action",
      "rulesText": "Spend 2 Fear to have the Harbinger make an attack roll against a PC within Melee range. On a success, roll a d6. On a result of 6, the target marks all HP and must make a death move."
    },
    {
      "name": "Wake the Fallen",
      "kind": "Action",
      "rulesText": "Spend a Fear and mark any number of Stress to have the Harbinger resurrect a defeated ally within Far range. The resurrected ally clears a number of HP equal to the number of Stress marked. Immediately spotlight the ally."
    },
    {
      "name": "Ashes to Ashes, Dust to Dust",
      "kind": "Reaction",
      "rulesText": "When the Harbinger would mark HP, you can mark a Stress to have an ally within Far range mark the HP instead."
    }
  ],
  "role": "Skulk",
  "htmlPage": {
    "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/harbinger-of-death/"
  },
