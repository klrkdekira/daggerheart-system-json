    {
      "name": "Minion (6)",
      "kind": "Passive",
      "rulesText": "The Sapling is defeated when they take any damage. For every 6 damage a PC deals to the Sapling, defeat an additional Minion within range the attack would succeed against."
    },
    {
      "name": "Group Attack",
      "kind": "Action",
      "rulesText": "Spend a Fear to choose a target and spotlight all Treant Saplings within Close range of them. Those Minions move into Melee range of the target and make one shared attack roll. On a success, they deal 8 physical damage each. Combine this damage."
    }
