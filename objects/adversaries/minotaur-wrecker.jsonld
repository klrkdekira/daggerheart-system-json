  "experience": "Navigation +2",
  "description": "A massive bull-headed firbolg with a quick temper.",
  "features": [
    {
      "name": "Ramp Up",
      "kind": "Passive",
      "rulesText": "You must spend a Fear to spotlight the Minotaur. While spotlighted, they can make their standard attack against all targets within range."
    },
    {
      "name": "Charging Bull",
      "kind": "Action",
      "rulesText": "Mark a Stress to charge through a group within Close range and make an attack against all targets in the Minotaur’s path. Targets the Minotaur succeeds against take 2d6+8 physical damage and are knocked back to Very Far range. If a target is knocked into a solid object or another creature, they take an extra 1d6 damage (combine the damage)."
    },
    {
      "name": "Gore",
      "kind": "Action",
      "rulesText": "Make an attack against a target within Very Close range, moving the Minotaur into Melee range of them. On a success, deal 2d8 direct physical damage."
    }
  ],
  "role": "Bruiser",
