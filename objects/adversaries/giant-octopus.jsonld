  "experience": "Intelligent +3",
  "description": "A monstrous, aquatic mollusk that has eight sucker-bearing arms and a hard, beaklike jaw.",
  "features": [
    {
      "name": "Relentless (3)",
      "kind": "Passive",
      "rulesText": "The Octopus can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight it."
    },
    {
      "name": "Armed and Dangerous",
      "kind": "Passive",
      "rulesText": "When the Octopus first appears, place a d8 on this stat block with the 8 value facing up. When the Octopus makes a successful standard attack against a PC, you can add the die’s value to the damage dealt. After you add its value to a roll, decrease the die’s value by 1."
    },
    {
      "name": "Grapple",
      "kind": "Action",
      "rulesText": "When the Octopus succeeds on a standard attack, you can spend a Fear to have the Octopus Grapple the target. While Grappled, the target is Restrained and Vulnerable until they break free with a successful Strength or Finesse Roll."
    },
    {
      "name": "Crush",
      "kind": "Action",
      "rulesText": "Mark a Stress to deal 3d8 direct physical damage to a target Grappled by the Octopus."
    }
  ],
  "role": "Solo",
