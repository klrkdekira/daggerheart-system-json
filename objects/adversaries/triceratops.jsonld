  "features": [
    {
      "name": "Leathery Hide",
      "kind": "Passive",
      "rulesText": "When the Triceratops would be forced to mark HP, you can mark any number of Stress instead of an equal number of HP."
    },
    {
      "name": "Tail Swipe",
      "kind": "Action",
      "rulesText": "Mark a Stress to choose up to three targets within Very Close range. Each target must make an Agility Reaction Roll. Targets who fail take 5d6 physical damage. Targets who succeed take half damage."
    },
    {
      "name": "Bull Rush",
      "kind": "Action",
      "rulesText": "Mark a Stress to choose a target within Close range. The Triceratops moves into Melee range with the target and makes an attack. On a success, deal 3d10 direct physical damage."
    }
  ],
