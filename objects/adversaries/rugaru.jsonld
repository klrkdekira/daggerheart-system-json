  "experience": "Swamps +3",
  "description": "A wolf-headed humanoid cursed by the gods to prowl the swamps in search of blood.",
  "features": [
    {
      "name": "Relentless (3)",
      "kind": "Passive",
      "rulesText": "The Rugaru can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight them."
    },
    {
      "name": "Child of Night",
      "kind": "Passive",
      "rulesText": "While in moonlight, the Rugaru gains a +2 bonus to their Difficulty."
    },
    {
      "name": "Bloodthirsty",
      "kind": "Passive",
      "rulesText": "When a PC marks HP from the Rugaru’s standard attack, add a token to this stat block. The Rugaru gains a bonus to attack rolls equal to the number of tokens on this stat block. Clear all tokens when the Rugaru takes Severe damage."
    },
    {
      "name": "Howl at the Moon",
      "kind": "Action",
      "rulesText": "Mark a Stress to force each PC within Far range to make a Presence Reaction Roll (15). Targets who fail lose a Hope. Gain a Fear for each Hope lost. If a PC has no Hope, they must mark a Stress and become Vulnerable until they roll with Hope."
    },
    {
      "name": "Flesh Ripper",
      "kind": "Action",
      "rulesText": "Mark a Stress to make an attack against a target within Melee range. On a success, deal 1d12+2 direct physical damage."
    }
  ],
  "role": "Solo",
