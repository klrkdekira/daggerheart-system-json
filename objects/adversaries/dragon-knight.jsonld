  "features": [
    {
      "name": "High Ground",
      "kind": "Passive",
      "rulesText": "The Knight gains advantage on attacks made against targets below them."
    },
    {
      "name": "Leaping Strike",
      "kind": "Action",
      "rulesText": "Mark a Stress to have the Knight leap into Melee range of a target within Far range and make a standard attack against them. On a success, the attack deals an extra 1d12 damage, and the target must mark an Armor Slot without receiving its benefits (they can still use armor to reduce the damage)."
    },
    {
      "name": "Comeback",
      "kind": "Reaction",
      "rulesText": "When the Knight fails a standard attack, you can spend a Fear to reroll the attack with advantage."
    }
  ],
