  "experience": "Aristocrat +3",
  "description": "A captivating undead dressed in aristocratic finery.",
  "features": [
    {
      "name": "Terrifying",
      "kind": "Passive",
      "rulesText": "When the Vampire makes a successful attack, all PCs within Far range lose a Hope and you gain a Fear."
    },
    {
      "name": "Look into My Eyes",
      "kind": "Passive",
      "rulesText": "A creature who moves into Melee range of the Vampire must make an Instinct Reaction Roll. On a failure, you gain 1d4 Fear."
    },
    {
      "name": "Feed on Followers",
      "kind": "Action",
      "rulesText": "When the Vampire is within Melee range of an ally, they can cause the ally to mark a HP. The Vampire then clears a HP."
    },
    {
      "name": "The Hunt Is On",
      "kind": "Action",
      "rulesText": "Spend 2 Fear to summon 1d4 Vampires, who appear at Far range and immediately take the spotlight."
    },
    {
      "name": "Lifesuck",
      "kind": "Reaction",
      "rulesText": "When the Vampire is spotlighted, roll a d8. On a result of 6 or higher, all targets within Very Close range must mark a HP."
    }
  ],
  "role": "Leader",
