  "standardAttack": {
    "name": "Bite",
    "range": "Close",
    "damage": "2d12+2 phy"
  },
  "description": "A quadrupedal scaled beast with multiple long-necked heads, each filled with menacing fangs.",
  "features": [
    {
      "name": "Many-Headed Menace",
      "kind": "Passive",
      "rulesText": "The Hydra begins with three heads and can have up to five. When the Hydra takes Major or greater damage, they lose a head."
    },
    {
      "name": "Relentless (X)",
      "kind": "Passive",
      "rulesText": "The Hydra can be spotlighted X times per GM turn, where X is the Hydra’s number of heads. Spend Fear as usual to spotlight them."
    },
    {
      "name": "Regeneration",
      "kind": "Action",
      "rulesText": "If the Hydra has any marked HP, spend a Fear to clear a HP and grow two heads."
    },
    {
      "name": "Terrifying Chorus",
      "kind": "Action",
      "rulesText": "All PCs within Far range lose 2 Hope."
    },
    {
      "name": "Magical Weakness",
      "kind": "Reaction",
      "rulesText": "When the Hydra takes magic damage, they become Dazed until the next roll with Fear. While Dazed, they can’t use their Regeneration action but are immune to magic damage."
    }
  ],
  "role": "Solo",
