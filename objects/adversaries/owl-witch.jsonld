  "experience": "Magic +2, Night Stalker +2",
  "description": "A giant, vengeful barn owl that has a 15-foot wingspan and a human face.",
  "features": [
    {
      "name": "Ill Omen",
      "kind": "Passive",
      "rulesText": "When a PC within Close range makes an action roll, their Fear Die gains a bonus equal to the amount of Fear you have."
    },
    {
      "name": "Witch Barrier",
      "kind": "Passive",
      "rulesText": "The Owl Witch has resistance to magic damage."
    },
    {
      "name": "Voice Mimicry",
      "kind": "Action",
      "rulesText": "Spend a Fear to have the Owl Witch beckon with the voice of a beloved figure to a creature within earshot. The target must succeed on an Instinct Reaction Roll or move up to Far range toward the Owl Witch."
    },
    {
      "name": "Nightmare Stare",
      "kind": "Action",
      "rulesText": "Spend a Fear to have the Owl Witch Aﬄict a PC within Far range with waking nightmares unless the target succeeds on a Knowledge Reaction Roll. While Aﬄicted, the target can’t clear HP or Stress. The condition is cleared when another PC uses a downtime move to comfort the Aﬄicted creature."
    },
    {
      "name": "Visions of a Violent End",
      "kind": "Reaction",
      "rulesText": "When the Owl Witch is targeted by an attack, you can spend a Fear to force the attacker to make a Presence Reaction Roll. On a failure, they must mark 1d4 Stress as their mind is flooded with harrowing imagery."
    }
  ],
