  "experience": "Ancient Knowledge +3, High Society +2, Tactics +2",
  "description": "A decorated soldier with heavy armor and a powerful steed.",
  "features": [
    {
      "name": "Chevalier",
      "kind": "Passive",
      "rulesText": "While the Knight is on a mount, they gain a +2 bonus to their Difficulty. When they take Severe damage, they’re knocked from their mount and lose this benefit until they’re next spotlighted."
    },
    {
      "name": "Heavily Armored",
      "kind": "Passive",
      "rulesText": "When the Knight takes physical damage, reduce it by 3."
    },
    {
      "name": "Cavalry Charge",
      "kind": "Action",
      "rulesText": "If the Knight is mounted, move up to Far range and make a standard attack against a target. On a success, deal 2d8+4 physical damage and the target must mark a Stress."
    },
    {
      "name": "For the Realm!",
      "kind": "Action",
      "rulesText": "Mark a Stress to spotlight 1d4+1 allies. Attacks they make while spotlighted in this way deal half damage."
    }
  ],
  "role": "Leader",
