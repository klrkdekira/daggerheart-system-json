  "experience": "Stealth +2, Vengeance +2",
  "description": "A tiny winged warrior that attacks trespassers with poison-tipped arrows.",
  "features": [
    {
      "name": "Minion (5)",
      "kind": "Passive",
      "rulesText": "The Sprite is defeated when they take any damage. For every 5 damage a PC deals to the Sprite, the PC defeats an additional Minion within range the attack would succeed against."
    },
    {
      "name": "Art of Invisibility",
      "kind": "Action",
      "rulesText": "Spend a Fear to make the Sprite Hidden until they attack."
    },
    {
      "name": "Dream Petal Poison",
      "kind": "Action",
      "rulesText": "When the Sprite succeeds on a standard attack, you can spend a Fear to make the target Sleepy until the target takes damage. While Sleepy, the target must make a Presence Reaction Roll before they make an action roll. On a failure, they must mark 2 Stress or fall asleep until they take damage."
    }
  ],
  "role": "Minion",
