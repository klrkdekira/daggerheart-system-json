  "experience": "Tactics +4",
  "description": "A smoldering, battle-obsessed goliath wearing bespoke armor and wielding a massive maul.",
  "features": [
    {
      "name": "Relentless (2)",
      "kind": "Passive",
      "rulesText": "The Warlord can be spotlighted up to two times per GM turn. Spend Fear as usual to spotlight them."
    },
    {
      "name": "Colossus Crafter",
      "kind": "Passive",
      "rulesText": "Countdown (6). When the Warlord enters the scene, activate the countdown. It ticks down when the Warlord is spotlighted. When it triggers, summon the Gargantuan War Machine, which appears at the edge of the battlefield and immediately takes the spotlight."
    },
    {
      "name": "Release the Hounds",
      "kind": "Action",
      "rulesText": "Spend a Fear to have the Warlord summon two Demonic Hound Packs, which appear at Close range and immediately take the spotlight."
    },
    {
      "name": "Spinning Strike",
      "kind": "Action",
      "rulesText": "Mark a Stress to make a standard attack against all targets within Very Close range and gain a Fear."
    },
    {
      "name": "Ground-Breaking",
      "kind": "Action",
      "rulesText": "Spend a Fear to have the Warlord crack the earth with a downward swing of their maul and make an attack against a group within Close range. Targets the attack succeeds against take 4d10+10 direct damage. The area becomes rough terrain, and a PC must succeed on an Agility Reaction Roll (16) to move through it."
    }
  ],
