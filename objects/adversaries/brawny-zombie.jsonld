  "features": [
    {
      "name": "Slow",
      "kind": "Passive",
      "rulesText": "When you spotlight the Zombie and they don’t have a token on their stat block, they can’t act yet. Place a token on their stat block and describe what they’re preparing to do. When you spotlight the Zombie and they have a token on their stat block, clear the token and they can act."
    },
    {
      "name": "Rend Asunder",
      "kind": "Action",
      "rulesText": "Make a standard attack with advantage against a target the Zombie has Restrained. On a success, the attack deals direct damage."
    },
    {
      "name": "Rip and Tear",
      "kind": "Reaction",
      "rulesText": "When the Zombies makes a successful standard attack, you can mark a Stress to temporarily Restrain the target and force them to mark 2 Stress."
    }
  ],
  "role": "Bruiser",
