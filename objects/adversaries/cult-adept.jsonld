  "experience": "Fallen Lore +2, Rituals +2",
  "description": "An experienced mage wielding shadow and fear.",
  "features": [
    {
      "name": "Enervating Blast",
      "kind": "Action",
      "rulesText": "Spend a Fear to make a standard attack against a target within range. On a success, the target must mark a Stress."
    },
    {
      "name": "Shroud of the Fallen",
      "kind": "Action",
      "rulesText": "Mark a Stress to wrap an ally within Close range in a shroud of Protection until the Adept marks their last HP. While Protected, the target has resistance to all damage."
    },
    {
      "name": "Shadow Shackles",
      "kind": "Action",
      "rulesText": "Spend a Fear and choose a point within Far range. All targets within Close range of that point are Restrained in smoky chains until they break free with a successful Strength or Instinct Roll. A target Restrained by this feature must spend a Hope to make an action roll."
    },
    {
      "name": "Fear Is Fuel",
      "kind": "Reaction",
      "rulesText": "Twice per scene, when a PC rolls a failure with Fear, clear a Stress."
    }
  ],
  "role": "Support",
