  },
  "experience": "Darkness +3",
  "description": "A spider the size of a human head, woven out of shadow-silk.",
  "features": [
    {
      "name": "Minion (3)",
      "kind": "Passive",
      "rulesText": "The Crawler is defeated when it takes any damage. For every 3 damage a PC deals to the Crawler, the PC defeats an additional Minion within range the attack would succeed against."
    },
    {
      "name": "Skin-Crawling",
      "kind": "Action",
      "rulesText": "Spend a Fear to force all PCs within Melee range of the Crawler to mark a Stress."
    },
    {
      "name": "Group Attack",
      "kind": "Action",
      "rulesText": "Spend a Fear to choose a target and spotlight all Darkweave Crawlers within Close range of them. Those Minions move into Melee range of the target and make one shared attack roll. On a success, they deal 2 physical damage each. Combine this damage."
    },
    {
      "name": "Darkweave Venom",
      "kind": "Reaction",
      "rulesText": "When the Crawler makes a successful attack, you can mark a Stress to Exhaust the target until they succeed on a Strength Roll (9). While Exhausted, the target must mark a Stress each time they make an action roll."
    }
  ],
  "role": "Minion",
