  "description": "A towering, muscular zombie with magically infused strength and skill.",
  "features": [
    {
      "name": "Terrifying",
      "kind": "Passive",
      "rulesText": "When the Zombie makes a successful attack, all PCs within Far range lose a Hope and you gain a Fear."
    },
    {
      "name": "Fearsome Presence",
      "kind": "Passive",
      "rulesText": "PCs can’t spend Hope to use features against the Zombie."
    },
    {
      "name": "Perfect Strike",
      "kind": "Action",
      "rulesText": "Mark a Stress to make a standard attack against all targets within Very Close range. Targets the Zombie succeeds against are Vulnerable until their next rest."
    },
    {
      "name": "Skilled Opportunist",
      "kind": "Reaction",
      "rulesText": "When another adversary deals damage to a target within Very Close range of the Zombie, you can spend a Fear to add the Zombie’s standard attack damage to the damage roll."
    }
  ],
  "role": "Bruiser",
