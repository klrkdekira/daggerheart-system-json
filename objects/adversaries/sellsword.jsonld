    {
      "name": "Minion (4)",
      "kind": "Passive",
      "rulesText": "The Sellsword is defeated when they take any damage. For every 4 damage a PC deals to the Sellsword, defeat an additional Minion within range the attack would succeed against."
    },
    {
      "name": "Group Attack",
      "kind": "Action",
      "rulesText": "Spend a Fear to choose a target and spotlight all Sellswords within Close range of them. Those Minions move into Melee range of the target and make one shared attack roll. On a success, they deal 3 physical damage each. Combine this damage."
    }
