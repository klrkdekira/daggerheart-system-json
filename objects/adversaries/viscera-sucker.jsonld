  "experience": "Flying +3",
  "description": "A vampiric demon whose upper body detaches at sundown to fly through nearby villages in search of victims. It has a winged upper body with hanging entrails.",
  "features": [
    {
      "name": "Join or Die",
      "kind": "Passive",
      "rulesText": "The Viscera Sucker dies if it hasn’t reconnected its upper and lower halves by dawn."
    },
    {
      "name": "Entangling Entrails",
      "kind": "Action",
      "rulesText": "Spend a Fear to have the Viscera Sucker latch onto a target within Very Close range, Restraining them until they escape with a successful Strength Roll (16)."
    },
    {
      "name": "Lifesuck",
      "kind": "Action",
      "rulesText": "Mark a Stress to have the Viscera Sucker drink blood from a Restrained target within Melee range. The target marks a HP, and the Viscera Sucker clears a HP."
    }
  ],
