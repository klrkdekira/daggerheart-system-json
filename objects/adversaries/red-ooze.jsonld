  "experience": "Camouflage +3",
  "description": "A moving mound of translucent flaming red slime.",
  "features": [
    {
      "name": "Creeping Fire",
      "kind": "Passive",
      "rulesText": "The Ooze can only move within Very Close range as their normal movement. They light any flammable object they touch on fire."
    },
    {
      "name": "Ignite",
      "kind": "Action",
      "rulesText": "Make an attack against a target within Very Close range. On a success, the target takes 1d8 magic damage and is Ignited until they’re extinguished with a successful Finesse Roll (14). While Ignited, the target takes 1d4 magic damage when they make an action roll."
    },
    {
      "name": "Split",
      "kind": "Reaction",
      "rulesText": "When the Ooze has 3 or more HP marked, you can spend a Fear to split them into two Tiny Red Oozes (with no marked HP or Stress). Immediately spotlight both of them."
    }
  ],
  "role": "Skulk",
