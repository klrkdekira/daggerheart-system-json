      "name": "Horde (2d6)",
      "kind": "Passive",
      "rulesText": "When the Swarm has marked half or more of its HP, its standard attack deals 2d6 physical damage instead."
    },
    {
      "name": "Blinding Multitude",
      "kind": "Passive",
      "rulesText": "The Swarm is so thick it blocks the vision of anyone it interacts with. Creatures within Melee range have disadvantage on attacks made against adversaries other than the Swarm."
    },
    {
      "name": "Bloodsuckers",
      "kind": "Reaction",
      "rulesText": "When the Swarm deals damage to a target, you can mark a Stress to have the Swarm feed. The target marks an additional HP, and the Swarm clears a HP."
    }
