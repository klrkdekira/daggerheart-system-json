  },
  "tier": 4,
  "motivesAndTactics": [
    "Constrict the world",
    "control the battlefield",
    "draw enemies into the water"
  ],
  "difficulty": 20,
  "thresholds": "40/70",
  "hitPoints": 12,
  "stress": 8,
  "attackModifier": "+8",
  "standardAttack": {
    "name": "Bite",
    "range": "Very Close",
    "damage": "4d10+5 phy"
  },
  "experience": "Rivers +4",
  "description": "A colossal fur-covered snake that hunts in large bodies of water.",
  "features": [
    {
      "name": "Segmented",
      "kind": "Passive",
      "rulesText": "The Water Mother’s body is divided into three segments: Head, Center, and Tail. The Water Mother always moves from the Head first, pulling the Center and then Tail behind it. A creature can target the Water Mother with an attack as long as at least one of her segments is within range, but the Water Mother can make a standard attack only against a target within range of her Head. If an attack deals damage to the Water Mother and her Head is within range, the attack deals an extra 1d10 damage."
    },
    {
      "name": "Eat the World",
      "kind": "Action",
      "rulesText": "Spend a Fear to have the Water Mother inhale sharply. Each PC within Close range of her Head must succeed on a Strength Reaction Roll or mark a Stress and be pulled within Melee range of the Head. The Water Mother then makes a standard attack against all targets within Melee range of her Head."
    },
    {
      "name": "Constrict",
      "kind": "Action",
      "rulesText": "Mark a Stress to make an attack against all targets within Melee range of the Center segment. Targets the attack succeeds against take 4d8+8 physical damage and are temporarily Restrained. At the beginning of each GM turn, you can mark a Stress to force all targets Restrained by the Water Mother to mark a HP."
    },
    {
      "name": "Venom Surge",
      "kind": "Reaction",
      "rulesText": "When the Water Mother makes a successful standard attack, you can spend a Fear to make the target Vulnerable until the end of the scene."
    }
  ],
  "role": "Solo",
  "htmlPage": {
    "@id": "https://cheeleong.dev/daggerheart-system-json/records/adversaries/water-mother/"
  },
  "source": {
    "@id": "https://cheeleong.dev/daggerheart-system-json/objects/sources/daggerheart-srd-2-0"
  }
}
