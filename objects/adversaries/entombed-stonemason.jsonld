  "experience": "Builder +2",
  "description": "An unfortunate undead laborer chosen by lottery to wall up their empress’s tomb from the inside.",
  "features": [
    {
      "name": "Minion (5)",
      "kind": "Passive",
      "rulesText": "The Stonemason is defeated when they take any damage. For every 5 damage a PC deals to the Stonemason, the PC defeats an additional Minion within range their attack would succeed against."
    },
    {
      "name": "Group Attack",
      "kind": "Action",
      "rulesText": "Spend a Fear to choose a target and spotlight all Entombed Stonemasons within Close range of them. Those Minions move into Melee range of the target and make one shared attack roll. On a success, they deal 5 physical damage each. Combine this damage."
    },
    {
      "name": "The Work Never Ends",
      "kind": "Reaction",
      "rulesText": "When the Stonemason is defeated by an attack that deals physical damage, you can spend a Fear to clear the Stonemason’s HP and Stress."
    }
  ],
  "role": "Minion",
