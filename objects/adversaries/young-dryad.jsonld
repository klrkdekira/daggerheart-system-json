  "features": [
    {
      "name": "Voice of the Forest",
      "kind": "Action",
      "rulesText": "Mark a Stress to spotlight 1d4 allies within range of a target they can attack without moving. On a success, their attacks deal half damage."
    },
    {
      "name": "Thorny Cage",
      "kind": "Action",
      "rulesText": "Spend a Fear to form a cage around a target within Very Close range and Restrain them until they’re freed with a successful Strength Roll. When a creature makes an action roll against the cage, they must mark a Stress."
    },
    {
      "name": "Momentum",
      "kind": "Reaction",
      "rulesText": "When the Dryad makes a successful attack against a PC, you gain a Fear."
    }
