  "features": [
    {
      "name": "Goading Strike",
      "kind": "Action",
      "rulesText": "Make a standard attack against a target. On a success, mark a Stress to Taunt the target until their next successful attack. The next time the Taunted target attacks, they have disadvantage against targets other than the Weaponmaster."
    },
    {
      "name": "Adrenaline Burst",
      "kind": "Action",
      "rulesText": "Once per scene, spend a Fear to clear 2 HP and 2 Stress."
    },
    {
      "name": "Momentum",
      "kind": "Reaction",
      "rulesText": "When the Weaponmaster makes a successful attack against a PC, you gain a Fear."
    }
  ],
