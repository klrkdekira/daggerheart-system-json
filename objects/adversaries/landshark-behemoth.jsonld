  "experience": "Subterranean +4, Bloodthirsty +3",
  "description": "A landshark that’s lived long enough to become a large burrowing monstrosity with steely hide and razor-sharp teeth.",
  "features": [
    {
      "name": "Relentless (3)",
      "kind": "Passive",
      "rulesText": "The Behemoth can be spotlighted up to three times per GM turn. Spend Fear as usual to spotlight it."
    },
    {
      "name": "Deep Diver",
      "kind": "Passive",
      "rulesText": "The Behemoth can move through the ground as easily as over it. When the Behemoth moves, it can choose to burrow or surface. While underground, the Behemoth is immune to damage but can’t attack."
    },
    {
      "name": "Steel-Skinned",
      "kind": "Passive",
      "rulesText": "All damage dealt to the Behemoth is reduced by one threshold."
    },
    {
      "name": "Forceful Eruption",
      "kind": "Action",
      "rulesText": "The Behemoth erupts from the ground, forcing each PC within Very Close range to succeed on an Agility Reaction Roll or be knocked over, becoming Vulnerable until they make an action roll. For each PC made Vulnerable in this way, you gain a Fear."
    }
  ],
  "role": "Solo",
