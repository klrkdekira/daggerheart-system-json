  "description": "A clandestine leader with a direct channel to the Fallen Gods.",
  "features": [
    {
      "name": "Seize Your Moment",
      "kind": "Action",
      "rulesText": "Spend 2 Fear to spotlight 1d4 allies. Attacks they make while spotlighted in this way deal half damage."
    },
    {
      "name": "Our Master’s Will",
      "kind": "Reaction",
      "rulesText": "When you spotlight an ally within Far range, mark a Stress to gain a Fear."
    },
    {
      "name": "Summoning Ritual",
      "kind": "Reaction",
      "rulesText": "Countdown (6). When the Secret-Keeper is in the spotlight for the first time, activate the countdown. When they mark HP, tick down this countdown by the number of HP marked. When it triggers, summon a Minor Demon who appears at Close range."
    },
    {
      "name": "Fallen Hounds",
      "kind": "Reaction",
      "rulesText": "Once per scene, when the Secret- Keeper marks 2 or more HP, you can mark a Stress to summon a Demonic Hound Pack, which appears at Close range and is immediately spotlighted."
    }
  ],
