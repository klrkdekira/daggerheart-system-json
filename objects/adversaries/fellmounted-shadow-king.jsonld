  "tier": 3,
  "motivesAndTactics": [
    "Find magic items",
    "inspire fear",
    "patrol skies"
  ],
  "difficulty": 15,
  "thresholds": "24/38",
  "hitPoints": 8,
  "stress": 5,
  "attackModifier": "+4",
  "standardAttack": {
    "name": "Cursed Lance",
    "range": "Close",
    "damage": "3d10+6 mag"
  },
  "experience": "Seeker +3",
  "description": "The shade of a forgotten ruler, cursed to patrol the skies atop a winged eel in the service of an even greater evil.",
  "features": [
    {
      "name": "Fellmount",
      "kind": "Passive",
      "rulesText": "While the Shadow King is on his mount, he gains a +2 bonus to his Difficulty. When the Shadow King takes Severe damage, he’s knocked from his mount. If the Shadow King is unmounted, his mount disappears until you mark a Stress to summon it again."
    },
    {
      "name": "Light and Shadow",
      "kind": "Passive",
      "rulesText": "The Shadow King has advantage on attack rolls while in shadow or darkness and disadvantage on attack rolls while in bright light."
    },
    {
      "name": "Relic Hunter",
      "kind": "Passive",
      "rulesText": "The Shadow King has advantage on attack rolls against PCs who have magic weapons or armor equipped."
    },
    {
      "name": "Hellsong",
      "kind": "Action",
      "rulesText": "Spend 2 Fear to have the Shadow King’s mount unleash a spine-chilling screech that echoes over the battlefield. Each PC within Far range must make a Presence Reaction Roll (18). Targets who succeed must mark a Stress. Targets who fail must mark a Stress and lose a Hope. If a PC can’t lose a Hope, you gain 2 Fear."
    },
    {
      "name": "Air Support",
      "kind": "Reaction",
      "rulesText": "Three times per scene, you can spend a Fear to have an ally within Far range reroll a failed attack with advantage."
    }
  ],
  "role": "Support",
