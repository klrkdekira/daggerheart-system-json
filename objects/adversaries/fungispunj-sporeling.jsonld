  "experience": "Darkness +3",
  "description": "A halfling-sized mushroom creature that defends itself from attackers with tiny puffs of neurotoxic spores.",
  "features": [
    {
      "name": "Minion (6)",
      "kind": "Passive",
      "rulesText": "The Sporeling is defeated when it takes any damage. For every 6 damage a PC deals to the Sporeling, the PC defeats an additional Minion within range the attack would succeed against."
    },
    {
      "name": "Group Attack",
      "kind": "Action",
      "rulesText": "Spend a Fear to choose a target and spotlight all Fungispunj Sporelings within Close range of them. Those Minions move into Melee range of the target and make one shared attack roll. On a success, they deal 4 magic damage each. Combine this damage."
    },
    {
      "name": "Form Up",
      "kind": "Action",
      "rulesText": "Spend a Fear to combine three Sporelings within a Close area and replace them with a Fungispunj Sporophore."
    }
  ],
  "role": "Minion",
