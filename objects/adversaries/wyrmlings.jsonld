  "description": "A clutch of newly hatched dragons. As newborns, they’re furious, hungry, and stupid.",
  "features": [
    {
      "name": "Horde (2d6+5)",
      "kind": "Passive",
      "rulesText": "When the Wyrmlings have marked half or more of their HP, their standard attack deals 2d6+5 physical damage instead."
    },
    {
      "name": "Ravenous",
      "kind": "Reaction",
      "rulesText": "Once per GM turn when a PC marks a HP from an attack made by the Wyrmlings, you can spend a Fear to spotlight the Wyrmlings again."
    },
    {
      "name": "Overwhelm",
      "kind": "Reaction",
      "rulesText": "When the Wyrmlings take Minor damage from an attack within Melee range, you can mark a Stress to make a standard attack with advantage against the attacker."
    }
  ],
