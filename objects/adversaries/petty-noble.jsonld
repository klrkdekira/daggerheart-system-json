    {
      "name": "My Land, My Rules",
      "kind": "Passive",
      "rulesText": "All social actions made against the Noble on their land have disadvantage."
    },
    {
      "name": "Guards, Seize Them!",
      "kind": "Action",
      "rulesText": "Once per scene, mark a Stress to summon 1d4 Bladed Guards, who appear at Far range to enforce the Noble’s will."
    },
    {
      "name": "Exile",
      "kind": "Action",
      "rulesText": "Spend a Fear and target a PC. The Noble proclaims that the target and their allies are exiled from the noble’s territory. While exiled, the target and their allies have disadvantage during social situations within the Noble’s domain."
    }
